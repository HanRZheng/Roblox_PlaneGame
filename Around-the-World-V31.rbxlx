<Item class="ModuleScript" referent="RBX11">
  <Properties><string name="Name">AircraftEffectsController</string><ProtectedString name="Source"><![CDATA[--!nocheck

-- V29 attachment-driven client effects. The controller reads the aircraft's
-- existing replicated electrical, engine, configuration, weather, and landing
-- state; it never creates a competing flight or controls system.

local AircraftEffectsConfig = require(script.Parent:WaitForChild("AircraftEffectsConfig"))

local AircraftEffectsController = {}
local cacheByModel = setmetatable({}, { __mode = "k" })
local cachedWorld = nil
local cachedQuality = 7
local lastQualityRead = -math.huge

local function getQualityLevel()
	if os.clock() - lastQualityRead < 2 then return cachedQuality end
	lastQualityRead = os.clock()
	pcall(function()
		local settings = UserSettings():GetService("UserGameSettings")
		local saved = settings.SavedQualityLevel
		if saved == Enum.SavedQualitySetting.Automatic then
			cachedQuality = 7
		else
			cachedQuality = tonumber(string.match(saved.Name, "%d+")) or saved.Value or 7
		end
	end)
	return math.clamp(cachedQuality, 1, 10)
end

local function getWorld()
	if cachedWorld and cachedWorld.Parent then return cachedWorld end
	cachedWorld = workspace:FindFirstChild("SkyDeckWorld")
	return cachedWorld
end

local function flashWindow(clock, pattern)
	local phase = clock % pattern.Period
	for _, window in ipairs(pattern.Windows) do
		if phase >= window[1] and phase <= window[2] then return true end
	end
	return false
end

local function effectAllowed(config, effectName, distance, quality)
	local maximumDistance = config.Distances[effectName] or 0
	local minimumQuality = config.MinimumQuality[effectName] or 1
	return distance <= maximumDistance and quality >= minimumQuality
end

local function applyConfiguredAttachmentOffset(attachment, config)
	local role = attachment:GetAttribute("AircraftLightRole")
	if not role then return end
	local basePosition = attachment:GetAttribute("BaseAttachmentPosition")
	if typeof(basePosition) ~= "Vector3" then
		basePosition = attachment.Position
		attachment:SetAttribute("BaseAttachmentPosition", basePosition)
	end
	attachment.Position = basePosition + (config.LightOffsets[role] or Vector3.zero)
end

local function buildCache(model)
	local config = AircraftEffectsConfig.Get(model:GetAttribute("AircraftCode"))
	local cache = {
		Config = config,
		Lights = {},
		Emitters = {},
		FanBlurParts = {},
		Connections = {},
		LastLandingPhase = model:GetAttribute("LandingPhase") or "NONE",
		LastSmokeClock = -math.huge,
		SmokeEmitterCount = 0,
	}

	for _, item in ipairs(model:GetDescendants()) do
		if item:IsA("Attachment") and item:GetAttribute("AircraftLightType") then
			applyConfiguredAttachmentOffset(item, config)
			local lights = {}
			for _, child in ipairs(item:GetChildren()) do
				if child:IsA("Light") then table.insert(lights, child) end
			end
			table.insert(cache.Lights, {
				Attachment = item,
				Part = item.Parent:IsA("BasePart") and item.Parent or item:FindFirstAncestorWhichIsA("BasePart"),
				Type = item:GetAttribute("AircraftLightType"),
				Role = item:GetAttribute("AircraftLightRole"),
				Lights = lights,
			})
		elseif item:IsA("ParticleEmitter") and item:GetAttribute("AircraftEffectType") then
			table.insert(cache.Emitters, item)
			if item:GetAttribute("AircraftEffectType") == "TIRE_SMOKE" then cache.SmokeEmitterCount += 1 end
		elseif item:IsA("BasePart") and item:GetAttribute("AircraftEffectType") == "FAN_BLUR" then
			table.insert(cache.FanBlurParts, item)
		end
	end

	table.insert(cache.Connections, model.Destroying:Connect(function()
		AircraftEffectsController.Clear(model)
	end))
	cacheByModel[model] = cache
	return cache
end

local function disableCache(cache)
	for _, rig in ipairs(cache.Lights) do
		for _, light in ipairs(rig.Lights) do light.Enabled = false end
	end
	for _, emitter in ipairs(cache.Emitters) do emitter.Enabled = false end
	for _, blur in ipairs(cache.FanBlurParts) do blur.Transparency = 1 end
end

function AircraftEffectsController.Apply(model, dt, cameraDistance)
	if not model then return end
	if not model.Parent then
		AircraftEffectsController.Clear(model)
		return
	end
	local cache = cacheByModel[model] or buildCache(model)
	local config = cache.Config
	local distance = cameraDistance or math.huge
	local quality = getQualityLevel()
	local clock = workspace.DistributedGameTime
	local electrical = model:GetAttribute("ExternalLights") ~= false
	local engine = model:GetAttribute("Engine") == true
	local onGround = model:GetAttribute("OnGround") == true
	local gear = (model:GetAttribute("GearProgress") or 0) > 0.76
	local altitude = model:GetAttribute("Altitude") or 0
	local speed = math.abs(model:GetAttribute("Speed") or 0)
	local flaps = model:GetAttribute("FlapPosition") or 0
	local enginePower = model:GetAttribute("EnginePower") or 0
	local touchdownLoad = model:GetAttribute("TouchdownLoad") or 0
	local world = getWorld()
	local humidity = world and world:GetAttribute("Humidity") or 0
	local rain = world and world:GetAttribute("RainIntensity") or 0
	local wetness = world and world:GetAttribute("WeatherWetness") or 0
	local lightsAllowed = electrical and effectAllowed(config, "Lights", distance, quality)

	for _, rig in ipairs(cache.Lights) do
		local enabled = false
		if rig.Type == "NAVIGATION" or rig.Type == "TAIL_NAVIGATION" then
			enabled = lightsAllowed
		elseif rig.Type == "BEACON" then
			enabled = lightsAllowed and engine and flashWindow(clock, config.FlashPatterns.Beacon)
		elseif rig.Type == "STROBE" then
			enabled = lightsAllowed and engine and flashWindow(clock, config.FlashPatterns.Strobe)
		elseif rig.Type == "LANDING" then
			enabled = lightsAllowed and engine and gear and (onGround or altitude < config.Thresholds.LandingLightAltitude)
		elseif rig.Type == "TAXI" then
			enabled = lightsAllowed and engine and onGround and speed < config.Thresholds.TaxiLightMaxSpeed
		elseif rig.Type == "TURNOFF" then
			enabled = lightsAllowed and engine and gear and (onGround or altitude < config.Thresholds.TurnoffLightAltitude)
		elseif rig.Type == "INSPECTION" or rig.Type == "LOGO" then
			enabled = lightsAllowed and engine
		end
		for _, light in ipairs(rig.Lights) do light.Enabled = enabled end
		if rig.Part then
			local steadyNavigation = rig.Type == "NAVIGATION" or rig.Type == "TAIL_NAVIGATION"
			rig.Part.Transparency = enabled and (steadyNavigation and 0.08 or 0) or 0.72
		end
	end

	local landingPhase = model:GetAttribute("LandingPhase") or "NONE"
	local touchdown = landingPhase == "MAIN_GEAR" and cache.LastLandingPhase ~= "MAIN_GEAR"
	local hardTouchdown = touchdown
		and touchdownLoad >= config.Thresholds.TireSmokeMinLoad
		and speed >= config.Thresholds.TireSmokeMinSpeed
		and clock - cache.LastSmokeClock >= config.Thresholds.TireSmokeCooldown
	local smokeBurst = 0
	if hardTouchdown then
		local normalizedLoad = math.clamp((touchdownLoad - config.Thresholds.TireSmokeMinLoad) / 0.30, 0, 1)
		local totalBurst = math.floor(5 + normalizedLoad * (config.Rates.TireSmokeMaximumBurst - 5))
		smokeBurst = math.max(1, math.floor(totalBurst / math.max(1, cache.SmokeEmitterCount)))
		cache.LastSmokeClock = clock
	end

	for _, emitter in ipairs(cache.Emitters) do
		local effectType = emitter:GetAttribute("AircraftEffectType")
		if effectType == "VORTEX" then
			local allowed = effectAllowed(config, "Vortex", distance, quality)
			emitter.Enabled = allowed and humidity >= config.Thresholds.VortexHumidity and not onGround
				and flaps >= config.Thresholds.VortexMinFlaps and speed >= config.Thresholds.VortexMinSpeed
				and altitude <= config.Thresholds.VortexMaxAltitude
			emitter.Rate = config.Rates.Vortex
		elseif effectType == "CONTRAIL" then
			local allowed = effectAllowed(config, "Contrail", distance, quality)
			emitter.Enabled = allowed and engine and enginePower >= config.Thresholds.ContrailMinPower
				and altitude >= config.Thresholds.ContrailMinAltitude and speed >= config.Thresholds.ContrailMinSpeed
			emitter.Rate = config.Rates.Contrail
		elseif effectType == "ENGINE_EXHAUST" or effectType == "HEAT_HAZE" then
			local allowed = effectAllowed(config, "Exhaust", distance, quality)
			emitter.Enabled = allowed and engine and enginePower >= config.Thresholds.ExhaustMinPower
			emitter.Rate = math.clamp(config.Rates.ExhaustBase + enginePower * config.Rates.ExhaustPowerScale, 0, 13)
		elseif effectType == "SPRAY" then
			local allowed = effectAllowed(config, "Spray", distance, quality)
			emitter.Enabled = allowed and onGround and wetness >= config.Thresholds.SprayMinWetness and speed >= config.Thresholds.SprayMinSpeed
			emitter.Rate = math.clamp((speed - config.Thresholds.SprayMinSpeed) * wetness * 0.52, 0, config.Rates.SprayMaximum)
		elseif effectType == "RAIN" then
			local allowed = effectAllowed(config, "Rain", distance, quality)
			emitter.Enabled = allowed and rain > 0.06
			emitter.Rate = math.floor(config.Rates.RainBase + rain * config.Rates.RainScale)
		elseif effectType == "TIRE_SMOKE" then
			emitter.Enabled = false
			if smokeBurst > 0 and effectAllowed(config, "TireSmoke", distance, quality) then emitter:Emit(smokeBurst) end
		end
	end

	local blurAllowed = effectAllowed(config, "FanBlur", distance, quality) and engine and enginePower > 18
	local blurTarget = blurAllowed and math.clamp(0.96 - enginePower * 0.0024, 0.72, 0.94) or 1
	local blurAlpha = 1 - math.exp(-math.max(0, dt or 0) * 8)
	for _, blur in ipairs(cache.FanBlurParts) do blur.Transparency += (blurTarget - blur.Transparency) * blurAlpha end

	cache.LastLandingPhase = landingPhase
end

function AircraftEffectsController.Clear(model)
	local cache = cacheByModel[model]
	if not cache then return end
	disableCache(cache)
	for _, connection in ipairs(cache.Connections) do connection:Disconnect() end
	table.clear(cache.Connections)
	cacheByModel[model] = nil
end

return AircraftEffectsController
]]></ProtectedString><bool name="Disabled">false</bool></Properties>
  
</Item>
<Item class="ModuleScript" referent="RBX12">
  <Properties><string name="Name">AircraftLODController</string><ProtectedString name="Source"><![CDATA[--!nocheck

-- Local distance LOD for fine procedural details. Major silhouette, controls,
-- landing gear, and collision proxies are never hidden.

local AircraftLODController = {}
local cacheByModel = setmetatable({}, { __mode = "k" })

local highOnlyNames = { "Fastener", "Wiper", "StaticPort", "StaticWick", "DrainMast", "ServicePanel", "GuideVane", "BrakeCaliper", "PanelRing", "Mullion", "Brow" }
local mediumOnlyNames = { "CabinWindow", "DoorFrame", "PackInlet", "PylonFillet", "NacelleChevron", "Tread", "Hub" }

local function containsAny(name, patterns)
	for _, pattern in ipairs(patterns) do
		if string.find(name, pattern, 1, true) then return true end
	end
	return false
end

local function buildCache(model)
	local cache = { High = {}, Medium = {} }
	for _, item in ipairs(model:GetDescendants()) do
		if item:IsA("BasePart") and item:GetAttribute("CollisionProxy") ~= true then
			local explicit = item:GetAttribute("LODDetail")
			if explicit == "HIGH" or containsAny(item.Name, highOnlyNames) then
				table.insert(cache.High, item)
			elseif explicit == "MEDIUM" or containsAny(item.Name, mediumOnlyNames) then
				table.insert(cache.Medium, item)
			end
		end
	end
	cacheByModel[model] = cache
	return cache
end

local function setHidden(parts, hidden)
	for _, part in ipairs(parts) do
		if part.Parent then part.LocalTransparencyModifier = hidden and 1 or 0 end
	end
end

function AircraftLODController.Apply(model, distance)
	if not model or not model.Parent then return end
	local cache = cacheByModel[model] or buildCache(model)
	local level = distance > 1750 and 2 or (distance > 760 and 1 or 0)
	setHidden(cache.High, level >= 1)
	setHidden(cache.Medium, level >= 2)
	model:SetAttribute("LocalLODLevel", level)
end

return AircraftLODController
]]></ProtectedString><bool name="Disabled">false</bool></Properties>
  
</Item>
<Item class="ModuleScript" referent="RBX13">
  <Properties><string name="Name">EngineAudioConfig</string><ProtectedString name="Source"><![CDATA[--!strict

-- V23 ships original WAV source files in the downloadable project. Roblox audio
-- must be uploaded by the experience owner, so these IDs intentionally remain
-- empty until the files are uploaded under that owner's account.
local sharedSounds = {
	IDLE = "",
	POWER = "",
	TAKEOFF = "",
	REVERSE = "",
	SHUTDOWN = "",
}

local profiles = {
	GEARED_NARROW = { FanBladeCount = 20, SoundIds = sharedSounds },
	NARROW_HIGH_BYPASS = { FanBladeCount = 24, SoundIds = sharedSounds },
	WIDE_TRENT = { FanBladeCount = 22, SoundIds = sharedSounds },
	WIDE_CHEVRON = { FanBladeCount = 18, SoundIds = sharedSounds },
	WIDE_CLASSIC = { FanBladeCount = 26, SoundIds = sharedSounds },
	WIDE_GE = { FanBladeCount = 16, SoundIds = sharedSounds },
	GEARED_REGIONAL = { FanBladeCount = 20, SoundIds = sharedSounds },
	REGIONAL_REAR = { FanBladeCount = 28, SoundIds = sharedSounds },
}

return {
	Profiles = profiles,
	GetProfile = function(profileName: string)
		return profiles[profileName] or profiles.NARROW_HIGH_BYPASS
	end,
}
]]></ProtectedString><bool name="Disabled">false</bool></Properties>
  
</Item>
<Item class="ModuleScript" referent="RBX14">
  <Properties><string name="Name">AirportCatalog</string><ProtectedString name="Source"><![CDATA[--!strict

local skylinePosition = Vector3.new(-30000, 0, -30000)
local skylineHeading = 58
local skylineCF = CFrame.new(skylinePosition) * CFrame.Angles(0, math.rad(-skylineHeading), 0)
local skylineRegionalPosition = skylineCF:PointToWorldSpace(Vector3.new(7400, 0, 5200))
local emberPosition = Vector3.new(23000, 0, -21000)
local emberHeading = 132
local emberCF = CFrame.new(emberPosition) * CFrame.Angles(0, math.rad(-emberHeading), 0)
-- The complete SPK runway/terminal reserve fits inside Ember's reshaped coast
-- here, with a 1,300+ stud landside gap from Ember International's reserve.
local sparkPosition = emberCF:PointToWorldSpace(Vector3.new(-5500, 0, 2500))
-- Green Grass sits southwest (negative X, positive Z) of Alpine Ridge with a
-- wide water channel between the two island coastlines.
local greenGrassPosition = Vector3.new(-38000, 0, 34000)

-- Aspect products remain close to one so these silhouettes retain nearly the
-- same land area as their V25 circular counterparts. Small radial lobes produce
-- varied coastlines without cutting into each airport's protected center.
local list = {
	{ Code = "SPT", Name = "Sunport International", Region = "Aurora Island", Position = Vector3.new(0, 0, 0), Heading = 0, RunwayLength = 4600, RunwayCount = 3, RunwayLayout = "CROSSING_SECONDARY", RunwayCrossAngle = 37, IslandRadius = 12000, IslandShape = "BroadLobed", IslandAspectX = 1.16, IslandAspectZ = 0.86, IslandRotation = 40, IslandLobeA = 0.10, IslandLobeB = 0.05, IslandPhase = 0.35, Gates = 13, TerminalStyle = "DUAL_PIER", Terrain = "Green", Accent = Color3.fromRGB(79, 215, 128) },
	{ Code = "NPT", Name = "Northpoint Regional", Region = "Mistral Island", Position = Vector3.new(-18000, 0, -12500), Heading = 42, RunwayLength = 3400, IslandRadius = 6500, IslandShape = "Teardrop", IslandAspectX = 0.80, IslandAspectZ = 1.25, IslandRotation = -20, IslandLobeA = 0.07, IslandLobeB = 0.035, IslandPhase = 1.15, Gates = 3, TerminalStyle = "ROTUNDA", Terrain = "Green", Accent = Color3.fromRGB(114, 200, 255) },
	{ Code = "CBY", Name = "Coral Bay Airport", Region = "Solara Keys", Position = Vector3.new(19000, 0, 12000), Heading = 90, RunwayLength = 4200, RunwayCount = 2, RunwayLayout = "CROSSING_SECONDARY", RunwayCrossAngle = -44, IslandRadius = 9000, IslandShape = "BayLobed", IslandAspectX = 1.10, IslandAspectZ = 0.91, IslandRotation = -80, IslandLobeA = 0.12, IslandLobeB = 0.05, IslandPhase = 2.10, Gates = 7, TerminalStyle = "CRESCENT", Terrain = "Tropical", Accent = Color3.fromRGB(68, 224, 208) },
	{ Code = "ALP", Name = "Alpine Ridge", Region = "Highland Reach", Position = Vector3.new(-19000, 0, 17000), Heading = 148, RunwayLength = 3300, IslandRadius = 7500, IslandShape = "Ridge", IslandAspectX = 0.76, IslandAspectZ = 1.32, IslandRotation = 11, IslandLobeA = 0.075, IslandLobeB = 0.035, IslandPhase = 0.80, Gates = 5, TerminalStyle = "RIDGE", Terrain = "Alpine", Accent = Color3.fromRGB(200, 227, 255) },
	{ Code = "GGA", Name = "Green Grass Airport", Region = "Greenhaven Island", Position = greenGrassPosition, Heading = 122, RunwayLength = 3900, RunwayCount = 2, RunwayLayout = "CROSSING_SECONDARY", RunwayCrossAngle = 52, IslandRadius = 8800, IslandShape = "MultiLobed", IslandAspectX = 0.94, IslandAspectZ = 1.06, IslandRotation = -18, IslandLobeA = 0.095, IslandLobeB = 0.045, IslandPhase = 1.32, Gates = 7, TerminalStyle = "T_PIER", Terrain = "Green", BuildingCount = 32, TreeCount = 72, Accent = Color3.fromRGB(92, 218, 113) },
	{ Code = "EMB", Name = "Ember International", Region = "Redstone Desert", Position = emberPosition, Heading = emberHeading, RunwayLength = 4700, RunwayCount = 2, IslandRadius = 12500, IslandShape = "BroadLobed", IslandAspectX = 1.20, IslandAspectZ = 0.84, IslandRotation = -70, IslandLobeA = 0.105, IslandLobeB = 0.045, IslandPhase = 1.75, Gates = 15, TerminalStyle = "STEPPED", Terrain = "Desert", Accent = Color3.fromRGB(255, 189, 98) },
	{ Code = "SPK", Name = "Spark Airport", Region = "Redstone Desert", Position = sparkPosition, Heading = emberHeading, RunwayLength = 2800, RunwayCount = 1, IslandRadius = 3200, ParentIslandCode = "EMB", Gates = 2, TerminalStyle = "COMPACT", Terrain = "Desert", SkipTerrain = true, BuildingCount = 12, TreeCount = 8, Accent = Color3.fromRGB(255, 126, 63) },
	{ Code = "IHP", Name = "Island Hop Airfield", Region = "Pelican Cay", Position = Vector3.new(4000, 0, 26000), Heading = 18, RunwayLength = 3000, IslandRadius = 6000, IslandShape = "Teardrop", IslandAspectX = 0.82, IslandAspectZ = 1.22, IslandRotation = 31, IslandLobeA = 0.065, IslandLobeB = 0.035, IslandPhase = 2.65, Gates = 2, TerminalStyle = "ROTUNDA", Terrain = "Tropical", Accent = Color3.fromRGB(248, 225, 109) },
	{ Code = "SKY", Name = "Skyline International", Region = "Metropolis Island", Position = skylinePosition, Heading = skylineHeading, RunwayLength = 5200, RunwayCount = 3, IslandRadius = 15000, IslandShape = "MultiLobed", IslandAspectX = 1.08, IslandAspectZ = 0.93, IslandRotation = 90, IslandLobeA = 0.115, IslandLobeB = 0.055, IslandPhase = 2.35, Gates = 14, TerminalStyle = "DUAL_PIER", Terrain = "Urban", Accent = Color3.fromRGB(122, 178, 255) },
	{ Code = "SKR", Name = "Skyline Regional", Region = "Metropolis Island", Position = skylineRegionalPosition, Heading = skylineHeading, RunwayLength = 2900, RunwayCount = 1, IslandRadius = 3500, ParentIslandCode = "SKY", Gates = 3, TerminalStyle = "COMPACT", Terrain = "Urban", SkipTerrain = true, BuildingCount = 18, TreeCount = 12, Accent = Color3.fromRGB(255, 198, 91) },
}

local byCode = {}
for _, airport in ipairs(list) do
	byCode[airport.Code] = airport
end

return {
	List = list,
	ByCode = byCode,
}
]]></ProtectedString><bool name="Disabled">false</bool></Properties>
  
</Item>
<Item class="ModuleScript" referent="RBX15">
  <Properties><string name="Name">AirportLayout</string><ProtectedString name="Source"><![CDATA[--!strict

-- V31 airport geometry shared by the live server, edit-mode builder, terminal
-- generator, and aircraft spawner. Keeping these values in one module prevents
-- the taxiway, terminal, apron, and gate positions from drifting apart.

local Layout = {
	WorldVersion = 31,
	GeometryRevision = 12,
	RunwayLayoutRevision = 30,
	TerminalShapeRevision = 31,
	WorldRadius = 50000,
	OceanExtent = 52000,
	CloudExtent = 46000,

	-- The A380 is the widest selectable aircraft at roughly 285 studs.
	MaxAircraftSpan = 79.75 / 0.28,
	MaxAircraftHalfSpan = (79.75 / 0.28) / 2,
	AircraftClearance = 60,

	RunwayWidth = 220,
	AdditionalRunwaySpacing = 760,
	AdditionalRunwayStagger = 260,
	StopwayLength = 240,
	RunwayThresholdInset = 92,
	TaxiwayX = 360,
	TaxiwayWidth = 190,
	ConnectorWidth = 140,
	TaxiwayFilletRadius = 135,
	ApronFilletRadius = 150,
	TaxiwayCurveSegments = 16,
	HoldShortOffset = 55,
	TaxiwayObstacleClearance = (79.75 / 0.28) / 2 + 70,

	FirstGateX = 760,
	GateSpacing = 380,
	GateStandWidth = 350,
	GateStandLength = 520,
	GateStandCenterZ = -90,

	-- Sixty studs of taxiway overlap plus a recessed continuity underlay makes
	-- the apron a single sealed pavement surface, even at curved entry fillets.
	ApronStartX = 395,
	ApronEndPadding = 280,
	ApronLength = 1040,
	ApronCenterZ = -220,
	ApronTaxiLaneWidth = 230,
	ApronTileSize = 115,
	ApronUnderlayOverlap = 72,

	TerminalStartX = 560,
	TerminalEndPadding = 120,
	SceneryShoreMargin = 1750,
	SceneryNegativeClearX = -250,
	SceneryPositiveClearX = 700,
	FacilityZMin = -1400,
	FacilityZMax = 1400,
	RoadRadiusScale = 0.32,
	GroundReserveSideBuffer = 900,
	GroundReserveEndBuffer = 900,
	TerrainMaximumHeight = 46,
	TerrainRunwayCorridorHalfWidth = 900,
	TerrainFacilityMargin = 520,
	-- Island floor uses 1,200-stud tiles; this allowance keeps a plane on the
	-- visible outer half-tile from being treated as if it had already hit water.
	IslandSurfaceAllowance = 900,
}

function Layout.GateX(gateNumber: number): number
	return Layout.FirstGateX + (gateNumber - 1) * Layout.GateSpacing
end

function Layout.LastGateX(airport): number
	return Layout.GateX(airport.Gates or 3)
end

function Layout.TerminalBounds(airport): (number, number)
	return Layout.TerminalStartX, Layout.LastGateX(airport) + Layout.TerminalEndPadding
end

function Layout.ApronBounds(airport): (number, number)
	return Layout.ApronStartX, Layout.LastGateX(airport) + Layout.ApronEndPadding
end

function Layout.FacilityEndX(airport): number
	local _, apronEnd = Layout.ApronBounds(airport)
	return apronEnd + Layout.AircraftClearance
end

function Layout.GateClearance(): number
	return Layout.GateSpacing - Layout.MaxAircraftSpan
end

function Layout.IslandBoundaryScale(airport, angle: number): number
	local lobeA = airport.IslandLobeA or 0
	local lobeB = airport.IslandLobeB or 0
	local phase = airport.IslandPhase or 0
	local lobeCount = airport.IslandShape == "MultiLobed" and 5 or (airport.IslandShape == "BayLobed" and 4 or 3)
	local boundary = 1
		+ lobeA * math.sin(lobeCount * angle + phase)
		+ lobeB * math.sin((lobeCount + 2) * angle - phase * 0.7)

	if airport.IslandShape == "Teardrop" then
		boundary += 0.13 * math.cos(angle) - 0.055 * math.cos(2 * angle)
	elseif airport.IslandShape == "Ridge" then
		boundary += 0.045 * math.sin(2 * angle + phase)
	elseif airport.IslandShape == "BayLobed" then
		boundary -= 0.055 * math.max(0, math.cos(angle - 0.55)) ^ 2
	end

	-- Radial waves add area, so normalize their average squared radius. Together
	-- with the near-reciprocal aspects this keeps the V31 land area near V27.
	local areaNormalization = 1 / math.sqrt(1 + (lobeA * lobeA + lobeB * lobeB) * 0.5 + 0.004)
	return boundary * areaNormalization
end

function Layout.IslandBoundaryLocalPoint(airport, angle: number, radiusScale: number?): Vector2
	local radius = airport.IslandRadius * Layout.IslandBoundaryScale(airport, angle) * (radiusScale or 1)
	local rotatedX = math.cos(angle) * radius * (airport.IslandAspectX or 1)
	local rotatedZ = math.sin(angle) * radius * (airport.IslandAspectZ or 1)
	local rotation = math.rad(airport.IslandRotation or 0)
	local cosine = math.cos(rotation)
	local sine = math.sin(rotation)
	return Vector2.new(rotatedX * cosine + rotatedZ * sine, -rotatedX * sine + rotatedZ * cosine)
end

function Layout.IsInsideIsland(airport, localX: number, localZ: number, padding: number?): boolean
	local safeRadius = airport.IslandRadius - (padding or 0)
	if safeRadius <= 0 then
		return false
	end

	local rotation = math.rad(airport.IslandRotation or 0)
	local cosine = math.cos(rotation)
	local sine = math.sin(rotation)
	local rotatedX = localX * cosine - localZ * sine
	local rotatedZ = localX * sine + localZ * cosine
	local aspectX = airport.IslandAspectX or 1
	local aspectZ = airport.IslandAspectZ or 1
	local normalizedX = rotatedX / (safeRadius * aspectX)
	local normalizedZ = rotatedZ / (safeRadius * aspectZ)
	local angle = math.atan2(normalizedZ, normalizedX)
	local boundary = Layout.IslandBoundaryScale(airport, angle)
	return normalizedX * normalizedX + normalizedZ * normalizedZ <= boundary * boundary
end

function Layout.TileTouchesIsland(airport, localX: number, localZ: number, tileSize: number): boolean
	local half = tileSize / 2
	for _, offset in ipairs({
		Vector2.new(0, 0),
		Vector2.new(-half, -half), Vector2.new(half, -half),
		Vector2.new(-half, half), Vector2.new(half, half),
		Vector2.new(-half, 0), Vector2.new(half, 0),
		Vector2.new(0, -half), Vector2.new(0, half),
	}) do
		if Layout.IsInsideIsland(airport, localX + offset.X, localZ + offset.Y) then
			return true
		end
	end
	return false
end

function Layout.FindContainingIsland(airports, worldPosition: Vector3)
	for _, airport in ipairs(airports) do
		if not airport.ParentIslandCode then
			local airportCF = CFrame.new(airport.Position) * CFrame.Angles(0, math.rad(-airport.Heading), 0)
			local localPosition = airportCF:PointToObjectSpace(worldPosition)
			if Layout.IsInsideIsland(airport, localPosition.X, localPosition.Z, -Layout.IslandSurfaceAllowance) then
				return airport
			end
		end
	end
	return nil
end

function Layout.GroundReserveBounds(airport): (number, number, number)
	local minimumX = math.huge
	local maximumX = -math.huge
	local maximumAbsZ = 0
	local protectedHalfWidth = Layout.RunwayWidth / 2 + Layout.GroundReserveSideBuffer
	local protectedHalfLength = airport.RunwayLength / 2 + Layout.StopwayLength + Layout.GroundReserveEndBuffer
	for _, placement in ipairs(Layout.RunwayPlacements(airport)) do
		local angle = math.rad(placement.HeadingDelta or 0)
		local extentX = protectedHalfWidth * math.abs(math.cos(angle)) + protectedHalfLength * math.abs(math.sin(angle))
		local extentZ = protectedHalfWidth * math.abs(math.sin(angle)) + protectedHalfLength * math.abs(math.cos(angle))
		minimumX = math.min(minimumX, placement.X - extentX)
		maximumX = math.max(maximumX, placement.X + extentX)
		maximumAbsZ = math.max(maximumAbsZ, math.abs(placement.Z) + extentZ)
	end
	local startX = minimumX
	local endX = math.max(maximumX, Layout.FacilityEndX(airport) + Layout.GroundReserveSideBuffer)
	local apronHalf = math.max(
		math.abs(Layout.ApronCenterZ - Layout.ApronLength / 2),
		math.abs(Layout.ApronCenterZ + Layout.ApronLength / 2)
	) + 420
	return startX, endX, math.max(maximumAbsZ, apronHalf)
end

function Layout.RunwayPlacements(airport)
	local placements = {}
	for index = 1, airport.RunwayCount or 1 do
		if index == 2 and airport.RunwayLayout == "CROSSING_SECONDARY" then
			placements[index] = {
				X = -math.max(Layout.AdditionalRunwaySpacing * 1.55, airport.RunwayLength * 0.28),
				Z = Layout.AdditionalRunwayStagger * 0.25,
				HeadingDelta = airport.RunwayCrossAngle or 42,
			}
		else
			local spacingIndex = index - 1
			if airport.RunwayLayout == "CROSSING_SECONDARY" and index > 2 then spacingIndex += 1 end
			local longitudinalOffset = index > 1 and (index % 2 == 0 and 1 or -1) * Layout.AdditionalRunwayStagger or 0
			placements[index] = {
				X = -spacingIndex * Layout.AdditionalRunwaySpacing,
				Z = longitudinalOffset,
				HeadingDelta = 0,
			}
		end
	end
	return placements
end

function Layout.RunwayLocalCFrame(placement): CFrame
	return CFrame.new(placement.X, 0, placement.Z) * CFrame.Angles(0, math.rad(-(placement.HeadingDelta or 0)), 0)
end

function Layout.RunwayHeading(airport, placement): number
	return (airport.Heading + (placement.HeadingDelta or 0)) % 360
end

function Layout.RunwayOffsets(airport): { number }
	local offsets = {}
	for index, placement in ipairs(Layout.RunwayPlacements(airport)) do
		offsets[index] = placement.X
	end
	return offsets
end

function Layout.IsMovementZone(airport, localX: number, localZ: number, margin: number?): boolean
	local padding = margin or 0
	local localPosition = Vector3.new(localX, 0, localZ)
	for _, placement in ipairs(Layout.RunwayPlacements(airport)) do
		local runwayPosition = Layout.RunwayLocalCFrame(placement):PointToObjectSpace(localPosition)
		if math.abs(runwayPosition.X) <= Layout.RunwayWidth / 2 + Layout.TaxiwayWidth + padding then
			return true
		end
	end
	return false
end

return Layout
]]></ProtectedString><bool name="Disabled">false</bool></Properties>
  
</Item>
<Item class="ModuleScript" referent="RBX16">
  <Properties><string name="Name">AirportSurfaces</string><ProtectedString name="Source"><![CDATA[--!nocheck

-- V30 shared runway, taxiway, and apron generator. Both the live server and
-- Studio edit-mode builder call this module so airport geometry cannot drift.

local Layout = require(script.Parent:WaitForChild("AirportLayout"))

local AirportSurfaces = {}

local RUNWAY = Color3.fromRGB(48, 53, 56)
local STOPWAY = Color3.fromRGB(57, 61, 63)
local TAXIWAY = Color3.fromRGB(73, 77, 78)
local APRON = Color3.fromRGB(108, 114, 115)
local WHITE = Color3.fromRGB(244, 244, 231)
local YELLOW = Color3.fromRGB(244, 190, 48)
local BLACK = Color3.fromRGB(25, 28, 29)
local BLUE = Color3.fromRGB(75, 154, 255)
local AMBER = Color3.fromRGB(255, 174, 40)

local function localPoint(x, y, z)
	return Vector3.new(x, y, z)
end

local function makeSegment(parent, makePart, airportCF, name, a, b, width, height, y, color, material, transparency, canCollide)
	local flatA = localPoint(a.X, y, a.Z)
	local flatB = localPoint(b.X, y, b.Z)
	local distance = (flatB - flatA).Magnitude
	if distance < 0.05 then return nil end
	local center = (flatA + flatB) / 2
	return makePart(
		parent,
		name,
		Vector3.new(width, height, distance + 1.8),
		airportCF * CFrame.lookAt(center, flatB),
		color,
		material,
		transparency or 0,
		canCollide
	)
end

local function quadraticPoint(a, control, b, t)
	local u = 1 - t
	return a * (u * u) + control * (2 * u * t) + b * (t * t)
end

local function makeQuadraticRibbon(parent, makePart, airportCF, name, a, control, b, width, height, y, color, material, segments, transparency, canCollide)
	local previous = a
	for index = 1, segments do
		local point = quadraticPoint(a, control, b, index / segments)
		makeSegment(parent, makePart, airportCF, name .. index, previous, point, width, height, y, color, material, transparency, canCollide)
		previous = point
	end
end

local function addTopText(part, text, rotation, color)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "PaintedSurfaceText"
	gui.Face = Enum.NormalId.Top
	gui.CanvasSize = Vector2.new(300, 420)
	gui.LightInfluence = 0.15
	gui.Parent = part

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	label.Rotation = rotation or 0
	label.Parent = gui
end

local function addTwoSidedSign(part, text, background, foreground)
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		local gui = Instance.new("SurfaceGui")
		gui.Name = "TaxiwaySignDisplay"
		gui.Face = face
		gui.CanvasSize = Vector2.new(500, 170)
		gui.LightInfluence = 0
		gui.Parent = part

		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundColor3 = background
		label.BorderColor3 = foreground
		label.BorderSizePixel = 8
		label.Font = Enum.Font.GothamBlack
		label.Text = text
		label.TextColor3 = foreground
		label.TextScaled = true
		label.Parent = gui
	end
end

local function runwayNumber(heading)
	local number = math.floor(((heading % 360) + 5) / 10) % 36
	if number == 0 then number = 36 end
	return string.format("%02d", number)
end

local function makeStopway(parent, makePart, airportCF, airport, endSign)
	local runwayHalf = airport.RunwayLength / 2
	local stopwayCenterZ = endSign * (runwayHalf + Layout.StopwayLength / 2)
	makePart(parent, "Stopway" .. endSign, Vector3.new(Layout.RunwayWidth, 1.6, Layout.StopwayLength), airportCF * CFrame.new(0, 0.20, stopwayCenterZ), STOPWAY, Enum.Material.Asphalt)

	-- Yellow chevrons identify pavement that is not part of the landing surface.
	for chevron = 1, 3 do
		local inward = 30 + (chevron - 1) * ((Layout.StopwayLength - 50) / 3)
		local z = endSign * (runwayHalf + inward)
		for side = -1, 1, 2 do
			local x = side * Layout.RunwayWidth * 0.20
			makePart(parent, "StopwayChevron" .. endSign .. "_" .. chevron .. "_" .. side, Vector3.new(4.2, 0.16, Layout.RunwayWidth * 0.42), airportCF * CFrame.new(x, 1.08, z) * CFrame.Angles(0, side * endSign * math.rad(43), 0), YELLOW, Enum.Material.SmoothPlastic, 0, false)
		end
	end
end

local function makeRunwayMarkings(parent, makePart, airportCF, airport, headingOverride)
	local runwayHalf = airport.RunwayLength / 2
	local thresholdInset = Layout.RunwayThresholdInset
	local thresholdZ = runwayHalf - thresholdInset

	-- Continuous edge lines and dashed centerline remain inside both thresholds.
	for side = -1, 1, 2 do
		makePart(parent, "RunwayEdgeLine" .. side, Vector3.new(3.0, 0.16, airport.RunwayLength - thresholdInset * 1.25), airportCF * CFrame.new(side * (Layout.RunwayWidth / 2 - 4), 1.09, 0), WHITE, Enum.Material.SmoothPlastic, 0, false)
	end
	for z = -thresholdZ + 125, thresholdZ - 90, 88 do
		makePart(parent, "RunwayCenterline", Vector3.new(4, 0.18, 38), airportCF * CFrame.new(0, 1.10, z), WHITE, Enum.Material.SmoothPlastic, 0, false)
	end

	for _, endSign in ipairs({ -1, 1 }) do
		local runwayHeading = headingOverride or airport.Heading
		local endHeading = endSign < 0 and runwayHeading or (runwayHeading + 180) % 360
		local designation = runwayNumber(endHeading)

		-- Eight paired longitudinal threshold stripes, inset from the pavement edge.
		for stripe = 1, 8 do
			local x = 9 + (stripe - 1) * 9.0
			for side = -1, 1, 2 do
				makePart(parent, "RunwayThresholdStripe" .. endSign .. "_" .. stripe .. "_" .. side, Vector3.new(5.2, 0.19, 66), airportCF * CFrame.new(side * x, 1.105, endSign * thresholdZ), WHITE, Enum.Material.SmoothPlastic, 0, false)
			end
		end

		local numberPart = makePart(parent, "RunwayDesignation" .. endSign, Vector3.new(58, 0.10, 72), airportCF * CFrame.new(0, 1.115, endSign * (runwayHalf - 155)), WHITE, Enum.Material.SmoothPlastic, 1, false)
		addTopText(numberPart, designation, endSign > 0 and 180 or 0, WHITE)

		-- Aiming-point blocks and coded touchdown-zone groups give distance cues.
		local aimingZ = endSign * (runwayHalf - airport.RunwayLength * 0.215)
		for side = -1, 1, 2 do
			makePart(parent, "RunwayAimingPoint" .. endSign .. "_" .. side, Vector3.new(12, 0.19, 76), airportCF * CFrame.new(side * 34, 1.11, aimingZ), WHITE, Enum.Material.SmoothPlastic, 0, false)
		end
		for group = 1, 3 do
			local bars = 4 - group
			local distance = airport.RunwayLength * (0.115 + group * 0.072)
			local z = endSign * (runwayHalf - distance)
			for bar = 1, bars do
				local x = 22 + (bar - 1) * 13
				for side = -1, 1, 2 do
					makePart(parent, "TouchdownZoneMarking" .. endSign .. "_" .. group .. "_" .. bar .. "_" .. side, Vector3.new(6.5, 0.18, 42), airportCF * CFrame.new(side * x, 1.105, z), WHITE, Enum.Material.SmoothPlastic, 0, false)
				end
			end
		end
	end
end

local function makeRunwaySafetyLighting(parent, makePart, airportCF, airport)
	local runwayHalf = airport.RunwayLength / 2
	for _, endSign in ipairs({ -1, 1 }) do
		-- Centerline approach lights extend beyond each stopway, with two wider
		-- crossbars that make runway alignment easier from the new world map.
		for lightIndex = 1, 9 do
			local z = endSign * (runwayHalf + Layout.StopwayLength + 30 + lightIndex * 34)
			local center = makePart(parent, "ApproachCenterLight" .. endSign .. "_" .. lightIndex, Vector3.new(1.4, 1.4, 1.4), airportCF * CFrame.new(0, 1.3, z), WHITE, Enum.Material.Neon, 0, false)
			center.Shape = Enum.PartType.Ball
			if lightIndex == 4 or lightIndex == 8 then
				for side = -3, 3 do
					if side ~= 0 then
						local bar = makePart(parent, "ApproachCrossbarLight" .. endSign .. "_" .. lightIndex .. "_" .. side, Vector3.new(1.3, 1.3, 1.3), airportCF * CFrame.new(side * 18, 1.3, z), WHITE, Enum.Material.Neon, 0, false)
						bar.Shape = Enum.PartType.Ball
					end
				end
			end
		end

		local papiX = -endSign * (Layout.RunwayWidth / 2 + 24)
		local papiZ = endSign * (runwayHalf - 330)
		for lamp = 1, 4 do
			local color = lamp <= 2 and Color3.fromRGB(255, 245, 218) or Color3.fromRGB(255, 67, 67)
			local light = makePart(parent, "PAPI" .. endSign .. "_" .. lamp, Vector3.new(3.0, 1.5, 3.0), airportCF * CFrame.new(papiX + (lamp - 2.5) * 8, 1.55, papiZ), color, Enum.Material.Neon, 0, false)
			light.Shape = Enum.PartType.Ball
		end
	end
end

local function makeHoldingPosition(parent, makePart, airportCF, connectorIndex, holdX, connectorZ, connectorWidth)
	-- Pattern A: two solid bars on the holding side and two dashed bars toward
	-- the runway. Black underlays improve contrast on the light taxi pavement.
	makePart(parent, "HoldingPositionBackdrop" .. connectorIndex, Vector3.new(18, 0.12, connectorWidth * 0.88), airportCF * CFrame.new(holdX, 1.075, connectorZ), BLACK, Enum.Material.SmoothPlastic, 0, false)
	for bar = 1, 2 do
		makePart(parent, "HoldingPositionSolid" .. connectorIndex .. "_" .. bar, Vector3.new(2.3, 0.18, connectorWidth * 0.82), airportCF * CFrame.new(holdX + 3 + (bar - 1) * 4.2, 1.105, connectorZ), YELLOW, Enum.Material.SmoothPlastic, 0, false)
	end
	for bar = 1, 2 do
		local x = holdX - 3 - (bar - 1) * 4.2
		for dash = -4, 4 do
			makePart(parent, "HoldingPositionDash" .. connectorIndex .. "_" .. bar .. "_" .. dash, Vector3.new(2.3, 0.18, 7.2), airportCF * CFrame.new(x, 1.105, connectorZ + dash * 12), YELLOW, Enum.Material.SmoothPlastic, 0, false)
		end
	end
	for side = -1, 1, 2 do
		local guard = makePart(parent, "RunwayGuardLight" .. connectorIndex .. "_" .. side, Vector3.new(1.8, 1.8, 1.8), airportCF * CFrame.new(holdX + 1, 2.15, connectorZ + side * connectorWidth * 0.47), AMBER, Enum.Material.Neon, 0, false)
		guard.Shape = Enum.PartType.Ball
	end
end

local function makeEnhancedCenterline(parent, makePart, airportCF, connectorIndex, fromX, toX, z)
	local length = math.max(10, toX - fromX)
	local count = math.max(3, math.floor(length / 24))
	for index = 1, count do
		local x = fromX + (index - 0.5) * length / count
		for side = -1, 1, 2 do
			makePart(parent, "EnhancedTaxiCenterline" .. connectorIndex .. "_" .. index .. "_" .. side, Vector3.new(math.max(7, length / count * 0.62), 0.16, 1.1), airportCF * CFrame.new(x, 1.105, z + side * 4.0), YELLOW, Enum.Material.SmoothPlastic, 0, false)
		end
	end
end

local function makeTaxiwaySign(parent, makePart, airportCF, name, text, x, z, mandatory)
	local sign = makePart(parent, name, Vector3.new(1.0, 5.5, 16), airportCF * CFrame.new(x, 3.2, z), mandatory and Color3.fromRGB(146, 31, 31) or BLACK, Enum.Material.Metal, 0, false)
	addTwoSidedSign(sign, text, mandatory and Color3.fromRGB(157, 34, 34) or BLACK, mandatory and WHITE or YELLOW)
	makePart(parent, name .. "Post", Vector3.new(0.8, 3, 0.8), airportCF * CFrame.new(x, 1.5, z), Color3.fromRGB(100, 104, 104), Enum.Material.Metal, 0, false)
end

local function makeTaxiways(parent, makePart, airportCF, airport, apronStartX, apronEndX)
	local taxiHalf = Layout.TaxiwayWidth / 2
	local taxiLength = airport.RunwayLength + Layout.StopwayLength * 0.45
	local taxiY = 0.375
	makePart(parent, "ParallelTaxiway", Vector3.new(Layout.TaxiwayWidth, 1.25, taxiLength), airportCF * CFrame.new(Layout.TaxiwayX, taxiY, 0), TAXIWAY, Enum.Material.Concrete)
	makePart(parent, "TaxiwayCenterline", Vector3.new(1.7, 0.18, taxiLength - 12), airportCF * CFrame.new(Layout.TaxiwayX, 1.105, 0), YELLOW, Enum.Material.SmoothPlastic, 0, false)
	for side = -1, 1, 2 do
		makePart(parent, "TaxiwayEdgeLine" .. side, Vector3.new(1.25, 0.16, taxiLength - 8), airportCF * CFrame.new(Layout.TaxiwayX + side * (taxiHalf - 4), 1.095, 0), YELLOW, Enum.Material.SmoothPlastic, 0, false)
		for z = -taxiLength / 2 + 25, taxiLength / 2 - 25, 82 do
			local light = makePart(parent, "TaxiwayEdgeLight" .. side, Vector3.new(1.25, 1.25, 1.25), airportCF * CFrame.new(Layout.TaxiwayX + side * (taxiHalf + 3), 1.75, z), BLUE, Enum.Material.Neon, 0, false)
			light.Shape = Enum.PartType.Ball
		end
	end

	local runwayRightEdge = Layout.RunwayWidth / 2
	local turnRadius = Layout.TaxiwayFilletRadius
	local connectorEndX = Layout.TaxiwayX - turnRadius + 8
	local connectorStartX = runwayRightEdge - 10
	local connectorLength = connectorEndX - connectorStartX
	local connectorCenterX = (connectorStartX + connectorEndX) / 2
	local runwayLabels = runwayNumber(airport.Heading) .. "-" .. runwayNumber((airport.Heading + 180) % 360)
	local connectorFractions = { -0.38, -0.19, 0, 0.19, 0.38 }

	for connectorIndex, fraction in ipairs(connectorFractions) do
		local connectorZ = airport.RunwayLength * fraction
		makePart(parent, "TaxiwayConnector" .. connectorIndex, Vector3.new(connectorLength + 2, 1.25, Layout.ConnectorWidth), airportCF * CFrame.new(connectorCenterX, taxiY, connectorZ), TAXIWAY, Enum.Material.Concrete)

		-- Two compact fillets replace the V15 circular pads. Their centerlines merge
		-- tangentially into the parallel taxiway, matching the supplied reference.
		for direction = -1, 1, 2 do
			local a = localPoint(Layout.TaxiwayX, taxiY, connectorZ + direction * turnRadius)
			local control = localPoint(Layout.TaxiwayX, taxiY, connectorZ)
			local b = localPoint(connectorEndX - 2, taxiY, connectorZ)
			makeQuadraticRibbon(parent, makePart, airportCF, "TaxiwayFilletSurface" .. connectorIndex .. "_" .. direction .. "_", a, control, b, Layout.ConnectorWidth, 1.25, taxiY, TAXIWAY, Enum.Material.Concrete, Layout.TaxiwayCurveSegments, 0, true)
			makeQuadraticRibbon(parent, makePart, airportCF, "TaxiwayFilletCenterline" .. connectorIndex .. "_" .. direction .. "_", a, control, b, 1.7, 0.18, 1.105, YELLOW, Enum.Material.SmoothPlastic, Layout.TaxiwayCurveSegments, 0, false)
		end

		local holdX = runwayRightEdge + Layout.HoldShortOffset
		makeSegment(parent, makePart, airportCF, "ConnectorCenterline" .. connectorIndex, localPoint(holdX + 12, 0, connectorZ), localPoint(connectorEndX, 0, connectorZ), 1.7, 0.18, 1.105, YELLOW, Enum.Material.SmoothPlastic, 0, false)
		makeSegment(parent, makePart, airportCF, "ConnectorRunwaySideCenterline" .. connectorIndex, localPoint(runwayRightEdge - 4, 0, connectorZ), localPoint(holdX - 12, 0, connectorZ), 1.7, 0.18, 1.105, YELLOW, Enum.Material.SmoothPlastic, 0, false)
		makeHoldingPosition(parent, makePart, airportCF, connectorIndex, holdX, connectorZ, Layout.ConnectorWidth)
		makeEnhancedCenterline(parent, makePart, airportCF, connectorIndex, holdX + 14, math.min(connectorEndX - 8, holdX + 105), connectorZ)

		makeTaxiwaySign(parent, makePart, airportCF, "RunwayHoldingSign" .. connectorIndex, runwayLabels, holdX + 8, connectorZ + Layout.ConnectorWidth * 0.60, true)
		makeTaxiwaySign(parent, makePart, airportCF, "TaxiwayLocationSign" .. connectorIndex, "A  •  A" .. connectorIndex, connectorEndX + 8, connectorZ - Layout.ConnectorWidth * 0.60, false)
	end

	-- A slightly recessed oversized underlay guarantees that no grass can show
	-- through along apron edges or between overlapping pavement pieces.
	local apronWidth = apronEndX - apronStartX
	local apronCenterX = (apronStartX + apronEndX) / 2
	local apronUnderlayOverlap = Layout.ApronUnderlayOverlap
	makePart(
		parent,
		"ApronContinuityUnderlay",
		Vector3.new(apronWidth + apronUnderlayOverlap * 2, 1.22, Layout.ApronLength + apronUnderlayOverlap * 2),
		airportCF * CFrame.new(apronCenterX, 0.34, Layout.ApronCenterZ),
		APRON,
		Enum.Material.Concrete
	)
	local apron = makePart(parent, "Apron", Vector3.new(apronWidth, 1.30, Layout.ApronLength), airportCF * CFrame.new(apronCenterX, 0.35, Layout.ApronCenterZ), APRON, Enum.Material.Concrete)
	apron:SetAttribute("AirportCode", airport.Code)

	local apronAccessZ = -math.min(560, airport.RunwayLength * 0.22)
	local apronTurnRadius = Layout.ApronFilletRadius
	local apronLaneStartX = apronStartX + apronTurnRadius
	local bridgeStartX = Layout.TaxiwayX - taxiHalf - 18
	local bridgeEndX = apronLaneStartX + 30
	makePart(
		parent,
		"ApronTaxiwayBridge",
		Vector3.new(bridgeEndX - bridgeStartX, 1.30, Layout.ApronTaxiLaneWidth),
		airportCF * CFrame.new((bridgeStartX + bridgeEndX) / 2, 0.35, apronAccessZ),
		TAXIWAY,
		Enum.Material.Concrete
	)
	for direction = -1, 1, 2 do
		local a = localPoint(Layout.TaxiwayX, taxiY, apronAccessZ + direction * apronTurnRadius)
		local control = localPoint(Layout.TaxiwayX, taxiY, apronAccessZ)
		local b = localPoint(apronLaneStartX, taxiY, apronAccessZ)
		makeQuadraticRibbon(parent, makePart, airportCF, "ApronEntryFilletSurface" .. direction .. "_", a, control, b, Layout.ApronTaxiLaneWidth, 1.25, taxiY, TAXIWAY, Enum.Material.Concrete, Layout.TaxiwayCurveSegments, 0, true)
		makeQuadraticRibbon(parent, makePart, airportCF, "ApronEntryCenterline" .. direction .. "_", a, control, b, 1.7, 0.18, 1.105, YELLOW, Enum.Material.SmoothPlastic, Layout.TaxiwayCurveSegments, 0, false)
	end
	makeSegment(parent, makePart, airportCF, "ApronTaxiLaneCenterline", localPoint(apronLaneStartX - 2, 0, apronAccessZ), localPoint(apronEndX - 28, 0, apronAccessZ), 1.7, 0.18, 1.105, YELLOW, Enum.Material.SmoothPlastic, 0, false)
	makeTaxiwaySign(parent, makePart, airportCF, "ApronDirectionSign", "A  •  GATES", Layout.TaxiwayX + taxiHalf + 12, apronAccessZ + apronTurnRadius * 0.72, false)

	return apron
end

local function makeAdditionalRunway(parent, makePart, airportCF, airport, runwayIndex, placement, previousPlacement)
	local offsetX = placement.X
	local offsetZ = placement.Z
	local group = Instance.new("Model")
	group.Name = "AdditionalRunway" .. runwayIndex
	group:SetAttribute("AirportCode", airport.Code)
	group:SetAttribute("RunwayIndex", runwayIndex)
	group:SetAttribute("LateralOffset", offsetX)
	group:SetAttribute("LongitudinalOffset", offsetZ)
	group:SetAttribute("HeadingDelta", placement.HeadingDelta or 0)
	group:SetAttribute("RunwayHeading", Layout.RunwayHeading(airport, placement))
	group.Parent = parent
	local placementCF = Layout.RunwayLocalCFrame(placement)
	local previousCF = Layout.RunwayLocalCFrame(previousPlacement)
	-- A hairline vertical separation prevents coplanar z-fighting where an
	-- angled runway crosses another runway; 0.025 studs is not a physical step.
	local runwayCF = airportCF * placementCF * CFrame.new(0, 0.025, 0)
	group:SetAttribute("IntersectionSurfaceLift", 0.025)
	local runway = makePart(group, "Runway" .. runwayIndex, Vector3.new(Layout.RunwayWidth, 2, airport.RunwayLength), runwayCF, RUNWAY, Enum.Material.Asphalt)
	runway:SetAttribute("AirportCode", airport.Code)
	runway:SetAttribute("RunwayIndex", runwayIndex)
	runway:SetAttribute("RunwayHeading", Layout.RunwayHeading(airport, placement))
	for side = -1, 1, 2 do
		makePart(group, "RunwayShoulder" .. side, Vector3.new(22, 1.35, airport.RunwayLength), runwayCF * CFrame.new(side * (Layout.RunwayWidth / 2 + 11), -0.25, 0), STOPWAY, Enum.Material.Asphalt)
	end
	makeStopway(group, makePart, runwayCF, airport, -1)
	makeStopway(group, makePart, runwayCF, airport, 1)
	makeRunwayMarkings(group, makePart, runwayCF, airport, Layout.RunwayHeading(airport, placement))
	makeRunwaySafetyLighting(group, makePart, runwayCF, airport)
	for z = -airport.RunwayLength / 2, airport.RunwayLength / 2, 72 do
		for _, x in ipairs({ -(Layout.RunwayWidth / 2 + 8), Layout.RunwayWidth / 2 + 8 }) do
			local light = makePart(group, "RunwayEdgeLight", Vector3.new(1.5, 1.5, 1.5), runwayCF * CFrame.new(x, 2, z), WHITE, Enum.Material.Neon, 0, false)
			light.Shape = Enum.PartType.Ball
		end
	end

	-- Every new runway gets its own full-length parallel taxiway, plus three
	-- cross-taxiways that connect it to the rest of the movement area.
	local taxiwayX = Layout.AdditionalRunwaySpacing * 0.46
	local taxiLength = airport.RunwayLength + Layout.StopwayLength * 0.45
	makePart(group, "ParallelTaxiway" .. runwayIndex, Vector3.new(Layout.TaxiwayWidth, 1.25, taxiLength), runwayCF * CFrame.new(taxiwayX, 0.375, 0), TAXIWAY, Enum.Material.Concrete)
	makePart(group, "TaxiwayCenterline" .. runwayIndex, Vector3.new(1.7, 0.18, taxiLength - 12), runwayCF * CFrame.new(taxiwayX, 1.105, 0), YELLOW, Enum.Material.SmoothPlastic, 0, false)
	for connectorIndex, fraction in ipairs({ -0.38, 0, 0.38 }) do
		local runwayZ = airport.RunwayLength * fraction
		local startPoint = placementCF:PointToWorldSpace(localPoint(Layout.RunwayWidth / 2 - 8, 0, runwayZ))
		local endPoint = previousCF:PointToWorldSpace(localPoint(-Layout.RunwayWidth / 2 + 8, 0, runwayZ))
		makeSegment(group, makePart, airportCF, "InterRunwayTaxiway" .. connectorIndex, startPoint, endPoint, Layout.ConnectorWidth, 1.25, 0.375, TAXIWAY, Enum.Material.Concrete, 0, true)
		makeSegment(group, makePart, airportCF, "InterRunwayCenterline" .. connectorIndex, startPoint, endPoint, 1.7, 0.18, 1.105, YELLOW, Enum.Material.SmoothPlastic, 0, false)
	end
	return runway
end

function AirportSurfaces.Build(parent, airportCF, airport, makePart)
	local placements = Layout.RunwayPlacements(airport)
	local primaryPlacement = placements[1]
	local primaryRunwayCF = airportCF * Layout.RunwayLocalCFrame(primaryPlacement)
	local runway = makePart(parent, "Runway", Vector3.new(Layout.RunwayWidth, 2, airport.RunwayLength), primaryRunwayCF, RUNWAY, Enum.Material.Asphalt)
	runway:SetAttribute("AirportCode", airport.Code)
	runway:SetAttribute("RunwayIndex", 1)
	runway:SetAttribute("RunwayHeading", Layout.RunwayHeading(airport, primaryPlacement))
	for side = -1, 1, 2 do
		makePart(parent, "RunwayShoulder" .. side, Vector3.new(22, 1.35, airport.RunwayLength), primaryRunwayCF * CFrame.new(side * (Layout.RunwayWidth / 2 + 11), -0.25, 0), STOPWAY, Enum.Material.Asphalt)
	end

	makeStopway(parent, makePart, primaryRunwayCF, airport, -1)
	makeStopway(parent, makePart, primaryRunwayCF, airport, 1)
	makeRunwayMarkings(parent, makePart, primaryRunwayCF, airport, Layout.RunwayHeading(airport, primaryPlacement))
	makeRunwaySafetyLighting(parent, makePart, primaryRunwayCF, airport)

	for z = -airport.RunwayLength / 2, airport.RunwayLength / 2, 55 do
		for _, x in ipairs({ -(Layout.RunwayWidth / 2 + 8), Layout.RunwayWidth / 2 + 8 }) do
			local light = makePart(parent, "RunwayEdgeLight", Vector3.new(1.5, 1.5, 1.5), primaryRunwayCF * CFrame.new(x, 2, z), WHITE, Enum.Material.Neon, 0, false)
			light.Shape = Enum.PartType.Ball
		end
	end

	local apronStartX, apronEndX = Layout.ApronBounds(airport)
	makeTaxiways(parent, makePart, primaryRunwayCF, airport, apronStartX, apronEndX)
	for runwayIndex = 2, #placements do
		makeAdditionalRunway(parent, makePart, airportCF, airport, runwayIndex, placements[runwayIndex], placements[runwayIndex - 1])
	end
	return runway
end

return AirportSurfaces
]]></ProtectedString><bool name="Disabled">false</bool></Properties>
  
</Item>
<Item class="ModuleScript" referent="RBX17">
  <Properties><string name="Name">AirportInteriors</string><ProtectedString name="Source"><![CDATA[--!nocheck

-- V20 shared airport architecture. Used by both the live server generator and
-- the edit-mode Studio builder so terminal details remain identical.

local AirportInteriors = {}
local Layout = require(script.Parent:WaitForChild("AirportLayout"))

local WHITE = Color3.fromRGB(226, 232, 232)
local DARK = Color3.fromRGB(42, 51, 56)
local GLASS = Color3.fromRGB(53, 111, 137)
local FLOOR = Color3.fromRGB(186, 191, 190)
local WOOD = Color3.fromRGB(137, 101, 68)
local GREEN = Color3.fromRGB(61, 135, 75)
local YELLOW = Color3.fromRGB(247, 196, 58)
local FIRST_GATE_X = Layout.FirstGateX
local GATE_SPACING = Layout.GateSpacing

local function gateLayout(airport)
	local gateCount = airport.Gates or 3
	local lastGateX = Layout.GateX(gateCount)
	local terminalStartX, terminalEndX = Layout.TerminalBounds(airport)
	return gateCount, lastGateX, terminalStartX, terminalEndX
end

local function addSign(part, text, accent)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "SignDisplay"
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(500, 170)
	gui.LightInfluence = 0
	gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = Color3.fromRGB(18, 30, 38)
	label.BackgroundTransparency = 0.08
	label.BorderSizePixel = 0
	label.Font = Enum.Font.GothamBold
	label.Text = text
	label.TextColor3 = accent or Color3.new(1, 1, 1)
	label.TextScaled = true
	label.Parent = gui
end

local function makeSeat(parent, makePart, baseCF, name, color)
	local seat = Instance.new("Seat")
	seat.Name = name .. "Seat"
	seat.Size = Vector3.new(4.2, 0.8, 4.2)
	seat.CFrame = baseCF * CFrame.new(0, 2.3, 0)
	seat.Color = color
	seat.Material = Enum.Material.Fabric
	seat.Anchored = true
	seat.CanCollide = true
	seat.TopSurface = Enum.SurfaceType.Smooth
	seat.BottomSurface = Enum.SurfaceType.Smooth
	seat:SetAttribute("TerminalSeat", true)
	seat.Parent = parent
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "SitPrompt"
	prompt.ActionText = "Sit"
	prompt.ObjectText = "Airport Seat"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt.Parent = seat
	makePart(parent, name .. "Back", Vector3.new(4.2, 4.4, 0.8), baseCF * CFrame.new(0, 4.2, 1.7), color, Enum.Material.Fabric)
	makePart(parent, name .. "Leg", Vector3.new(0.8, 2.2, 0.8), baseCF * CFrame.new(0, 1.1, 0), DARK, Enum.Material.Metal)
end

local function makePlant(parent, makePart, baseCF, name)
	local pot = makePart(parent, name .. "Pot", Vector3.new(4.2, 4.2, 4.2), baseCF * CFrame.new(0, 2.1, 0), Color3.fromRGB(149, 91, 62), Enum.Material.SmoothPlastic)
	pot.Shape = Enum.PartType.Cylinder
	makePart(parent, name .. "Stem", Vector3.new(0.8, 6, 0.8), baseCF * CFrame.new(0, 7, 0), Color3.fromRGB(76, 103, 60), Enum.Material.Wood)
	for leaf = 1, 5 do
		local angle = (leaf - 1) * math.pi * 0.4
		local foliage = makePart(parent, name .. "Leaf" .. leaf, Vector3.new(5.5, 3.2, 7), baseCF * CFrame.new(math.cos(angle) * 2.3, 10 + (leaf % 2), math.sin(angle) * 2.3) * CFrame.Angles(0, angle, 0), GREEN, Enum.Material.Grass, 0, false)
		foliage.Shape = Enum.PartType.Ball
	end
end

local function makeTableSet(parent, makePart, baseCF, name, seats)
	makePart(parent, name .. "Table", Vector3.new(9, 1, 9), baseCF * CFrame.new(0, 4, 0), WOOD, Enum.Material.Wood)
	makePart(parent, name .. "TableLeg", Vector3.new(1.2, 4, 1.2), baseCF * CFrame.new(0, 2, 0), DARK, Enum.Material.Metal)
	for index = 1, seats do
		local angle = (index - 1) * math.pi * 2 / seats
		makeSeat(parent, makePart, baseCF * CFrame.new(math.cos(angle) * 8, 0, math.sin(angle) * 8) * CFrame.Angles(0, -angle, 0), name .. "Chair" .. index, Color3.fromRGB(77, 105, 120))
	end
end

local function makeCounter(parent, makePart, baseCF, name, width, accent)
	makePart(parent, name .. "Base", Vector3.new(width, 5, 4), baseCF * CFrame.new(0, 2.5, 0), WHITE, Enum.Material.SmoothPlastic)
	makePart(parent, name .. "Top", Vector3.new(width + 1, 0.7, 5), baseCF * CFrame.new(0, 5.35, 0), DARK, Enum.Material.Metal)
	local screen = makePart(parent, name .. "Screen", Vector3.new(4, 3.2, 0.5), baseCF * CFrame.new(0, 7.4, 0.3), Color3.fromRGB(19, 52, 70), Enum.Material.Glass, 0.03, false)
	addSign(screen, name, accent)
end

local function makeJetbridgeV11(parent, makePart, airportCF, gateNumber, gateX)
	-- Reference-inspired bridge: hollow pivot room, overlapping telescoping
	-- corridors, an aircraft-end cab, support column, and wheel bogie. Every
	-- end remains open, so there is no invisible or solid wall in the walkway.
	local bridgeX = gateX + 15
	local floorY = 10
	local rotundaZ = 157
	makePart(parent, "JetBridgeRotundaFloor" .. gateNumber, Vector3.new(21, 1, 24), airportCF * CFrame.new(bridgeX, floorY, rotundaZ), Color3.fromRGB(131, 140, 143), Enum.Material.Metal)
	makePart(parent, "JetBridgeRotundaRoof" .. gateNumber, Vector3.new(21, 1, 24), airportCF * CFrame.new(bridgeX, floorY + 13, rotundaZ), WHITE, Enum.Material.SmoothPlastic)
	for side = -1, 1, 2 do
		makePart(parent, "JetBridgeRotundaFrame" .. gateNumber, Vector3.new(1, 13, 24), airportCF * CFrame.new(bridgeX + side * 10, floorY + 6.5, rotundaZ), Color3.fromRGB(169, 179, 182), Enum.Material.Metal)
		makePart(parent, "JetBridgeRotundaWindow" .. gateNumber, Vector3.new(0.35, 8, 19), airportCF * CFrame.new(bridgeX + side * 10.2, floorY + 7, rotundaZ), GLASS, Enum.Material.Glass, 0.14, true)
	end
	local pivot = makePart(parent, "JetBridgePivot" .. gateNumber, Vector3.new(5, 5, 5), airportCF * CFrame.new(bridgeX, 4.5, rotundaZ), Color3.fromRGB(112, 122, 126), Enum.Material.Metal)
	pivot.Shape = Enum.PartType.Cylinder

	local function tunnelSection(sectionName, width, length, centerZ, shade)
		makePart(parent, sectionName .. "Floor" .. gateNumber, Vector3.new(width, 1, length), airportCF * CFrame.new(bridgeX, floorY, centerZ), Color3.fromRGB(129, 138, 141), Enum.Material.Metal)
		makePart(parent, sectionName .. "RoofCenter" .. gateNumber, Vector3.new(width * 0.48, 1, length), airportCF * CFrame.new(bridgeX, floorY + 12.5, centerZ), WHITE, Enum.Material.SmoothPlastic)
		for side = -1, 1, 2 do
			makePart(parent, sectionName .. "RoofEdge" .. gateNumber, Vector3.new(width * 0.34, 1, length), airportCF * CFrame.new(bridgeX + side * width * 0.36, floorY + 12, centerZ) * CFrame.Angles(0, 0, side * math.rad(12)), WHITE, Enum.Material.SmoothPlastic)
			makePart(parent, sectionName .. "LowerPanel" .. gateNumber, Vector3.new(0.55, 4, length), airportCF * CFrame.new(bridgeX + side * (width / 2 - 0.25), floorY + 2.5, centerZ), shade, Enum.Material.Metal)
			makePart(parent, sectionName .. "WindowBand" .. gateNumber, Vector3.new(0.35, 6.5, length - 4), airportCF * CFrame.new(bridgeX + side * width / 2, floorY + 7.6, centerZ), GLASS, Enum.Material.Glass, 0.12, true)
		end
		for rib = 1, math.max(2, math.floor(length / 13)) do
			local z = centerZ - length / 2 + rib * length / (math.max(2, math.floor(length / 13)) + 1)
			for side = -1, 1, 2 do
				makePart(parent, sectionName .. "Rib" .. gateNumber, Vector3.new(0.8, 12, 0.8), airportCF * CFrame.new(bridgeX + side * (width / 2 - 0.4), floorY + 6.5, z), Color3.fromRGB(174, 183, 185), Enum.Material.Metal)
			end
		end
	end

	tunnelSection("JetBridgeFixedSection", 13, 54, 126, Color3.fromRGB(207, 213, 214))
	tunnelSection("JetBridgeTelescopingSection", 11, 58, 72, Color3.fromRGB(190, 198, 200))

	local cabZ = 39
	makePart(parent, "JetBridgeCabFloor" .. gateNumber, Vector3.new(19, 1, 18), airportCF * CFrame.new(bridgeX, floorY, cabZ), Color3.fromRGB(122, 132, 135), Enum.Material.Metal)
	makePart(parent, "JetBridgeCabRoof" .. gateNumber, Vector3.new(19, 1, 18), airportCF * CFrame.new(bridgeX, floorY + 13, cabZ), WHITE, Enum.Material.SmoothPlastic)
	for side = -1, 1, 2 do
		if side > 0 then
			makePart(parent, "JetBridgeCabWindow" .. gateNumber, Vector3.new(0.4, 9, 17), airportCF * CFrame.new(bridgeX + side * 9.2, floorY + 7, cabZ), GLASS, Enum.Material.Glass, 0.10, true)
		else
			-- Split the aircraft-facing wall around a real doorway. The parked
			-- plane's forward-left door meets this opening.
			makePart(parent, "JetBridgeCabWindowForward" .. gateNumber, Vector3.new(0.4, 9, 3.5), airportCF * CFrame.new(bridgeX - 9.2, floorY + 7, cabZ - 7), GLASS, Enum.Material.Glass, 0.10, true)
			makePart(parent, "JetBridgeCabWindowRear" .. gateNumber, Vector3.new(0.4, 9, 3.5), airportCF * CFrame.new(bridgeX - 9.2, floorY + 7, cabZ + 7), GLASS, Enum.Material.Glass, 0.10, true)
			makePart(parent, "JetBridgeAircraftDoorFrontFrame" .. gateNumber, Vector3.new(1, 13, 1), airportCF * CFrame.new(bridgeX - 9.2, floorY + 6.5, cabZ - 5), WHITE, Enum.Material.Metal)
			makePart(parent, "JetBridgeAircraftDoorRearFrame" .. gateNumber, Vector3.new(1, 13, 1), airportCF * CFrame.new(bridgeX - 9.2, floorY + 6.5, cabZ + 5), WHITE, Enum.Material.Metal)
			makePart(parent, "JetBridgeAircraftDoorTopFrame" .. gateNumber, Vector3.new(1, 1, 11), airportCF * CFrame.new(bridgeX - 9.2, floorY + 13, cabZ), WHITE, Enum.Material.Metal)
		end
	end
	-- The cab turntable is a visible mechanism below the passenger floor. It is
	-- non-colliding so it cannot become the "random wall" inside the bridge.
	local turntable = makePart(parent, "JetBridgeCabTurntable" .. gateNumber, Vector3.new(2.2, 20, 20), airportCF * CFrame.new(bridgeX, 4.2, cabZ) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(128, 137, 140), Enum.Material.Metal, 0, false)
	turntable.Shape = Enum.PartType.Cylinder
	makePart(parent, "JetBridgeSupportColumn" .. gateNumber, Vector3.new(3, 8, 3), airportCF * CFrame.new(bridgeX, 5.5, 78), Color3.fromRGB(116, 125, 129), Enum.Material.Metal)
	makePart(parent, "JetBridgeWheelAxle" .. gateNumber, Vector3.new(18, 2, 2), airportCF * CFrame.new(bridgeX, 2.8, 78), DARK, Enum.Material.Metal)
	for side = -1, 1, 2 do
		local wheel = makePart(parent, "JetBridgeWheel" .. gateNumber, Vector3.new(4.5, 4.5, 2), airportCF * CFrame.new(bridgeX + side * 7.5, 2.8, 78), DARK, Enum.Material.Rubber)
		wheel.Shape = Enum.PartType.Cylinder
	end
	makePart(parent, "JetBridgeDoorBumper" .. gateNumber, Vector3.new(1, 2, 11), airportCF * CFrame.new(bridgeX - 9.6, floorY + 1, cabZ), Color3.fromRGB(58, 65, 68), Enum.Material.Rubber, 0, false)
end

local function makeJetbridge(parent, makePart, airportCF, gateNumber, gateX)
	-- V24 overhead layout: terminal tunnel -> round rotunda -> 90-degree
	-- elbow -> aircraft cab -> flexible aircraft-door canopy. The telescoping
	-- sections overlap each adjoining section so there is no daylight gap.
	local aircraftCabX = gateX + 18
	local rotundaX = gateX + 70
	local elbowZ = 70
	local floorY = 10
	local rotundaDiameter = 28

	local rotundaFloor = makePart(parent, "V12RotundaFloor" .. gateNumber, Vector3.new(1, rotundaDiameter, rotundaDiameter), airportCF * CFrame.new(rotundaX, floorY, elbowZ) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(128, 138, 142), Enum.Material.Metal)
	rotundaFloor.Shape = Enum.PartType.Cylinder
	local rotundaRoof = makePart(parent, "V12RotundaRoof" .. gateNumber, Vector3.new(1, rotundaDiameter, rotundaDiameter), airportCF * CFrame.new(rotundaX, floorY + 13, elbowZ) * CFrame.Angles(0, 0, math.rad(90)), WHITE, Enum.Material.SmoothPlastic)
	rotundaRoof.Shape = Enum.PartType.Cylinder

	local function angleDistance(a, b)
		local delta = (a - b + math.pi) % (math.pi * 2) - math.pi
		return math.abs(delta)
	end
	for segment = 1, 16 do
		local angle = (segment - 1) * math.pi * 2 / 16
		local terminalOpening = angleDistance(angle, math.pi / 2) < math.rad(31)
		local elbowOpening = angleDistance(angle, math.pi) < math.rad(31)
		if not terminalOpening and not elbowOpening then
			local panelX = rotundaX + math.cos(angle) * (rotundaDiameter / 2 - 0.5)
			local panelZ = elbowZ + math.sin(angle) * (rotundaDiameter / 2 - 0.5)
			local tangentCF = airportCF * CFrame.new(panelX, floorY + 2.5, panelZ) * CFrame.Angles(0, math.pi / 2 - angle, 0)
			makePart(parent, "V12RotundaLowerPanel" .. gateNumber .. "_" .. segment, Vector3.new(5.5, 4, 0.55), tangentCF, Color3.fromRGB(186, 196, 199), Enum.Material.Metal)
			makePart(parent, "V12RotundaGlass" .. gateNumber .. "_" .. segment, Vector3.new(5.5, 7.2, 0.35), tangentCF * CFrame.new(0, 5.4, 0), GLASS, Enum.Material.Glass, 0.12, true)
		end
	end
	local pivot = makePart(parent, "V12RotundaPivot" .. gateNumber, Vector3.new(5, 10, 10), airportCF * CFrame.new(rotundaX, 4.5, elbowZ) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(105, 116, 121), Enum.Material.Metal)
	pivot.Shape = Enum.PartType.Cylinder

	local function longitudinalTunnel(name, width, length, centerZ, shade)
		makePart(parent, name .. "Floor" .. gateNumber, Vector3.new(width, 1, length), airportCF * CFrame.new(rotundaX, floorY, centerZ), Color3.fromRGB(129, 138, 141), Enum.Material.Metal)
		makePart(parent, name .. "RoofCenter" .. gateNumber, Vector3.new(width * 0.48, 1, length), airportCF * CFrame.new(rotundaX, floorY + 12.5, centerZ), WHITE, Enum.Material.SmoothPlastic)
		for side = -1, 1, 2 do
			makePart(parent, name .. "RoofEdge" .. gateNumber .. "_" .. side, Vector3.new(width * 0.34, 1, length), airportCF * CFrame.new(rotundaX + side * width * 0.36, floorY + 12, centerZ) * CFrame.Angles(0, 0, side * math.rad(12)), WHITE, Enum.Material.SmoothPlastic)
			makePart(parent, name .. "LowerPanel" .. gateNumber .. "_" .. side, Vector3.new(0.55, 4, length), airportCF * CFrame.new(rotundaX + side * (width / 2 - 0.25), floorY + 2.5, centerZ), shade, Enum.Material.Metal)
			makePart(parent, name .. "Window" .. gateNumber .. "_" .. side, Vector3.new(0.35, 6.5, length - 4), airportCF * CFrame.new(rotundaX + side * width / 2, floorY + 7.6, centerZ), GLASS, Enum.Material.Glass, 0.12, true)
		end
		local ribCount = math.max(2, math.floor(length / 13))
		for rib = 1, ribCount do
			local z = centerZ - length / 2 + rib * length / (ribCount + 1)
			for side = -1, 1, 2 do
				makePart(parent, name .. "Rib" .. gateNumber .. "_" .. side .. "_" .. rib, Vector3.new(0.8, 12, 0.8), airportCF * CFrame.new(rotundaX + side * (width / 2 - 0.4), floorY + 6.5, z), Color3.fromRGB(174, 183, 185), Enum.Material.Metal)
			end
		end
	end

	local function lateralTunnel(name, width, length, centerX, shade)
		makePart(parent, name .. "Floor" .. gateNumber, Vector3.new(length, 1, width), airportCF * CFrame.new(centerX, floorY, elbowZ), Color3.fromRGB(129, 138, 141), Enum.Material.Metal)
		makePart(parent, name .. "RoofCenter" .. gateNumber, Vector3.new(length, 1, width * 0.48), airportCF * CFrame.new(centerX, floorY + 12.5, elbowZ), WHITE, Enum.Material.SmoothPlastic)
		for side = -1, 1, 2 do
			makePart(parent, name .. "RoofEdge" .. gateNumber .. "_" .. side, Vector3.new(length, 1, width * 0.34), airportCF * CFrame.new(centerX, floorY + 12, elbowZ + side * width * 0.36) * CFrame.Angles(side * math.rad(12), 0, 0), WHITE, Enum.Material.SmoothPlastic)
			makePart(parent, name .. "LowerPanel" .. gateNumber .. "_" .. side, Vector3.new(length, 4, 0.55), airportCF * CFrame.new(centerX, floorY + 2.5, elbowZ + side * (width / 2 - 0.25)), shade, Enum.Material.Metal)
			makePart(parent, name .. "Window" .. gateNumber .. "_" .. side, Vector3.new(length - 4, 6.5, 0.35), airportCF * CFrame.new(centerX, floorY + 7.6, elbowZ + side * width / 2), GLASS, Enum.Material.Glass, 0.12, true)
		end
		local ribCount = math.max(2, math.floor(length / 12))
		for rib = 1, ribCount do
			local x = centerX - length / 2 + rib * length / (ribCount + 1)
			for side = -1, 1, 2 do
				makePart(parent, name .. "Rib" .. gateNumber .. "_" .. side .. "_" .. rib, Vector3.new(0.8, 12, 0.8), airportCF * CFrame.new(x, floorY + 6.5, elbowZ + side * (width / 2 - 0.4)), Color3.fromRGB(174, 183, 185), Enum.Material.Metal)
			end
		end
	end

	longitudinalTunnel("V12FixedTunnel", 16, 48, 141, Color3.fromRGB(207, 213, 214))
	longitudinalTunnel("V12TelescopingTunnel", 14, 58, 103, Color3.fromRGB(188, 197, 200))
	lateralTunnel("V12ElbowTunnel", 14, rotundaX - aircraftCabX, (rotundaX + aircraftCabX) / 2, Color3.fromRGB(181, 191, 194))

	makePart(parent, "V12CabFloor" .. gateNumber, Vector3.new(20, 1, 20), airportCF * CFrame.new(aircraftCabX, floorY, elbowZ), Color3.fromRGB(122, 132, 135), Enum.Material.Metal)
	makePart(parent, "V12CabRoof" .. gateNumber, Vector3.new(20, 1, 20), airportCF * CFrame.new(aircraftCabX, floorY + 13, elbowZ), WHITE, Enum.Material.SmoothPlastic)
	for side = -1, 1, 2 do
		makePart(parent, "V12CabLowerWall" .. gateNumber .. "_" .. side, Vector3.new(19, 4, 0.55), airportCF * CFrame.new(aircraftCabX, floorY + 2.5, elbowZ + side * 9.7), Color3.fromRGB(181, 191, 194), Enum.Material.Metal)
		makePart(parent, "V12CabGlass" .. gateNumber .. "_" .. side, Vector3.new(19, 7.2, 0.35), airportCF * CFrame.new(aircraftCabX, floorY + 7.7, elbowZ + side * 9.85), GLASS, Enum.Material.Glass, 0.10, true)
	end
	for side = -1, 1, 2 do
		local prefix = side < 0 and "V12AircraftDoor" or "V12ElbowDoor"
		local doorX = aircraftCabX + side * 9.7
		makePart(parent, prefix .. "FrontFrame" .. gateNumber, Vector3.new(1, 13, 1), airportCF * CFrame.new(doorX, floorY + 6.5, elbowZ - 6), WHITE, Enum.Material.Metal)
		makePart(parent, prefix .. "RearFrame" .. gateNumber, Vector3.new(1, 13, 1), airportCF * CFrame.new(doorX, floorY + 6.5, elbowZ + 6), WHITE, Enum.Material.Metal)
		makePart(parent, prefix .. "TopFrame" .. gateNumber, Vector3.new(1, 1, 13), airportCF * CFrame.new(doorX, floorY + 13, elbowZ), WHITE, Enum.Material.Metal)
	end

	-- A real passenger boarding bridge finishes in a flexible, covered hood that
	-- seals around the aircraft doorway. The hood overlaps the cab roof and side
	-- frames, closing the overly large visual gap from the rotunda/tunnel assembly.
	local canopyOuterX = aircraftCabX - 14
	local canopyInnerX = aircraftCabX - 7.5
	local canopyLength = canopyInnerX - canopyOuterX
	local canopyCenterX = (canopyOuterX + canopyInnerX) / 2
	local canopyWidth = 15
	makePart(parent, "V24JetBridgeCanopyRoof" .. gateNumber, Vector3.new(canopyLength, 1.2, canopyWidth), airportCF * CFrame.new(canopyCenterX, floorY + 12.5, elbowZ), Color3.fromRGB(52, 58, 61), Enum.Material.Rubber)
	makePart(parent, "V24JetBridgeCanopyFloor" .. gateNumber, Vector3.new(canopyLength, 0.8, canopyWidth - 1.2), airportCF * CFrame.new(canopyCenterX, floorY, elbowZ), Color3.fromRGB(73, 80, 83), Enum.Material.Metal)
	for side = -1, 1, 2 do
		makePart(parent, "V24JetBridgeCanopySide" .. gateNumber .. "_" .. side, Vector3.new(canopyLength, 11.5, 0.8), airportCF * CFrame.new(canopyCenterX, floorY + 6.3, elbowZ + side * canopyWidth / 2), Color3.fromRGB(46, 51, 54), Enum.Material.Rubber)
	end
	for fold = 0, 7 do
		local x = canopyOuterX + fold * canopyLength / 7
		makePart(parent, "V24JetBridgeCanopyTopFold" .. gateNumber .. "_" .. fold, Vector3.new(0.55, 1.7, canopyWidth + 0.6), airportCF * CFrame.new(x, floorY + 12.6, elbowZ), Color3.fromRGB(29, 34, 36), Enum.Material.Rubber)
		for side = -1, 1, 2 do
			makePart(parent, "V24JetBridgeCanopySideFold" .. gateNumber .. "_" .. side .. "_" .. fold, Vector3.new(0.55, 11.8, 1.15), airportCF * CFrame.new(x, floorY + 6.2, elbowZ + side * canopyWidth / 2), Color3.fromRGB(29, 34, 36), Enum.Material.Rubber)
		end
	end
	makePart(parent, "V24JetBridgeCanopyBumperTop" .. gateNumber, Vector3.new(1.4, 1.4, canopyWidth + 1.4), airportCF * CFrame.new(canopyOuterX - 0.5, floorY + 12.2, elbowZ), Color3.fromRGB(25, 29, 31), Enum.Material.Rubber, 0.05, false)
	for side = -1, 1, 2 do
		makePart(parent, "V24JetBridgeCanopyBumperSide" .. gateNumber .. "_" .. side, Vector3.new(1.4, 11.6, 1.4), airportCF * CFrame.new(canopyOuterX - 0.5, floorY + 6.1, elbowZ + side * (canopyWidth + 0.7) / 2), Color3.fromRGB(25, 29, 31), Enum.Material.Rubber, 0.05, false)
	end

	makePart(parent, "V12BridgeSupport" .. gateNumber, Vector3.new(3, 8, 3), airportCF * CFrame.new(rotundaX, 5.5, 106), Color3.fromRGB(116, 125, 129), Enum.Material.Metal)
	makePart(parent, "V12WheelAxle" .. gateNumber, Vector3.new(19, 2, 2), airportCF * CFrame.new(rotundaX, 2.8, 106), DARK, Enum.Material.Metal)
	for side = -1, 1, 2 do
		local wheel = makePart(parent, "V12BridgeWheel" .. gateNumber .. "_" .. side, Vector3.new(4.5, 4.5, 2), airportCF * CFrame.new(rotundaX + side * 8, 2.8, 106), DARK, Enum.Material.Rubber)
		wheel.Shape = Enum.PartType.Cylinder
	end
	makePart(parent, "V12DoorBumper" .. gateNumber, Vector3.new(1, 2, 13), airportCF * CFrame.new(aircraftCabX - 10.1, floorY + 1, elbowZ), Color3.fromRGB(58, 65, 68), Enum.Material.Rubber, 0, false)
end

local function makeTerminalShell(parent, makePart, airportCF, airport)
	local terminal = Instance.new("Model")
	terminal.Name = "EnterableTerminal"
	terminal:SetAttribute("AirportCode", airport.Code)
	terminal.Parent = parent
	local gateCount, _, terminalStartX, terminalEndX = gateLayout(airport)
	local terminalWidth = terminalEndX - terminalStartX
	local terminalCenterX = (terminalStartX + terminalEndX) / 2
	local terminalStyle = airport.TerminalStyle or "LINEAR"
	terminal:SetAttribute("TerminalWidth", terminalWidth)
	terminal:SetAttribute("TerminalStyle", terminalStyle)
	terminal:SetAttribute("TerminalShapeRevision", 31)

	-- The foundation overlaps the island and supports the entire shell, so no
	-- terminal slab or raised gate area can appear suspended in the air.
	makePart(terminal, "TerminalFoundation", Vector3.new(terminalWidth, 1.2, 190), airportCF * CFrame.new(terminalCenterX, -0.2, 260), Color3.fromRGB(151, 158, 158), Enum.Material.Concrete)
	makePart(terminal, "TerminalFloor", Vector3.new(terminalWidth, 2, 190), airportCF * CFrame.new(terminalCenterX, 1, 260), FLOOR, Enum.Material.Marble)
	makePart(terminal, "TerminalRoof", Vector3.new(terminalWidth, 2, 190), airportCF * CFrame.new(terminalCenterX, 51, 260), WHITE, Enum.Material.Metal)
	makePart(terminal, "TerminalLeftWall", Vector3.new(2, 50, 190), airportCF * CFrame.new(terminalStartX, 26, 260), WHITE, Enum.Material.Concrete)
	makePart(terminal, "TerminalRightWall", Vector3.new(2, 50, 190), airportCF * CFrame.new(terminalEndX, 26, 260), WHITE, Enum.Material.Concrete)

	-- Keep the gate-facing concourse and every jetbridge position fixed, while
	-- giving each airport a distinct roofline and bird's-eye terminal silhouette.
	-- All additions stay over the existing foundation, clear of the apron and
	-- landside access road, so variation cannot introduce new pavement gaps.
	local function roofBlock(name, size, localCF, color, material, transparency)
		return makePart(terminal, "V31" .. name, size, airportCF * localCF, color or WHITE, material or Enum.Material.Metal, transparency or 0, false)
	end
	if terminalStyle == "DUAL_PIER" then
		for pier, ratio in ipairs({ 0.30, 0.70 }) do
			local x = terminalStartX + terminalWidth * ratio
			roofBlock("RaisedPier" .. pier, Vector3.new(math.min(120, terminalWidth * 0.12), 9, 176), CFrame.new(x, 55.5, 260), airport.Accent)
			roofBlock("PierSkylight" .. pier, Vector3.new(math.min(82, terminalWidth * 0.08), 2, 142), CFrame.new(x, 61, 260), GLASS, Enum.Material.Glass, 0.18)
		end
	elseif terminalStyle == "ROTUNDA" then
		local rotundaDiameter = math.min(164, terminalWidth * 0.72)
		local rotunda = roofBlock("CentralRotunda", Vector3.new(8, rotundaDiameter, rotundaDiameter), CFrame.new(terminalCenterX, 56, 260) * CFrame.Angles(0, 0, math.rad(90)), airport.Accent)
		rotunda.Shape = Enum.PartType.Cylinder
		local skylight = roofBlock("RotundaSkylight", Vector3.new(3, rotundaDiameter * 0.62, rotundaDiameter * 0.62), CFrame.new(terminalCenterX, 62, 260) * CFrame.Angles(0, 0, math.rad(90)), GLASS, Enum.Material.Glass, 0.18)
		skylight.Shape = Enum.PartType.Cylinder
	elseif terminalStyle == "CRESCENT" then
		local sectionWidth = terminalWidth * 0.36
		roofBlock("CrescentLeft", Vector3.new(sectionWidth, 7, 154), CFrame.new(terminalCenterX - terminalWidth * 0.24, 55, 260) * CFrame.Angles(0, math.rad(-7), 0), airport.Accent)
		roofBlock("CrescentCenter", Vector3.new(terminalWidth * 0.34, 11, 174), CFrame.new(terminalCenterX, 57, 252), WHITE)
		roofBlock("CrescentRight", Vector3.new(sectionWidth, 7, 154), CFrame.new(terminalCenterX + terminalWidth * 0.24, 55, 260) * CFrame.Angles(0, math.rad(7), 0), airport.Accent)
	elseif terminalStyle == "RIDGE" then
		roofBlock("MountainRidge", Vector3.new(terminalWidth * 0.78, 14, 48), CFrame.new(terminalCenterX, 58, 260), airport.Accent)
		roofBlock("RidgeSkylight", Vector3.new(terminalWidth * 0.62, 2, 22), CFrame.new(terminalCenterX, 66, 260), GLASS, Enum.Material.Glass, 0.18)
	elseif terminalStyle == "T_PIER" then
		roofBlock("TPierSpine", Vector3.new(math.min(130, terminalWidth * 0.16), 9, 176), CFrame.new(terminalCenterX, 55.5, 260), airport.Accent)
		roofBlock("TPierCrossbar", Vector3.new(terminalWidth * 0.62, 8, 54), CFrame.new(terminalCenterX, 55, 290), WHITE)
	elseif terminalStyle == "STEPPED" then
		for section = 1, 3 do
			local sectionWidth = terminalWidth / 3
			local x = terminalStartX + (section - 0.5) * sectionWidth
			local depth = ({ 138, 176, 150 })[section]
			local height = ({ 6, 13, 9 })[section]
			roofBlock("SteppedRoof" .. section, Vector3.new(sectionWidth - 8, height, depth), CFrame.new(x, 51 + height / 2, 260 + (section - 2) * 8), section == 2 and airport.Accent or WHITE)
		end
	elseif terminalStyle == "COMPACT" then
		roofBlock("CompactHall", Vector3.new(terminalWidth * 0.68, 10, 142), CFrame.new(terminalCenterX, 56, 266), airport.Accent)
		roofBlock("CompactSkylight", Vector3.new(terminalWidth * 0.42, 2, 92), CFrame.new(terminalCenterX, 62, 266), GLASS, Enum.Material.Glass, 0.18)
	end

	-- Landside wall segments leave real doorway gaps. The translucent door
	-- panels are intentionally non-colliding; every other glass wall is solid.
	local rearCursor = terminalStartX
	local entranceIndex = 0
	for entranceX = terminalStartX + 150, terminalEndX - 45, 380 do
		entranceIndex += 1
		local openingStart = entranceX - 28
		if openingStart > rearCursor then
			makePart(terminal, "LandsideWall" .. entranceIndex, Vector3.new(openingStart - rearCursor, 50, 2), airportCF * CFrame.new((rearCursor + openingStart) / 2, 26, 355), WHITE, Enum.Material.Concrete)
		end
		makePart(terminal, "AutomaticEntrance" .. entranceIndex, Vector3.new(54, 24, 1), airportCF * CFrame.new(entranceX, 13, 355), GLASS, Enum.Material.Glass, 0.32, false)
		local sign = makePart(terminal, "EntranceSign" .. entranceIndex, Vector3.new(38, 7, 1), airportCF * CFrame.new(entranceX, 35, 354), DARK, Enum.Material.SmoothPlastic, 0, false)
		addSign(sign, "DEPARTURES  •  ARRIVALS", airport.Accent)
		rearCursor = entranceX + 28
	end
	if rearCursor < terminalEndX then
		makePart(terminal, "LandsideWallEnd", Vector3.new(terminalEndX - rearCursor, 50, 2), airportCF * CFrame.new((rearCursor + terminalEndX) / 2, 26, 355), WHITE, Enum.Material.Concrete)
	end

	-- Raised airside concourse matches the jetbridge floor. Broad steps connect
	-- it to the main terminal floor without blocking the gate corridor.
	makePart(terminal, "GateConcourseFoundation", Vector3.new(terminalWidth, 8, 76), airportCF * CFrame.new(terminalCenterX, 4, 202), Color3.fromRGB(167, 174, 175), Enum.Material.Concrete)
	makePart(terminal, "RaisedGateConcourse", Vector3.new(terminalWidth, 2, 76), airportCF * CFrame.new(terminalCenterX, 9, 202), FLOOR, Enum.Material.Marble)
	for stairway, stairX in ipairs({ terminalStartX + 160, math.min(terminalEndX - 90, terminalStartX + 650) }) do
		if stairway == 1 or stairX > 600 then
			for step = 1, 8 do
				makePart(terminal, "ConcourseStep" .. stairway .. "_" .. step, Vector3.new(42, step, 4), airportCF * CFrame.new(stairX, 2 + step / 2, 265 - step * 4), FLOOR, Enum.Material.Marble)
			end
		end
	end

	-- Solid apron-facing curtain wall with an actual opening at every bridge.
	local glassCursor = terminalStartX
	for gate = 1, gateCount do
		local bridgeX = FIRST_GATE_X + (gate - 1) * GATE_SPACING + 70
		local openingStart = bridgeX - 12
		if openingStart > glassCursor then
			makePart(terminal, "SolidAirsideGlass" .. gate, Vector3.new(openingStart - glassCursor, 34, 1), airportCF * CFrame.new((glassCursor + openingStart) / 2, 25, 165), GLASS, Enum.Material.Glass, 0.20, true)
		end
		makePart(terminal, "GateDoorLeftFrame" .. gate, Vector3.new(1, 15, 2), airportCF * CFrame.new(openingStart, 17, 165), WHITE, Enum.Material.Metal)
		makePart(terminal, "GateDoorRightFrame" .. gate, Vector3.new(1, 15, 2), airportCF * CFrame.new(bridgeX + 12, 17, 165), WHITE, Enum.Material.Metal)
		makePart(terminal, "GateDoorTopFrame" .. gate, Vector3.new(25, 2, 2), airportCF * CFrame.new(bridgeX, 24, 165), WHITE, Enum.Material.Metal)
		glassCursor = bridgeX + 12
	end
	if glassCursor < terminalEndX then
		makePart(terminal, "SolidAirsideGlassEnd", Vector3.new(terminalEndX - glassCursor, 34, 1), airportCF * CFrame.new((glassCursor + terminalEndX) / 2, 25, 165), GLASS, Enum.Material.Glass, 0.20, true)
	end
	makePart(terminal, "TerminalFascia", Vector3.new(terminalWidth + 5, 8, 5), airportCF * CFrame.new(terminalCenterX, 46, 165), airport.Accent, Enum.Material.SmoothPlastic)
	makePart(terminal, "LandsideRoofFascia", Vector3.new(terminalWidth + 5, 7, 5), airportCF * CFrame.new(terminalCenterX, 47, 355), airport.Accent, Enum.Material.SmoothPlastic)
	-- Slender exterior columns make the long terminal read as a supported real
	-- building while remaining outside the passenger walkway and door openings.
	for columnX = terminalStartX + 55, terminalEndX - 40, 120 do
		makePart(terminal, "TerminalStructureColumn", Vector3.new(4, 49, 4), airportCF * CFrame.new(columnX, 25.5, 359), Color3.fromRGB(204, 211, 212), Enum.Material.Concrete)
	end
	return terminal
end

local function furnishTerminal(terminal, makePart, airportCF, airport)
	local gateCount, _, terminalStartX, terminalEndX = gateLayout(airport)
	local interiorShift = terminalStartX - 150
	local interiorCF = airportCF * CFrame.new(interiorShift, 0, 0)
	local interiorEndX = terminalEndX - interiorShift

	-- Check-in hall and staffed service positions.
	for desk = 1, 7 do
		makeCounter(terminal, makePart, interiorCF * CFrame.new(205 + desk * 28, 2, 325), "CheckIn" .. desk, 20, airport.Accent)
	end
	makeCounter(terminal, makePart, interiorCF * CFrame.new(640, 2, 325), "ServiceDesk", 48, airport.Accent)

	-- Full security lanes with queue rails, conveyor belts, scanners, and arches.
	for lane = 1, 3 do
		local x = 285 + lane * 70
		makePart(terminal, "SecurityConveyor" .. lane, Vector3.new(42, 4, 8), interiorCF * CFrame.new(x, 4, 289), DARK, Enum.Material.Metal)
		makePart(terminal, "XRayScanner" .. lane, Vector3.new(14, 12, 12), interiorCF * CFrame.new(x + 9, 9, 289), Color3.fromRGB(92, 110, 119), Enum.Material.Metal)
		makePart(terminal, "MetalDetectorLeft" .. lane, Vector3.new(2, 13, 2), interiorCF * CFrame.new(x - 21, 8, 284), WHITE, Enum.Material.Metal)
		makePart(terminal, "MetalDetectorRight" .. lane, Vector3.new(2, 13, 2), interiorCF * CFrame.new(x - 21, 8, 294), WHITE, Enum.Material.Metal)
		makePart(terminal, "MetalDetectorTop" .. lane, Vector3.new(2, 2, 12), interiorCF * CFrame.new(x - 21, 14.5, 289), WHITE, Enum.Material.Metal)
		for rail = -1, 1, 2 do
			makePart(terminal, "SecurityQueueRail" .. lane, Vector3.new(1, 4, 40), interiorCF * CFrame.new(x + rail * 25, 4, 290), Color3.fromRGB(95, 108, 114), Enum.Material.Metal)
		end
	end

	-- Airport-specific numbered gates, departure screens, seats, and bridges.
	for gate = 1, gateCount do
		local gateX = Layout.GateX(gate)
		local terminalDoorX = gateX + 70
		-- A dedicated concrete stand guarantees that every parked aircraft starts
		-- on paved apron, even when its real-world fuselage length is very large.
		-- The continuous apron is the visible pavement. This recessed stand base
		-- guarantees support without creating raised islands or grass seams.
		makePart(terminal, "V20GateStandBase" .. gate, Vector3.new(Layout.GateStandWidth, 0.46, Layout.GateStandLength), airportCF * CFrame.new(gateX, 0.75, Layout.GateStandCenterZ), Color3.fromRGB(108, 116, 118), Enum.Material.Concrete)
		makePart(terminal, "GateLeadIn" .. gate, Vector3.new(1.4, 0.16, 245), airportCF * CFrame.new(gateX, 1.08, -5), YELLOW, Enum.Material.Neon, 0, false)
		local gateSign = makePart(terminal, "NumberedGate" .. gate, Vector3.new(34, 11, 1), airportCF * CFrame.new(terminalDoorX, 31, 168), DARK, Enum.Material.SmoothPlastic, 0, false)
		addSign(gateSign, airport.Code .. "  GATE " .. gate, airport.Accent)
		local seatsPerGate = 4
		for seat = 1, seatsPerGate do
			makeSeat(terminal, makePart, airportCF * CFrame.new(terminalDoorX + (seat - (seatsPerGate + 1) / 2) * 10, 10, 202), "Gate" .. gate .. "Seat" .. seat, Color3.fromRGB(60, 105, 126))
		end
		if gate == 1 or gate == gateCount or gate % 4 == 0 then
			makePlant(terminal, makePart, airportCF * CFrame.new(gateX + 90, 10, 218), "GatePlant" .. gate)
		end
		makeJetbridge(terminal, makePart, airportCF, gate, gateX)
	end

	-- Lounge, cafe, restaurant, and duty-free retail areas.
	makePart(terminal, "LoungeDivider", Vector3.new(2, 18, 62), interiorCF * CFrame.new(675, 11, 245), GLASS, Enum.Material.Glass, 0.2, true)
	local loungeSign = makePart(terminal, "LoungeSign", Vector3.new(32, 8, 1), interiorCF * CFrame.new(680, 25, 214), DARK, Enum.Material.SmoothPlastic, 0, false)
	addSign(loungeSign, "AIRPORT LOUNGE", airport.Accent)
	for set = 1, 3 do makeTableSet(terminal, makePart, interiorCF * CFrame.new(640 + (set % 2) * 38, 2, 225 + set * 18), "LoungeSet" .. set, 2) end

	makeCounter(terminal, makePart, interiorCF * CFrame.new(184, 2, 250), "Cafe", 46, Color3.fromRGB(255, 203, 104))
	for set = 1, 3 do makeTableSet(terminal, makePart, interiorCF * CFrame.new(190, 2, 190 + set * 18), "CafeTable" .. set, 2) end
	makeCounter(terminal, makePart, interiorCF * CFrame.new(190, 2, 300), "Restaurant", 55, Color3.fromRGB(255, 143, 103))
	for set = 1, 3 do makeTableSet(terminal, makePart, interiorCF * CFrame.new(240 + set * 22, 2, 255), "RestaurantTable" .. set, 2) end

	local shopSign = makePart(terminal, "DutyFreeSign", Vector3.new(42, 9, 1), interiorCF * CFrame.new(585, 25, 260), DARK, Enum.Material.SmoothPlastic, 0, false)
	addSign(shopSign, "DUTY FREE", Color3.fromRGB(255, 221, 110))
	for shelf = 1, 4 do
		makePart(terminal, "DutyFreeShelf" .. shelf, Vector3.new(9, 8, 28), interiorCF * CFrame.new(535 + shelf * 24, 6, 260), WOOD, Enum.Material.Wood)
		for tier = 1, 3 do makePart(terminal, "DutyFreeDisplay" .. shelf, Vector3.new(10, 0.4, 28), interiorCF * CFrame.new(535 + shelf * 24, 2 + tier * 2.2, 260), Color3.fromRGB(235, 215, 171), Enum.Material.Wood, 0, false) end
	end

	-- Arrivals: baggage claim carousels beside the service desk.
	for belt = 1, 2 do
		local x = 280 + belt * 100
		makePart(terminal, "BaggageClaimBelt" .. belt, Vector3.new(72, 3.5, 18), interiorCF * CFrame.new(x, 4, 340), DARK, Enum.Material.Metal)
		makePart(terminal, "BaggageClaimCenter" .. belt, Vector3.new(54, 4, 8), interiorCF * CFrame.new(x, 5, 340), Color3.fromRGB(118, 131, 136), Enum.Material.Metal)
	end

	-- Two accessible restroom zones with partitions, sinks, and clear entrances.
	for room, x in ipairs({ 165, 695 }) do
		makePart(terminal, "BathroomWall" .. room, Vector3.new(48, 16, 2), interiorCF * CFrame.new(x, 10, 310), WHITE, Enum.Material.Concrete)
		for stall = 1, 3 do
			makePart(terminal, "BathroomStall" .. room, Vector3.new(1, 10, 12), interiorCF * CFrame.new(x - 20 + stall * 10, 7, 320), Color3.fromRGB(177, 190, 193), Enum.Material.SmoothPlastic)
			makePart(terminal, "BathroomFixture" .. room, Vector3.new(5, 2.5, 6), interiorCF * CFrame.new(x - 20 + stall * 10, 3.2, 326), Color3.fromRGB(235, 239, 239), Enum.Material.SmoothPlastic)
		end
		makeCounter(terminal, makePart, interiorCF * CFrame.new(x, 2, 300), "BathroomSink", 30, airport.Accent)
	end

	-- Bright ceiling fixtures throughout the public hall.
	for x = 180, interiorEndX - 30, 75 do
		for z = 185, 335, 50 do
			local lightPart = makePart(terminal, "TerminalLighting", Vector3.new(18, 0.5, 5), interiorCF * CFrame.new(x, 41.5, z), Color3.fromRGB(255, 246, 205), Enum.Material.Neon, 0, false)
			local light = Instance.new("SurfaceLight")
			light.Face = Enum.NormalId.Bottom
			light.Brightness = 1.2
			light.Range = 35
			light.Angle = 120
			light.Parent = lightPart
		end
	end
end

local function buildApronTiles(parent, makePart, airportCF, airport)
	local apronStartX, apronEndX = Layout.ApronBounds(airport)
	local apronWidth = apronEndX - apronStartX
	local apronCenterX = (apronStartX + apronEndX) / 2
	local halfLength = Layout.ApronLength / 2
	local tileSize = Layout.ApronTileSize
	local seamColor = Color3.fromRGB(58, 65, 67)
	-- Large concrete slabs with moderately visible joints. V20 keeps the pattern
	-- readable while the continuous underlay prevents grass from showing through.
	for x = apronStartX + tileSize, apronEndX - 1, tileSize do
		makePart(parent, "ApronTileJointX", Vector3.new(0.72, 0.055, Layout.ApronLength - 8), airportCF * CFrame.new(x, 1.03, Layout.ApronCenterZ), seamColor, Enum.Material.SmoothPlastic, 0.42, false)
	end
	for z = Layout.ApronCenterZ - halfLength + tileSize, Layout.ApronCenterZ + halfLength - 1, tileSize do
		makePart(parent, "ApronTileJointZ", Vector3.new(apronWidth - 8, 0.055, 0.72), airportCF * CFrame.new(apronCenterX, 1.031, z), seamColor, Enum.Material.SmoothPlastic, 0.42, false)
	end
end

local function buildRoadsAndParking(parent, makePart, airportCF, airport)
	local _, _, terminalStartX, terminalEndX = gateLayout(airport)
	local roadRadius = math.min(airport.IslandRadius * Layout.RoadRadiusScale, airport.IslandRadius - Layout.SceneryShoreMargin - 100)
	local points = {}
	-- Roads remain on the landside half of each island. This avoids runway,
	-- taxiway, apron, and ocean intersections at every airport size.
	for index = 1, 7 do
		local angle = math.rad(12 + (index - 1) * 26)
		points[index] = Vector3.new(math.cos(angle) * roadRadius, 0, math.sin(angle) * roadRadius)
	end
	for index = 1, #points - 1 do
		local a = points[index]
		local b = points[index + 1]
		local center = (a + b) / 2
		local length = (b - a).Magnitude
		makePart(parent, "LandsidePerimeterRoad" .. index, Vector3.new(26, 0.8, length + 3), airportCF * CFrame.lookAt(center, b), Color3.fromRGB(54, 57, 59), Enum.Material.Asphalt)
	end
	local accessCenterX = (terminalStartX + terminalEndX) / 2
	local accessWidth = terminalEndX - terminalStartX + 140
	makePart(parent, "TerminalAccessRoad", Vector3.new(accessWidth, 0.8, 28), airportCF * CFrame.new(accessCenterX, -0.6, 405), Color3.fromRGB(54, 57, 59), Enum.Material.Asphalt)
	local connectorX = terminalStartX + 80
	local connectorEndZ = math.sqrt(math.max(0, roadRadius * roadRadius - connectorX * connectorX))
	local connectorLength = math.max(100, connectorEndZ - 405)
	makePart(parent, "AirportConnectorRoad", Vector3.new(28, 0.8, connectorLength), airportCF * CFrame.new(connectorX, -0.6, 405 + connectorLength / 2), Color3.fromRGB(54, 57, 59), Enum.Material.Asphalt)

	-- A compact landside neighborhood grid adds road density while remaining
	-- entirely beyond the protected negative-X side of the runway corridor.
	local districtCenterX = -math.min(airport.IslandRadius * 0.38, 3600)
	local districtHalfZ = math.min(roadRadius * 0.68, 2050)
	for avenue = -1, 1 do
		makePart(parent, "LandsideDistrictAvenue" .. avenue, Vector3.new(24, 0.8, districtHalfZ * 2), airportCF * CFrame.new(districtCenterX + avenue * 360, -0.58, 0), Color3.fromRGB(57, 60, 62), Enum.Material.Asphalt)
	end
	for street = -2, 2 do
		makePart(parent, "LandsideDistrictStreet" .. street, Vector3.new(1100, 0.8, 22), airportCF * CFrame.new(districtCenterX, -0.57, street * districtHalfZ / 2), Color3.fromRGB(57, 60, 62), Enum.Material.Asphalt)
	end

	local parkingX = terminalStartX + 300
	local parkingZ = 500
	makePart(parent, "AirportParkingLot", Vector3.new(560, 0.9, 130), airportCF * CFrame.new(parkingX, -0.45, parkingZ), Color3.fromRGB(66, 70, 72), Enum.Material.Asphalt)
	for row = -1, 1, 2 do
		for space = 1, 20 do
			local x = parkingX - 255 + space * 25
			makePart(parent, "ParkingSpaceLine", Vector3.new(0.5, 0.12, 19), airportCF * CFrame.new(x, 0.08, parkingZ + row * 38), Color3.fromRGB(235, 235, 224), Enum.Material.Neon, 0, false)
		end
	end
	for car = 1, 12 do
		local row = car % 2 == 0 and -1 or 1
		local x = parkingX - 235 + car * 38
		makePart(parent, "ParkedCar" .. car, Vector3.new(9, 4, 16), airportCF * CFrame.new(x, 2.5, parkingZ + row * 38), Color3.fromHSV((car * 0.11) % 1, 0.58, 0.82), Enum.Material.Metal)
		makePart(parent, "ParkedCarGlass" .. car, Vector3.new(7.5, 2.4, 7), airportCF * CFrame.new(x, 5.2, parkingZ + row * 38), GLASS, Enum.Material.Glass, 0.15, false)
	end
end

local function buildSkylineDistrict(parent, makePart, airportCF, airport)
	if airport.Code ~= "SKY" then return end

	local city = Instance.new("Model")
	city.Name = "V25 Skyline District"
	city:SetAttribute("BuildingCount", 99)
	city.Parent = parent
	local random = Random.new(20200820)
	local roadColor = Color3.fromRGB(45, 49, 54)
	local sidewalkColor = Color3.fromRGB(128, 134, 139)

	-- A regular street grid makes the high-rise cluster read as a dense city
	-- from the air while keeping every tower well clear of the runway complex.
	for column = 0, 9 do
		local x = -8500 + column * 560
		makePart(city, "CityAvenue" .. column, Vector3.new(52, 0.9, 7900), airportCF * CFrame.new(x, -0.55, 0), roadColor, Enum.Material.Asphalt)
		makePart(city, "AvenueMedian" .. column, Vector3.new(3, 0.14, 7900), airportCF * CFrame.new(x, -0.02, 0), Color3.fromRGB(238, 196, 68), Enum.Material.Neon, 0, false)
	end
	for row = 0, 11 do
		local z = -3850 + row * 700
		makePart(city, "CityStreet" .. row, Vector3.new(5200, 0.9, 48), airportCF * CFrame.new(-5980, -0.54, z), roadColor, Enum.Material.Asphalt)
	end
	makePart(city, "SkylineBoulevard", Vector3.new(84, 1.0, 8000), airportCF * CFrame.new(-5980, -0.50, 0), Color3.fromRGB(38, 43, 48), Enum.Material.Asphalt)

	local facadeColors = {
		Color3.fromRGB(73, 103, 121),
		Color3.fromRGB(86, 112, 131),
		Color3.fromRGB(104, 111, 121),
		Color3.fromRGB(62, 91, 111),
		Color3.fromRGB(119, 126, 132),
	}
	for column = 1, 9 do
		for row = 1, 11 do
			local x = -8220 + (column - 1) * 560
			local z = -3500 + (row - 1) * 700
			local centerFactor = 1 - math.clamp(Vector2.new((x + 5980) / 2700, z / 4000).Magnitude, 0, 1)
			local height = 105 + centerFactor * 320 + random:NextNumber(-18, 72)
			if (column + row * 2) % 11 == 0 then height += 115 end
			local width = random:NextNumber(205, 310)
			local depth = random:NextNumber(190, 300)
			local baseCF = airportCF * CFrame.new(x, 0, z) * CFrame.Angles(0, math.rad(random:NextInteger(-4, 4)), 0)
			local facade = facadeColors[(column + row - 2) % #facadeColors + 1]

			makePart(city, "TowerPodium" .. column .. "_" .. row, Vector3.new(width + 54, 18, depth + 54), baseCF * CFrame.new(0, 8.6, 0), sidewalkColor, Enum.Material.Concrete)
			local tower = makePart(city, "SkylineTower" .. column .. "_" .. row, Vector3.new(width, height, depth), baseCF * CFrame.new(0, 18 + height / 2, 0), facade, Enum.Material.Metal)
			tower:SetAttribute("SkylineHighRise", true)
			local glassColor = Color3.fromRGB(45, 113, 151)
			makePart(city, "TowerGlassFront" .. column .. "_" .. row, Vector3.new(width * 0.86, height * 0.88, 1.2), tower.CFrame * CFrame.new(0, 0, -depth / 2 - 0.65), glassColor, Enum.Material.Glass, 0.16, false)
			makePart(city, "TowerGlassBack" .. column .. "_" .. row, Vector3.new(width * 0.86, height * 0.88, 1.2), tower.CFrame * CFrame.new(0, 0, depth / 2 + 0.65), glassColor, Enum.Material.Glass, 0.16, false)
			makePart(city, "TowerGlassLeft" .. column .. "_" .. row, Vector3.new(1.2, height * 0.88, depth * 0.82), tower.CFrame * CFrame.new(-width / 2 - 0.65, 0, 0), glassColor, Enum.Material.Glass, 0.16, false)
			makePart(city, "TowerGlassRight" .. column .. "_" .. row, Vector3.new(1.2, height * 0.88, depth * 0.82), tower.CFrame * CFrame.new(width / 2 + 0.65, 0, 0), glassColor, Enum.Material.Glass, 0.16, false)
			makePart(city, "TowerRoof" .. column .. "_" .. row, Vector3.new(width * 0.78, 8, depth * 0.78), tower.CFrame * CFrame.new(0, height / 2 + 4, 0), Color3.fromRGB(62, 68, 72), Enum.Material.Metal)

			if height > 430 then
				local mast = makePart(city, "TowerBeaconMast" .. column .. "_" .. row, Vector3.new(3, 68, 3), tower.CFrame * CFrame.new(0, height / 2 + 38, 0), Color3.fromRGB(178, 186, 190), Enum.Material.Metal)
				local beacon = makePart(city, "TowerBeacon" .. column .. "_" .. row, Vector3.new(6, 6, 6), mast.CFrame * CFrame.new(0, 37, 0), Color3.fromRGB(255, 65, 74), Enum.Material.Neon, 0, false)
				beacon.Shape = Enum.PartType.Ball
			end
		end
	end
end

function AirportInteriors.Build(parent, airportCF, airport, makePart)
	local details = Instance.new("Model")
	details.Name = "V31 Airport Facilities"
	details.Parent = parent
	buildApronTiles(details, makePart, airportCF, airport)
	local terminal = makeTerminalShell(details, makePart, airportCF, airport)
	furnishTerminal(terminal, makePart, airportCF, airport)
	buildRoadsAndParking(details, makePart, airportCF, airport)
	buildSkylineDistrict(details, makePart, airportCF, airport)
	return details
end

return AirportInteriors
]]></ProtectedString><bool name="Disabled">false</bool></Properties>
  
</Item>
<Item class="ModuleScript" referent="RBX18">
  <Properties><string name="Name">AirportTerrain</string><ProtectedString name="Source"><![CDATA[--!strict

-- Low-profile island terrain shared by the live server and Studio builder.
-- Every complete hill footprint must remain outside the protected runway path,
-- airport facilities, and shoreline margin before it can be created.

local Layout = require(script.Parent:WaitForChild("AirportLayout"))

local AirportTerrain = {}

local terrainStyles = {
	Green = { MinHeight = 14, MaxHeight = 30, Color = Color3.fromRGB(67, 132, 82), Material = Enum.Material.Grass },
	Tropical = { MinHeight = 16, MaxHeight = 32, Color = Color3.fromRGB(67, 151, 90), Material = Enum.Material.Grass },
	Alpine = { MinHeight = 22, MaxHeight = 46, Color = Color3.fromRGB(96, 126, 108), Material = Enum.Material.Slate },
	Desert = { MinHeight = 18, MaxHeight = 34, Color = Color3.fromRGB(170, 112, 66), Material = Enum.Material.Sandstone },
	Urban = { MinHeight = 14, MaxHeight = 26, Color = Color3.fromRGB(76, 125, 85), Material = Enum.Material.Grass },
}

local function overlapsFacility(airport, localX, localZ, halfX, halfZ)
	local facilityStart = Layout.SceneryNegativeClearX - Layout.TerrainFacilityMargin
	local facilityEnd = Layout.FacilityEndX(airport) + Layout.TerrainFacilityMargin
	local facilityHalfZ = math.max(math.abs(Layout.FacilityZMin), math.abs(Layout.FacilityZMax)) + Layout.TerrainFacilityMargin
	return localX + halfX > facilityStart
		and localX - halfX < facilityEnd
		and math.abs(localZ) - halfZ < facilityHalfZ
end

local function clearsRunwayPath(airport, localX, localZ, halfX, halfZ)
	-- Protect every parallel or crossing runway and its extended approach path.
	-- A radial footprint bound is intentionally conservative for rotated hills.
	local footprintRadius = math.sqrt(halfX * halfX + halfZ * halfZ)
	local center = Vector3.new(localX, 0, localZ)
	for _, placement in ipairs(Layout.RunwayPlacements(airport)) do
		local runwayPosition = Layout.RunwayLocalCFrame(placement):PointToObjectSpace(center)
		if math.abs(runwayPosition.X) - footprintRadius < Layout.TerrainRunwayCorridorHalfWidth then
			return false
		end
	end
	return true
end

function AirportTerrain.Build(parent, airportCF, airport, makePart)
	if airport.SkipTerrain then
		return nil
	end

	local existing = parent:FindFirstChild("V31 Low Terrain")
	if existing then return existing end

	local folder = Instance.new("Folder")
	folder.Name = "V31 Low Terrain"
	folder:SetAttribute("MaximumHeight", Layout.TerrainMaximumHeight)
	folder:SetAttribute("RunwayCorridorHalfWidth", Layout.TerrainRunwayCorridorHalfWidth)
	folder:SetAttribute("ApproachPathProtected", true)
	folder.Parent = parent

	local style = terrainStyles[airport.Terrain] or terrainStyles.Green
	local seed = string.byte(airport.Code, 1) * 10000
		+ string.byte(airport.Code, 2) * 100
		+ string.byte(airport.Code, 3)
	local random = Random.new(seed + 2200)
	local desiredCount = airport.Terrain == "Urban" and 9 or 12
	local created = 0
	local attempts = 0

	while created < desiredCount and attempts < desiredCount * 60 do
		attempts += 1
		local width = random:NextNumber(620, 1280)
		local depth = random:NextNumber(540, 1120)
		local height = math.min(Layout.TerrainMaximumHeight, random:NextNumber(style.MinHeight, style.MaxHeight))
		local halfX = width * 0.5
		local halfZ = depth * 0.5
		local localX = random:NextNumber(-airport.IslandRadius * 0.60, airport.IslandRadius * 0.60)
		local localZ = random:NextNumber(-airport.IslandRadius * 0.60, airport.IslandRadius * 0.60)
		local footprintPadding = math.sqrt(halfX * halfX + halfZ * halfZ) + Layout.SceneryShoreMargin
		local safelyInland = Layout.IsInsideIsland(airport, localX, localZ, footprintPadding)
		if safelyInland
			and clearsRunwayPath(airport, localX, localZ, halfX, halfZ)
			and not overlapsFacility(airport, localX, localZ, halfX, halfZ) then
			created += 1
			local yaw = math.rad(random:NextNumber(-28, 28))
			local colorVariation = random:NextNumber(-0.06, 0.06)
			local colorTarget = colorVariation >= 0 and Color3.new(1, 1, 1) or Color3.new(0, 0, 0)
			local color = style.Color:Lerp(colorTarget, math.abs(colorVariation))
			local hill = makePart(
				folder,
				"RollingHill" .. created,
				Vector3.new(width, height, depth),
				airportCF * CFrame.new(localX, height * 0.32 - 2, localZ) * CFrame.Angles(0, yaw, 0),
				color,
				style.Material,
				0,
				true
			)
			hill.Shape = Enum.PartType.Ball
			hill.CanTouch = false
			hill.CanQuery = true
			hill:SetAttribute("TerrainHeight", height)
			hill:SetAttribute("RunwayLateralClearance", math.abs(localX) - halfX)
		end
	end

	folder:SetAttribute("GeneratedHillCount", created)
	return folder
end

return AirportTerrain
]]></ProtectedString><bool name="Disabled">false</bool></Properties>
  
</Item>
<Item class="ModuleScript" referent="RBX19">
  <Properties><string name="Name">StudioWorldBuilder</string><ProtectedString name="Source"><![CDATA[--!nocheck

-- Around the World: edit-mode map builder.
-- From Roblox Studio's Command Bar (while NOT playing), run:
-- require(game.ReplicatedStorage.SkyDeck.StudioWorldBuilder).Build()

local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local AirportCatalog = require(script.Parent:WaitForChild("AirportCatalog"))
local AirportInteriors = require(script.Parent:WaitForChild("AirportInteriors"))
local Layout = require(script.Parent:WaitForChild("AirportLayout"))
local AirportSurfaces = require(script.Parent:WaitForChild("AirportSurfaces"))
local AirportTerrain = require(script.Parent:WaitForChild("AirportTerrain"))

local Builder = {}

local MAX_PART_AXIS = 2000

local function makePart(parent, name, size, cframe, color, material, transparency, canCollide)
	-- Roblox clamps oversized BaseParts. Split long runways, aprons, terminals,
	-- roads, and ground reserves into perfectly adjoining local-space tiles.
	local xCount = math.max(1, math.ceil(size.X / MAX_PART_AXIS))
	local yCount = math.max(1, math.ceil(size.Y / MAX_PART_AXIS))
	local zCount = math.max(1, math.ceil(size.Z / MAX_PART_AXIS))
	local tileSize = Vector3.new(size.X / xCount, size.Y / yCount, size.Z / zCount)
	local firstPart = nil
	for xIndex = 1, xCount do
		for yIndex = 1, yCount do
			for zIndex = 1, zCount do
				local offset = Vector3.new(
					(xIndex - (xCount + 1) / 2) * tileSize.X,
					(yIndex - (yCount + 1) / 2) * tileSize.Y,
					(zIndex - (zCount + 1) / 2) * tileSize.Z
				)
				local part = Instance.new("Part")
				part.Name = name
				part.Size = tileSize
				part.CFrame = cframe * CFrame.new(offset)
				part.Color = color
				part.Material = material or Enum.Material.SmoothPlastic
				part.Transparency = transparency or 0
				part.Anchored = true
				part.CanCollide = canCollide ~= false
				part.CastShadow = transparency ~= 1
				part.TopSurface = Enum.SurfaceType.Smooth
				part.BottomSurface = Enum.SurfaceType.Smooth
				part.Parent = parent
				firstPart = firstPart or part
			end
		end
	end
	return firstPart
end

local function addBillboard(parent, text, accent, offset)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "WorldLabel"
	billboard.Size = UDim2.fromOffset(190, 40)
	billboard.StudsOffsetWorldSpace = offset or Vector3.new(0, 70, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 1400
	billboard.Parent = parent

	local background = Instance.new("Frame")
	background.Size = UDim2.fromScale(1, 1)
	background.BackgroundColor3 = Color3.fromRGB(8, 20, 31)
	background.BackgroundTransparency = 0.32
	background.BorderSizePixel = 0
	background.Parent = billboard

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = background

	local stroke = Instance.new("UIStroke")
	stroke.Color = accent
	stroke.Thickness = 1
	stroke.Transparency = 0.12
	stroke.Parent = background

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -14, 1, 0)
	label.Position = UDim2.fromOffset(7, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.Text = text
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextSize = 12
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = background
end

local function terrainColor(kind)
	if kind == "Desert" then return Color3.fromRGB(183, 128, 72) end
	if kind == "Alpine" then return Color3.fromRGB(94, 133, 107) end
	if kind == "Tropical" then return Color3.fromRGB(72, 159, 96) end
	if kind == "Urban" then return Color3.fromRGB(82, 132, 91) end
	return Color3.fromRGB(71, 140, 86)
end

local function makeWedge(parent, name, size, cframe, color, material, transparency, canCollide)
	local part = Instance.new("WedgePart")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Transparency = transparency or 0
	part.Anchored = true
	part.CanCollide = canCollide ~= false
	part.CastShadow = transparency ~= 1
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function createConnectedOcean(parent)
	local existing = parent:FindFirstChild("ConnectedOcean")
	if existing then return existing end
	local ocean = Instance.new("Folder")
	ocean.Name = "ConnectedOcean"
	ocean.Parent = parent
	local tileSize = 2000
	for x = -Layout.OceanExtent, Layout.OceanExtent, tileSize do
		for z = -Layout.OceanExtent, Layout.OceanExtent, tileSize do
			local shade = ((x + z) / tileSize) % 2 == 0 and Color3.fromRGB(24, 119, 167) or Color3.fromRGB(27, 128, 176)
			local tile = makePart(ocean, "WaterTile", Vector3.new(tileSize, 2, tileSize), CFrame.new(x, -1, z), shade, Enum.Material.Glass, 0.18, false)
			tile.Reflectance = 0.12
			tile.CanTouch = false
			tile.CanQuery = false
			tile.CastShadow = false
		end
	end
	return ocean
end

local function createTree(parent, position, terrain, random, index)
	local tree = Instance.new("Model")
	tree.Name = terrain .. "Tree" .. index
	tree.Parent = parent
	local height = random:NextNumber(24, 43)
	local trunkColor = Color3.fromRGB(91, 66, 43)
	local green = terrain == "Alpine" and Color3.fromRGB(43, 91, 66) or Color3.fromRGB(55, 120, 65)
	local trunk = makePart(tree, "TaperedTrunk", Vector3.new(height, 2.7, 2.7), CFrame.new(position + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), trunkColor, Enum.Material.Wood)
	trunk.Shape = Enum.PartType.Cylinder

	if terrain == "Tropical" then
		for frond = 1, 8 do
			local angle = (frond - 1) * math.pi / 4 + random:NextNumber(-0.15, 0.15)
			local length = random:NextNumber(13, 19)
			local direction = Vector3.new(math.cos(angle), -0.22, math.sin(angle))
			local center = position + Vector3.new(0, height, 0) + direction * length * 0.42
			makePart(tree, "PalmFrond" .. frond, Vector3.new(1.15, 0.38, length), CFrame.lookAt(center, center + direction) * CFrame.Angles(0, 0, math.rad(random:NextNumber(-8, 8))), Color3.fromRGB(49, 132, 65), Enum.Material.Grass, 0, false)
		end
	elseif terrain == "Alpine" then
		for tier = 1, 4 do
			local tierY = height * (0.48 + tier * 0.12)
			local width = height * (0.46 - tier * 0.055)
			for side = 0, 3 do
				makeWedge(tree, "PineBranch" .. tier .. "_" .. side, Vector3.new(width, 4.2, width * 0.58), CFrame.new(position + Vector3.new(0, tierY, 0)) * CFrame.Angles(0, math.rad(side * 90), 0), green, Enum.Material.Grass, 0, false)
			end
		end
	else
		for cluster = 1, 7 do
			local angle = cluster * 2.399
			local distance = random:NextNumber(3.5, 8.5)
			local offset = Vector3.new(math.cos(angle) * distance, height * random:NextNumber(0.72, 1.02), math.sin(angle) * distance)
			makeWedge(tree, "LeafCluster" .. cluster, Vector3.new(random:NextNumber(7, 12), random:NextNumber(6, 10), random:NextNumber(8, 14)), CFrame.new(position + offset) * CFrame.Angles(random:NextNumber(-0.25, 0.25), angle, random:NextNumber(-0.25, 0.25)), green:Lerp(Color3.fromRGB(82, 145, 70), cluster / 12), Enum.Material.Grass, 0, false)
		end
	end
end

local function createTiledIsland(model, airport)
	local tileSize = 1200
	local maximumAspect = math.max(airport.IslandAspectX or 1, airport.IslandAspectZ or 1)
	local tileCount = math.ceil(airport.IslandRadius * maximumAspect * 1.18 / tileSize)
	local grassColor = terrainColor(airport.Terrain)
	local islandCF = CFrame.new(airport.Position) * CFrame.Angles(0, math.rad(-airport.Heading), 0)
	for xIndex = -tileCount, tileCount do
		for zIndex = -tileCount, tileCount do
			local localX = xIndex * tileSize
			local localZ = zIndex * tileSize
			if Layout.TileTouchesIsland(airport, localX, localZ, tileSize) then
				makePart(model, "IslandShore", Vector3.new(tileSize + 120, 8, tileSize + 120), islandCF * CFrame.new(localX, -2.2, localZ), Color3.fromRGB(211, 187, 128), Enum.Material.Sand)
				makePart(model, "Island", Vector3.new(tileSize + 4, 42, tileSize + 4), islandCF * CFrame.new(localX, -19, localZ), grassColor, Enum.Material.Grass)
			end
		end
	end
end

local function clearOfChildAirports(parentAirport, worldPosition, margin)
	for _, childAirport in ipairs(AirportCatalog.List) do
		if childAirport.ParentIslandCode == parentAirport.Code then
			local childCF = CFrame.new(childAirport.Position) * CFrame.Angles(0, math.rad(-childAirport.Heading), 0)
			local localPosition = childCF:PointToObjectSpace(worldPosition)
			local startX, endX, halfZ = Layout.GroundReserveBounds(childAirport)
			if localPosition.X > startX - margin and localPosition.X < endX + margin and math.abs(localPosition.Z) < halfZ + margin then
				return false
			end
		end
	end
	return true
end

local function createAirport(airportsFolder, airport)
	local model = Instance.new("Model")
	model.Name = airport.Code .. " - " .. airport.Name
	model:SetAttribute("Code", airport.Code)
	model:SetAttribute("Heading", airport.Heading)
	model:SetAttribute("RunwayLength", airport.RunwayLength)
	model:SetAttribute("RunwayCount", airport.RunwayCount or 1)
	model:SetAttribute("RunwayLayout", airport.RunwayLayout or "PARALLEL_STAGGERED")
	model:SetAttribute("Gates", airport.Gates or 0)
	model.Parent = airportsFolder

	if not airport.ParentIslandCode then
		createTiledIsland(model, airport)
	end

	local airportCF = CFrame.new(airport.Position + Vector3.new(0, 2.4, 0)) * CFrame.Angles(0, math.rad(-airport.Heading), 0)
	local groundStartX, groundEndX, groundHalfZ = Layout.GroundReserveBounds(airport)
	local groundCenterX = (groundStartX + groundEndX) / 2
	makePart(model, "AirportLandReserve", Vector3.new(groundEndX - groundStartX, 1.10, groundHalfZ * 2), airportCF * CFrame.new(groundCenterX, -0.93, 0), terrainColor(airport.Terrain), Enum.Material.Grass)
	AirportSurfaces.Build(model, airportCF, airport, makePart)
	AirportInteriors.Build(model, airportCF, airport, makePart)
	AirportTerrain.Build(model, airportCF, airport, makePart)

	local terminalStartX = Layout.TerminalBounds(airport)
	local tower = makePart(model, "Tower", Vector3.new(13, 73, 13), airportCF * CFrame.new(terminalStartX + 80, 36, 700), Color3.fromRGB(220, 225, 223), Enum.Material.Concrete)
	local cab = makePart(model, "TowerCab", Vector3.new(35, 15, 35), tower.CFrame * CFrame.new(0, 42, 0), Color3.fromRGB(28, 69, 88), Enum.Material.Glass, 0.05, false)
	cab.Shape = Enum.PartType.Ball

	local random = Random.new(string.byte(airport.Code, 1) * 100 + string.byte(airport.Code, 2))
	local buildingColors = {
		Color3.fromRGB(215, 201, 179),
		Color3.fromRGB(199, 213, 221),
		Color3.fromRGB(211, 216, 199),
		Color3.fromRGB(188, 199, 196),
	}
	for index = 1, (airport.BuildingCount or 46) do
		local position
		local angle = 0
		for _ = 1, 30 do
			angle = random:NextNumber(0, math.pi * 2)
			local inlandLimit = math.min(airport.IslandRadius * 0.60, airport.IslandRadius - Layout.SceneryShoreMargin)
			local distance = random:NextNumber(math.min(850, inlandLimit * 0.55), inlandLimit)
			local candidate = airport.Position + Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)
			local runwayLocal = airportCF:PointToObjectSpace(candidate)
			local facilityEndX = Layout.FacilityEndX(airport)
			local clearOfMovement = not Layout.IsMovementZone(airport, runwayLocal.X, runwayLocal.Z, 180)
			local clearOfAirport = not (runwayLocal.X > Layout.SceneryPositiveClearX and runwayLocal.X < facilityEndX and runwayLocal.Z > Layout.FacilityZMin and runwayLocal.Z < Layout.FacilityZMax)
			local safelyInland = Layout.IsInsideIsland(airport, runwayLocal.X, runwayLocal.Z, Layout.SceneryShoreMargin + 80)
			if safelyInland and clearOfMovement and clearOfAirport and clearOfChildAirports(airport, candidate, 180) then
				position = candidate
				break
			end
		end
		if not position then
			local fallbackZ = ((index - 1) % 9 - 4) * 80
			local fallback = airportCF:PointToWorldSpace(Vector3.new(-airport.IslandRadius * 0.52, 0, fallbackZ))
			if clearOfChildAirports(airport, fallback, 180) then position = fallback end
		end
		if not position then continue end
		local width = random:NextNumber(28, 64)
		local height = random:NextNumber(18, 105)
		local raisedPosition = Vector3.new(position.X, height / 2, position.Z)
		local buildingCF = CFrame.new(raisedPosition) * CFrame.Angles(0, angle, 0)
		local building = makePart(model, "CityBuilding", Vector3.new(width, height, width), buildingCF, buildingColors[(index - 1) % #buildingColors + 1], Enum.Material.Concrete)
		for band = -1, 1, 2 do
			local windowY = band * height * 0.20
			makePart(model, "BuildingWindows", Vector3.new(width * 0.72, math.max(2.5, height * 0.15), 0.35), building.CFrame * CFrame.new(0, windowY, -width / 2 - 0.19), Color3.fromRGB(48, 101, 127), Enum.Material.Glass, 0.12, false)
			makePart(model, "BuildingWindows", Vector3.new(0.35, math.max(2.5, height * 0.15), width * 0.72), building.CFrame * CFrame.new(width / 2 + 0.19, windowY, 0), Color3.fromRGB(48, 101, 127), Enum.Material.Glass, 0.12, false)
		end
	end

	local vegetation = Instance.new("Folder")
	vegetation.Name = "Vegetation"
	vegetation.Parent = model
	local treeCount = airport.TreeCount or (airport.Terrain == "Desert" and 4 or 18)
	for treeIndex = 1, treeCount do
		local treePosition
		for _ = 1, 35 do
			local treeAngle = random:NextNumber(0, math.pi * 2)
			local inlandLimit = math.min(airport.IslandRadius * 0.62, airport.IslandRadius - Layout.SceneryShoreMargin)
			local treeDistance = random:NextNumber(math.min(900, inlandLimit * 0.55), inlandLimit)
			local candidate = airport.Position + Vector3.new(math.cos(treeAngle) * treeDistance, 1.5, math.sin(treeAngle) * treeDistance)
			local runwayLocal = airportCF:PointToObjectSpace(candidate)
			local facilityEndX = Layout.FacilityEndX(airport)
			local clearOfMovement = not Layout.IsMovementZone(airport, runwayLocal.X, runwayLocal.Z, 180)
			local clearOfApron = not (runwayLocal.X > Layout.SceneryPositiveClearX and runwayLocal.X < facilityEndX and runwayLocal.Z > Layout.FacilityZMin and runwayLocal.Z < Layout.FacilityZMax)
			local safelyInland = Layout.IsInsideIsland(airport, runwayLocal.X, runwayLocal.Z, Layout.SceneryShoreMargin + 90)
			if safelyInland and clearOfMovement and clearOfApron and clearOfChildAirports(airport, candidate, 120) then
				treePosition = candidate
				break
			end
		end
		if treePosition then
			createTree(vegetation, treePosition, airport.Terrain == "Desert" and "Tropical" or airport.Terrain, random, treeIndex)
		end
	end

	if airport.Terrain == "Alpine" then
		for index = 1, 8 do
			local height = 30 + index * 2
			local scenicPosition = airportCF:PointToWorldSpace(Vector3.new(-airport.IslandRadius * 0.48, height * 0.30, -620 + index * 150))
			local mountain = makePart(model, "LowAlpineRidge", Vector3.new(210 + index * 15, height, 190 + index * 12), CFrame.new(scenicPosition), Color3.fromRGB(105, 127, 116), Enum.Material.Slate)
			mountain.Shape = Enum.PartType.Ball
			mountain.CanTouch = false
		end
	elseif airport.Terrain == "Desert" then
		for index = 1, 7 do
			local height = 20 + index * 2
			local scenicPosition = airportCF:PointToWorldSpace(Vector3.new(-airport.IslandRadius * 0.50, height * 0.30, -560 + index * 160))
			local mesa = makePart(model, "LowDesertMesa", Vector3.new(180 + index * 14, height, 160 + index * 12), CFrame.new(scenicPosition), Color3.fromRGB(150, 88, 54), Enum.Material.Sandstone)
			mesa.Shape = Enum.PartType.Ball
			mesa.CanTouch = false
		end
	end

	local marker = makePart(model, "AirportMarker", Vector3.new(4, 4, 4), CFrame.new(airport.Position), airport.Accent, Enum.Material.Neon, 1, false)
	addBillboard(marker, airport.Code .. "  •  " .. airport.Name, airport.Accent, Vector3.new(0, 115, 0))

	local spawn = makePart(model, "AircraftSpawn", Vector3.new(6, 1, 6), airportCF * CFrame.new(Layout.FirstGateX, 5, 25) * CFrame.Angles(0, math.rad(180), 0), airport.Accent, Enum.Material.Neon, 1, false)
	spawn:SetAttribute("AirportCode", airport.Code)
end

function Builder.Build(rebuild)
	if RunService:IsRunning() then
		error("Stop Play/Test mode before building the editable world.")
	end

	local existing = workspace:FindFirstChild("SkyDeckWorld")
	if existing
		and not rebuild
		and existing:GetAttribute("EditableWorldVersion") == Layout.WorldVersion
		and existing:GetAttribute("GeometryRevision") == Layout.GeometryRevision then
		warn("Around the World already exists in Edit mode. Existing edits were preserved.")
		return existing
	end
	if existing and not rebuild then
		local backups = ServerStorage:FindFirstChild("AroundTheWorldBackups") or Instance.new("Folder")
		backups.Name = "AroundTheWorldBackups"
		backups.Parent = ServerStorage
		existing.Name = "SkyDeckWorld_PreV31_" .. tostring(os.time())
		existing.Parent = backups
		warn("The older editable map was backed up in ServerStorage/AroundTheWorldBackups before V31 was built.")
	elseif existing then
		existing:Destroy()
	end

	local world = Instance.new("Folder")
	world.Name = "SkyDeckWorld"
	world:SetAttribute("EditorBuilt", true)
	world:SetAttribute("EditableWorldVersion", Layout.WorldVersion)
	world:SetAttribute("WorldVersion", Layout.WorldVersion)
	world:SetAttribute("GeometryRevision", Layout.GeometryRevision)
	world:SetAttribute("RunwayLayoutRevision", Layout.RunwayLayoutRevision)
	world:SetAttribute("TerminalShapeRevision", Layout.TerminalShapeRevision)
	world:SetAttribute("Humidity", 0.76)
	world:SetAttribute("RainIntensity", 0.12)
	world:SetAttribute("WeatherWetness", 0.42)
	world.Parent = workspace

	local airportsFolder = Instance.new("Folder")
	airportsFolder.Name = "Airports"
	airportsFolder.Parent = world

	local planesFolder = Instance.new("Folder")
	planesFolder.Name = "Aircraft"
	planesFolder.Parent = world

	local trafficFolder = Instance.new("Folder")
	trafficFolder.Name = "AI Traffic"
	trafficFolder.Parent = world

	Lighting.Brightness = 2.3
	Lighting.ClockTime = 13.5
	Lighting.GlobalShadows = true
	Lighting.Ambient = Color3.fromRGB(95, 116, 128)
	Lighting.OutdoorAmbient = Color3.fromRGB(128, 146, 151)

	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Density = 0.28
	atmosphere.Offset = 0.15
	atmosphere.Color = Color3.fromRGB(199, 229, 240)
	atmosphere.Decay = Color3.fromRGB(106, 144, 168)
	atmosphere.Glare = 0.2
	atmosphere.Haze = 1.3
	atmosphere.Parent = Lighting

	createConnectedOcean(world)

	local lobbySpawn = Instance.new("SpawnLocation")
	lobbySpawn.Name = "SafeIslandSpawn"
	lobbySpawn.Size = Vector3.new(16, 1, 16)
	lobbySpawn.CFrame = CFrame.new(AirportCatalog.List[1].Position + Vector3.new(Layout.TerminalStartX + 80, 4, 500))
	lobbySpawn.Anchored = true
	lobbySpawn.CanCollide = true
	lobbySpawn.Transparency = 1
	lobbySpawn.Neutral = true
	lobbySpawn.Duration = 0
	lobbySpawn.Parent = world

	for _, airport in ipairs(AirportCatalog.List) do
		createAirport(airportsFolder, airport)
	end

	local clouds = Instance.new("Folder")
	clouds.Name = "Clouds"
	clouds.Parent = world
	local randomCloud = Random.new(8342)
	for cloudIndex = 1, 38 do
		local group = Instance.new("Model")
		group.Name = "LayeredCloud" .. cloudIndex
		group.Parent = clouds
		local basePosition = Vector3.new(randomCloud:NextNumber(-Layout.CloudExtent, Layout.CloudExtent), randomCloud:NextNumber(450, 1100), randomCloud:NextNumber(-Layout.CloudExtent, Layout.CloudExtent))
		local cloudScale = randomCloud:NextNumber(0.8, 1.45)
		for layer = 1, 9 do
			local angle = randomCloud:NextNumber(-0.35, 0.35)
			local offset = Vector3.new((layer - 5) * randomCloud:NextNumber(28, 43), randomCloud:NextNumber(-7, 26), randomCloud:NextNumber(-48, 48))
			local size = Vector3.new(randomCloud:NextNumber(85, 155), randomCloud:NextNumber(16, 34), randomCloud:NextNumber(65, 125)) * cloudScale
			local color = layer <= 3 and Color3.fromRGB(210, 219, 225) or Color3.fromRGB(244, 248, 250)
			local piece = makeWedge(group, "CloudLayer" .. layer, size, CFrame.new(basePosition + offset) * CFrame.Angles(0, angle, layer % 2 == 0 and math.rad(3) or math.rad(-3)), color, Enum.Material.SmoothPlastic, layer <= 3 and 0.25 or 0.16, false)
			piece.CanTouch = false
			piece.CanQuery = false
			piece.CastShadow = false
		end
	end

	print("[Around the World] V31 editable map created. Save the place before testing.")
	return world
end

return Builder
]]></ProtectedString><bool name="Disabled">false</bool></Properties>
  
