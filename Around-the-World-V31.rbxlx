	B788 = { Name = "Boeing 787-8", LengthStuds = 202.57, SpanStuds = 214.71, HeightStuds = 60.43, Engines = 2, Wheels = 10, Nose = "B787", MainTire = { DiameterStuds = 4.54, WidthStuds = 1.81, Marking = "50x20.0R22" }, NoseTire = { DiameterStuds = 3.63, WidthStuds = 1.45, Marking = "40x16.0R16" }, TireStatus = "VERIFIED_APPLICATION_CHART" },
	B789 = { Name = "Boeing 787-9", LengthStuds = 224.32, SpanStuds = 214.71, HeightStuds = 60.79, Engines = 2, Wheels = 10, Nose = "B787", MainTire = { DiameterStuds = 4.90, WidthStuds = 1.91, Marking = "54x21.0R23" }, NoseTire = { DiameterStuds = 3.63, WidthStuds = 1.45, Marking = "40x16.0R16" }, TireStatus = "VERIFIED_APPLICATION_CHART" },
	E290 = { Name = "Embraer E190-E2", LengthStuds = 129.43, SpanStuds = 120.43, HeightStuds = 38.29, Engines = 2, Wheels = 6, Nose = "E2", MainTire = { DiameterStuds = 3.72, WidthStuds = 1.45, Marking = "H41x16.0R20" }, NoseTire = { DiameterStuds = 2.18, WidthStuds = 0.70, Marking = "24x7.7R10" }, TireStatus = "FAMILY_REFERENCE_VERIFY_E2_AMM" },
	E295 = { Name = "Embraer E195-E2", LengthStuds = 148.21, SpanStuds = 125.43, HeightStuds = 38.93, Engines = 2, Wheels = 6, Nose = "E2", MainTire = { DiameterStuds = 3.72, WidthStuds = 1.45, Marking = "H41x16.0R20" }, NoseTire = { DiameterStuds = 2.18, WidthStuds = 0.70, Marking = "24x7.7R10" }, TireStatus = "FAMILY_REFERENCE_VERIFY_E2_AMM" },
	CRJ9 = { Name = "Bombardier CRJ-900", LengthStuds = 129.29, SpanStuds = 88.93, HeightStuds = 26.79, Engines = 2, Wheels = 6, Nose = "CRJ", MainTire = { DiameterStuds = 3.27, WidthStuds = 1.09, Marking = "H36x12.0-18" }, NoseTire = { DiameterStuds = 1.86, WidthStuds = 0.61, Marking = "20.5x6.75-10" }, TireStatus = "VERIFIED_APPLICATION_CHART" },
}

local Manifest = {
	Version = 27,
	StudsPerMetre = 1 / 0.28,
	Variants = variants,
	RequiredAttachments = {
		"ATT_Root", "ATT_CameraCockpit", "ATT_CameraBelly", "ATT_Nav_L", "ATT_Nav_R",
		"ATT_StrobeTail", "ATT_BeaconTop", "ATT_BeaconBottom", "ATT_Landing_L",
		"ATT_Landing_R", "ATT_GearContact_Nose", "ATT_GearContact_Main_L", "ATT_GearContact_Main_R",
	},
}

local function add(list, value)
	table.insert(list, value)
end

function Manifest.GetRequiredObjectNames(code: string): { string }
	local variant = variants[code]
	if not variant then return {} end
	local prefix = "ATW_" .. code .. "_"
	local control = "CTRL_" .. code .. "_"
	local gear = "GEAR_" .. code .. "_"
	local names = {
		prefix .. "Fuselage", prefix .. "Nose", prefix .. "TailCone", prefix .. "Wing_L", prefix .. "Wing_R",
		prefix .. "Fin", prefix .. "HStab_L", prefix .. "HStab_R", prefix .. "CockpitGlass", prefix .. "CabinGlass",
		control .. "Aileron_L", control .. "Aileron_R", control .. "Elevator_L", control .. "Elevator_R",
		control .. "Rudder", control .. "Flap_L_01", control .. "Flap_R_01", control .. "Slat_L_01",
		control .. "Slat_R_01", control .. "Spoiler_L_01", control .. "Spoiler_R_01",
		gear .. "NoseStrut", gear .. "MainStrut_L", gear .. "MainStrut_R",
	}
	for engineIndex = 1, variant.Engines do
		local suffix = string.format("%02d", engineIndex)
		add(names, prefix .. "Nacelle_" .. suffix)
		add(names, prefix .. "Pylon_" .. suffix)
		add(names, control .. "Fan_" .. suffix)
	end
	for wheelIndex = 1, variant.Wheels do
		add(names, gear .. string.format("Wheel_%02d", wheelIndex))
	end
	return names
end

function Manifest.GetMovingObjectNames(code: string): { string }
	local variant = variants[code]
	if not variant then return {} end
	local names = {}
	for _, name in ipairs(Manifest.GetRequiredObjectNames(code)) do
		if string.sub(name, 1, 5) == "CTRL_" or string.sub(name, 1, 5) == "GEAR_" then
			add(names, name)
		end
	end
	return names
end

return Manifest
]]></ProtectedString><bool name="Disabled">false</bool></Properties>
  
</Item>
<Item class="ModuleScript" referent="RBX3">
  <Properties><string name="Name">AircraftMeshValidator</string><ProtectedString name="Source"><![CDATA[--!strict

-- Non-running technical-art validator. Call Validate() manually on a newly
-- imported staging Model; this module never changes the supplied instance.

local Manifest = require(script.Parent:WaitForChild("AircraftMeshManifest"))

local Validator = {}

local function pathOf(instance: Instance): string
	local pieces = { instance.Name }
	local cursor = instance.Parent
	while cursor and cursor ~= game do
		table.insert(pieces, 1, cursor.Name)
		cursor = cursor.Parent
	end
	return table.concat(pieces, ".")
end

local function push(list, code, message, instance)
	table.insert(list, {
		Code = code,
		Message = message,
		Path = instance and pathOf(instance) or nil,
	})
end

local function findRecursive(model: Model, name: string): Instance?
	return model:FindFirstChild(name, true)
end

local function closeEnough(actual: number, expected: number, tolerance: number): boolean
	return math.abs(actual - expected) <= expected * tolerance
end

function Validator.CaptureBoundingBox(model: Model)
	local cframe, size = model:GetBoundingBox()
	return {
		CFrame = cframe,
		Size = size,
		SpanStuds = size.X,
		HeightStuds = size.Y,
		LengthStuds = size.Z,
	}
end

function Validator.Validate(model: Model, aircraftCode: string?)
	local errors = {}
	local warnings = {}
	local info = {}
	if not model or not model:IsA("Model") then
		push(errors, "NOT_MODEL", "Target must be a Model.", model)
		return { Passed = false, Errors = errors, Warnings = warnings, Info = info }
	end

	local code = aircraftCode or model:GetAttribute("AircraftCode")
	local variant = code and Manifest.Variants[code]
	if not variant then
		push(errors, "UNKNOWN_VARIANT", "Set AircraftCode to a V27 manifest code before validation.", model)
		return { Passed = false, Errors = errors, Warnings = warnings, Info = info }
	end

	if not model.PrimaryPart then
		push(errors, "MISSING_PRIMARY_PART", "PrimaryPart must be the preserved Root physics Part.", model)
	elseif model.PrimaryPart.Name ~= "Root" then
		push(errors, "WRONG_PRIMARY_PART", "PrimaryPart exists but is not named Root.", model.PrimaryPart)
	end

	for _, requiredName in ipairs(Manifest.GetRequiredObjectNames(code)) do
		if not findRecursive(model, requiredName) then
			push(errors, "MISSING_OBJECT", "Missing required object " .. requiredName .. ".", model)
		end
	end

	for _, attachmentName in ipairs(Manifest.RequiredAttachments) do
		local attachment = findRecursive(model, attachmentName)
		if not attachment or not attachment:IsA("Attachment") then
			push(errors, "MISSING_ATTACHMENT", "Missing required Attachment " .. attachmentName .. ".", model)
		end
	end
	for engineIndex = 1, variant.Engines do
		local attachmentName = string.format("ATT_Engine_%02d", engineIndex)
		local attachment = findRecursive(model, attachmentName)
		if not attachment or not attachment:IsA("Attachment") then
			push(errors, "MISSING_ATTACHMENT", "Missing required Attachment " .. attachmentName .. ".", model)
		end
	end

	local movingNames = {}
	for _, name in ipairs(Manifest.GetMovingObjectNames(code)) do movingNames[name] = true end
	local wheelCount = 0
	for _, item in ipairs(model:GetDescendants()) do
		if item:IsA("BasePart") then
			local isRoot = item == model.PrimaryPart
			local isPhysics = item:GetAttribute("PhysicsPart") == true or item:GetAttribute("CollisionProxy") == true
			if item:IsA("MeshPart") and not isPhysics then
				if item.Anchored then push(errors, "ANCHORED_VISUAL", "Imported visual MeshPart must not be anchored.", item) end
				if item.CanCollide then push(errors, "VISUAL_COLLISION", "Cosmetic MeshPart must be non-collidable.", item) end
				if not item.Massless then push(errors, "VISUAL_MASS", "Cosmetic MeshPart must be Massless.", item) end
			end
			if item.Anchored and not isRoot and not isPhysics then
				push(errors, "ACCIDENTAL_ANCHOR", "Only Root or an explicitly tagged physics proxy may be anchored in staging.", item)
			end
			if movingNames[item.Name] then
				local pivot = item:FindFirstChild("PIVOT")
				if not pivot or not pivot:IsA("Attachment") then
					push(errors, "MISSING_PIVOT", "Moving object requires a child Attachment named PIVOT.", item)
				end
			end
			if string.match(item.Name, "^GEAR_" .. code .. "_Wheel_%d%d$") then
				wheelCount += 1
				local tireType = item:GetAttribute("TirePosition")
				local tireTarget = tireType == "NOSE" and variant.NoseTire or variant.MainTire
				if tireTarget and item:IsA("MeshPart") then
					local diameter = math.max(item.Size.Y, item.Size.Z)
					local width = item.Size.X
					if not closeEnough(width, tireTarget.WidthStuds, 0.08) or not closeEnough(diameter, tireTarget.DiameterStuds, 0.08) then
						push(errors, "TIRE_SIZE", string.format("Expected %s near %.2f x %.2f studs (diameter x width).", tireTarget.Marking, tireTarget.DiameterStuds, tireTarget.WidthStuds), item)
					end
				end
			end
		end
	end
	if wheelCount ~= variant.Wheels then
		push(errors, "WHEEL_COUNT", string.format("Expected %d wheel meshes; found %d.", variant.Wheels, wheelCount), model)
	end
	if variant.TireStatus ~= "VERIFIED_APPLICATION_CHART" then
		push(warnings, "TIRE_DATA_REVIEW", "Exact tire dimensions require variant maintenance-data approval: " .. variant.TireStatus .. ".", model)
	end

	local box = Validator.CaptureBoundingBox(model)
	-- Gear position can increase overall height. Span and length are strict; height
	-- receives a wider tolerance and must be checked once in both gear states.
	if not closeEnough(box.SpanStuds, variant.SpanStuds, 0.015) then
		push(errors, "SPAN_SCALE", string.format("Bounding-box span %.2f does not match %.2f studs.", box.SpanStuds, variant.SpanStuds), model)
	end
	if not closeEnough(box.LengthStuds, variant.LengthStuds, 0.015) then
		push(errors, "LENGTH_SCALE", string.format("Bounding-box length %.2f does not match %.2f studs.", box.LengthStuds, variant.LengthStuds), model)
	end
	if not closeEnough(box.HeightStuds, variant.HeightStuds, 0.05) then
		push(warnings, "HEIGHT_SCALE", string.format("Bounding-box height %.2f differs from %.2f studs; verify the measured gear state.", box.HeightStuds, variant.HeightStuds), model)
	end

	push(info, "BOUNDING_BOX", string.format("Measured X/Y/Z: %.2f / %.2f / %.2f studs.", box.Size.X, box.Size.Y, box.Size.Z), model)
	push(info, "TRIANGLE_AUDIT", "Roblox Lua cannot read triangle counts; verify every object remains below 20,000 triangles in the 3D Importer.", model)
	return {
		Passed = #errors == 0,
		AircraftCode = code,
		Errors = errors,
		Warnings = warnings,
		Info = info,
		BoundingBox = box,
	}
end

function Validator.PrintReport(report)
	local function emit(label, items)
		for _, item in ipairs(items) do
			print(string.format("[%s:%s] %s%s", label, item.Code, item.Message, item.Path and (" @ " .. item.Path) or ""))
		end
	end
	emit("ERROR", report.Errors)
	emit("WARNING", report.Warnings)
	emit("INFO", report.Info)
	print(report.Passed and "AircraftMeshValidator: PASS" or "AircraftMeshValidator: FAIL")
end

return Validator
]]></ProtectedString><bool name="Disabled">false</bool></Properties>
  
</Item>
<Item class="ModuleScript" referent="RBX4">
  <Properties><string name="Name">AircraftAnimationConfig</string><ProtectedString name="Source"><![CDATA[--!strict

-- V31 aircraft-specific visual animation tuning. These values move presentation
-- geometry only; they are never read by the authoritative flight-physics code.

local AircraftAnimationConfig = {}

local base = {
	Angles = {
		Aileron = 17,
		Elevator = 16,
		Rudder = 24,
		Flaps = 22,
		Spoilers = 38,
		NoseSteer = 31,
		WingFlex = 2.8,
		WingtipFold = 72,
	},
	Rates = {
		Control = 9.0,
		Flaps = 1.7,
		Slats = 1.55,
		SpoilerDeploy = 7.0,
		SpoilerRetract = 3.2,
		SpeedBrakeDeploy = 3.8,
		SpeedBrakeRetract = 4.8,
		GearSequence = 0.294,
		WheelSpinUp = 5.0,
		WheelSpinDown = 1.25,
		FanSpinUp = 2.3,
		FanSpinDown = 1.15,
		ReverserDeploy = 3.0,
		ReverserStow = 4.2,
		WingFlex = 2.4,
		WingtipFold = 0.72,
		Compression = 5.2,
	},
	Inversion = {
		Aileron = 1,
		Elevator = 1,
		Rudder = 1,
		Flaps = 1,
		Slats = 1,
		Spoilers = 1,
		Wheels = 1,
		Fans = 1,
		Reversers = 1,
	},
	TravelScale = {
		Flaps = 1,
		Slats = 1,
		Reversers = 1,
	},
	GearSequence = {
		DoorOpenEnd = 0.22,
		GearMoveStart = 0.20,
		GearMoveEnd = 0.80,
		DoorCloseStart = 0.78,
	},
}

local profileOverrides = {
	Regional = {
		Angles = { Aileron = 19, Elevator = 18, Rudder = 26, Flaps = 24, Spoilers = 40, NoseSteer = 34 },
		Rates = { Control = 10.5, Flaps = 2.0, Slats = 1.85, GearSequence = 0.294 },
	},
	["Narrow-body"] = {
		Angles = { Aileron = 18, Elevator = 17, Rudder = 25, Flaps = 23, Spoilers = 39, NoseSteer = 33 },
		Rates = { Control = 9.6, Flaps = 1.85, Slats = 1.70, GearSequence = 0.294 },
	},
	["Mid-size"] = {
		Angles = { Aileron = 17, Elevator = 16, Rudder = 24, Flaps = 22, Spoilers = 38, NoseSteer = 31 },
		Rates = { Control = 8.7, Flaps = 1.65, Slats = 1.55, GearSequence = 0.294 },
	},
	["Wide-body"] = {
		Angles = { Aileron = 16, Elevator = 15, Rudder = 23, Flaps = 21, Spoilers = 37, NoseSteer = 29 },
		Rates = { Control = 7.8, Flaps = 1.45, Slats = 1.35, GearSequence = 0.28 },
	},
	["Long-haul"] = {
		Angles = { Aileron = 15, Elevator = 14, Rudder = 22, Flaps = 20, Spoilers = 36, NoseSteer = 28 },
		Rates = { Control = 7.2, Flaps = 1.30, Slats = 1.24, GearSequence = 0.26 },
	},
	Jumbo = {
		Angles = { Aileron = 14, Elevator = 13, Rudder = 21, Flaps = 19, Spoilers = 35, NoseSteer = 27 },
		Rates = { Control = 6.5, Flaps = 1.18, Slats = 1.12, GearSequence = 0.24 },
	},
	Superjumbo = {
		Angles = { Aileron = 13, Elevator = 12, Rudder = 20, Flaps = 18, Spoilers = 34, NoseSteer = 25 },
		Rates = { Control = 5.9, Flaps = 1.08, Slats = 1.02, GearSequence = 0.22 },
	},
}

local profileByCode = {
	A223 = "Regional", E290 = "Regional", E295 = "Regional", CRJ9 = "Regional",
	A19N = "Narrow-body", A20N = "Narrow-body", A21N = "Narrow-body", B38M = "Narrow-body", B39M = "Narrow-body",
	B752 = "Mid-size",
	A339 = "Wide-body", B763 = "Wide-body",
	A359 = "Long-haul", A35K = "Long-haul", B77W = "Long-haul", B779 = "Long-haul", B788 = "Long-haul", B789 = "Long-haul",
	B748 = "Jumbo",
	A388 = "Superjumbo",
}

local function deepCopy(source: { [any]: any }): { [any]: any }
	local result = {}
	for key, value in pairs(source) do
		result[key] = if type(value) == "table" then deepCopy(value) else value
	end
	return result
end

local function merge(target: { [any]: any }, source: { [any]: any })
	for key, value in pairs(source) do
		if type(value) == "table" and type(target[key]) == "table" then
			merge(target[key], value)
		else
			target[key] = value
		end
	end
end

function AircraftAnimationConfig.Get(aircraftCode: string?)
	local result = deepCopy(base)
	local profileName = profileByCode[aircraftCode or ""] or "Mid-size"
	local override = profileOverrides[profileName]
	if override then merge(result, override) end
	result.Profile = profileName
	result.AircraftCode = aircraftCode or "UNKNOWN"
	result.Revision = 28
	return result
end

return AircraftAnimationConfig
]]></ProtectedString><bool name="Disabled">false</bool></Properties>
  
</Item>
<Item class="ModuleScript" referent="RBX5">
  <Properties><string name="Name">AircraftVisualController</string><ProtectedString name="Source"><![CDATA[--!nocheck

-- Keeps aircraft presentation separate from the server-authoritative flight model.
-- Parts opt into channels through attributes, so additional aircraft details can be
-- animated without adding name-based logic to the flight script.

local AircraftAnimationConfig = require(script.Parent:WaitForChild("AircraftAnimationConfig"))

local AircraftVisualController = {}

local TAU = math.pi * 2
local motorByPart = setmetatable({}, { __mode = "k" })

local function expApproach(current, target, rate, dt)
	return current + (target - current) * (1 - math.exp(-math.max(0, rate) * math.max(0, dt)))
end

local function smootherStep(value)
	local t = math.clamp(value, 0, 1)
	return t * t * t * (t * (t * 6 - 15) + 10)
end

local function getConfig(state)
	if state.AnimationConfig then return state.AnimationConfig end
	state.AnimationConfig = AircraftAnimationConfig.Get(state.Model:GetAttribute("AircraftCode"))
	return state.AnimationConfig
end

local function getOrCreateFolder(parent, name)
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("Folder") then return existing end
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

local function isEffectAnchor(part)
	if part.Name == "LabelAnchor" or part:GetAttribute("AircraftEffectType") ~= nil then return true end
	for _, child in ipairs(part:GetDescendants()) do
		if child:IsA("Light")
			or child:IsA("ParticleEmitter")
			or child:IsA("Trail")
			or child:IsA("Beam")
			or child:IsA("Sound")
			or child:IsA("BillboardGui") then
			return true
		end
	end
	return false
end

local function isFlightSurface(part)
	return part:GetAttribute("ControlSurfaceType") ~= nil
		or part:GetAttribute("FlapPart") == true
		or part:GetAttribute("SlatPart") == true
		or part:GetAttribute("SpoilerPart") == true
		or part:GetAttribute("ReverserPart") == true
		or part:GetAttribute("WingFlexPart") == true
		or part:GetAttribute("FoldingWingtipPart") == true
end

local function isLandingGear(part)
	return part:GetAttribute("GearPart") == true
		or part:GetAttribute("GearDoorPart") == true
end

local function configureCosmeticPart(part)
	part.Massless = true
	part.CanCollide = false
	part.CanTouch = false
	if part:GetAttribute("CollisionProxy") ~= true and not part:IsA("Seat") and not part:IsA("VehicleSeat") then
		part.CanQuery = false
	end
end

local function weldStaticPart(part, root, weldName)
	configureCosmeticPart(part)
	local weld = part:FindFirstChild(weldName)
	if not weld or not weld:IsA("WeldConstraint") then
		weld = Instance.new("WeldConstraint")
		weld.Name = weldName
		weld.Part0 = root
		weld.Part1 = part
		weld.Parent = part
	end
	part.Anchored = false
end

local function motorizeVisualPart(part, root)
	configureCosmeticPart(part)
	part.Anchored = false
	local motor = part:FindFirstChild("VisualMotor")
	if not motor or not motor:IsA("Motor6D") then
		motor = Instance.new("Motor6D")
		motor.Name = "VisualMotor"
		motor.Part0 = root
		motor.Part1 = part
		motor.C0 = root.CFrame:ToObjectSpace(part.CFrame)
		motor.C1 = CFrame.identity
		motor.Parent = part
	end
	part:SetAttribute("VisualMotorBaseC0", motor.C0)
	motorByPart[part] = motor
	return motor
end

function AircraftVisualController.Organize(model, root)
	local visual = getOrCreateFolder(model, "Visual")
	local controls = getOrCreateFolder(model, "Controls")
	local collision = getOrCreateFolder(model, "Collision")
	local effects = getOrCreateFolder(model, "Effects")
	local interior = getOrCreateFolder(model, "Interior")
	local flightSurfaces = getOrCreateFolder(controls, "FlightSurfaces")
	local engineFans = getOrCreateFolder(controls, "EngineFans")
	local systems = getOrCreateFolder(controls, "Systems")

	local landingGear = model:FindFirstChild("LandingGear")
	if not landingGear or not landingGear:IsA("Folder") then
		landingGear = getOrCreateFolder(controls, "LandingGear")
	else
		landingGear.Parent = controls
	end

	local parts = {}
	local animatedMotorCount = 0
	for _, item in ipairs(model:GetDescendants()) do
		if item:IsA("BasePart") then table.insert(parts, item) end
	end

	for _, part in ipairs(parts) do
		if part == root then
			continue
		elseif part:GetAttribute("CollisionProxy") == true then
			part.Parent = collision
			part.Transparency = 1
			part.CastShadow = false
			weldStaticPart(part, root, "CollisionProxyWeld")
		elseif isLandingGear(part) then
			part.Parent = landingGear
			motorizeVisualPart(part, root)
			animatedMotorCount += 1
		elseif isFlightSurface(part) then
			part.Parent = flightSurfaces
			motorizeVisualPart(part, root)
			animatedMotorCount += 1
		elseif part:GetAttribute("FanBladePart") == true then
			part.Parent = engineFans
			motorizeVisualPart(part, root)
			animatedMotorCount += 1
		elseif part:IsA("Seat") or part:IsA("VehicleSeat") or part:GetAttribute("AircraftEntryAnchor") == true then
			part.Parent = interior
			weldStaticPart(part, root, "StaticInteriorWeld")
		elseif isEffectAnchor(part) then
			part.Parent = effects
			weldStaticPart(part, root, "StaticEffectWeld")
		else
			part.Parent = visual
			weldStaticPart(part, root, "StaticVisualWeld")
		end
	end

	root.Anchored = true
	root.CanCollide = false
	root.CanTouch = false
	model.PrimaryPart = root
	model:SetAttribute("AircraftHierarchyVersion", 3)
	model:SetAttribute("VisualArchitectureRevision", 31)
	model:SetAttribute("ClientVisualAuthorityRevision", 31)
	model:SetAttribute("GearAnimationRevision", 31)
	model:SetAttribute("AnimatedMotorCount", animatedMotorCount)
	model:SetAttribute("CollisionMode", "ScriptedQueries")

	return {
		Root = root,
		Visual = visual,
		Controls = controls,
		Collision = collision,
		Effects = effects,
		Interior = interior,
		FlightSurfaces = flightSurfaces,
		LandingGear = landingGear,
		EngineFans = engineFans,
		Systems = systems,
	}
end

function AircraftVisualController.BuildCache(model)
	local cache = {
		GearParts = {},
		GearDoors = {},
		Flaps = {},
		Slats = {},
		Spoilers = {},
		Rudder = {},
		Elevators = {},
		Ailerons = {},
		Wheels = {},
		EngineFans = {},
		Reversers = {},
		WingFlex = {},
		EngineSounds = {},
	}

	for _, item in ipairs(model:GetDescendants()) do
		if item:IsA("Sound") then
			table.insert(cache.EngineSounds, item)
			continue
		end
		if not item:IsA("BasePart") then continue end
		local motor = item:FindFirstChild("VisualMotor")
		if motor and motor:IsA("Motor6D") then motorByPart[item] = motor end
		if item:GetAttribute("GearPart") == true then table.insert(cache.GearParts, item) end
		if item:GetAttribute("GearDoorPart") == true then table.insert(cache.GearDoors, item) end
		if item:GetAttribute("WheelPart") == true then table.insert(cache.Wheels, item) end
		if item:GetAttribute("FlapPart") == true then table.insert(cache.Flaps, item) end
		if item:GetAttribute("SlatPart") == true then table.insert(cache.Slats, item) end
		if item:GetAttribute("SpoilerPart") == true then table.insert(cache.Spoilers, item) end
		if item:GetAttribute("FanBladePart") == true then table.insert(cache.EngineFans, item) end
		if item:GetAttribute("ReverserPart") == true then table.insert(cache.Reversers, item) end
		if item:GetAttribute("WingFlexPart") == true or item:GetAttribute("FoldingWingtipPart") == true then
			table.insert(cache.WingFlex, item)
		end

		local surfaceType = item:GetAttribute("ControlSurfaceType")
		if surfaceType == "RUDDER" then
			table.insert(cache.Rudder, item)
		elseif surfaceType == "ELEVATOR" then
			table.insert(cache.Elevators, item)
		elseif surfaceType == "AILERON" then
			table.insert(cache.Ailerons, item)
		end
	end

	return cache
end

local function setLocalPose(state, item, localPose)
	local motor = motorByPart[item]
	local baseC0 = item:GetAttribute("VisualMotorBaseC0")
	if motor and motor.Parent and typeof(baseC0) == "CFrame" then
		motor.Transform = baseC0:ToObjectSpace(localPose)
	else
		item.CFrame = state.Model:GetPivot() * localPose
	end
end

local function wingFlexiblePose(state, item, baseLocalCF)
	local config = getConfig(state)
	local flexProgress = state.WingFlexProgress or 0
	local foldProgress = state.WingtipFoldProgress or 0
	local maxHeight = math.max(0.5, (state.Model:GetAttribute("FuselageDiameter") or 12) * 0.42)
	local factor = item:GetAttribute("WingFlexFactor") or 0
	local direction = item:GetAttribute("WingFlexDirection") or 1
	local localPose = baseLocalCF
		* CFrame.new(0, maxHeight * factor * flexProgress, 0)
		* CFrame.Angles(0, 0, direction * math.rad(config.Angles.WingFlex * factor * flexProgress))
	if item:GetAttribute("FoldingWingtipPart") == true then
		local foldPivotCF = item:GetAttribute("FoldPivotCF")
		local foldDirection = item:GetAttribute("FoldDirection") or direction
		if typeof(foldPivotCF) == "CFrame" then
			localPose = foldPivotCF
				* CFrame.Angles(0, 0, -foldDirection * math.rad(config.Angles.WingtipFold * foldProgress))
				* foldPivotCF:ToObjectSpace(localPose)
		end
	end
	return localPose
end

local function rotateAroundHinge(localPose, item, rotation)
	local hingeOffset = item:GetAttribute("HingeOffset")
	if typeof(hingeOffset) ~= "Vector3" then return localPose * rotation end
	return localPose * CFrame.new(hingeOffset) * rotation * CFrame.new(-hingeOffset)
end

local function applyWingFlex(state)
	for _, item in ipairs(state.AnimationParts.WingFlex) do
		local baseLocalCF = item:GetAttribute("BaseLocalCF")
		if typeof(baseLocalCF) ~= "CFrame" then continue end
		setLocalPose(state, item, wingFlexiblePose(state, item, baseLocalCF))
	end
end

local function applyEngineAudio(state)
	local engineOn = state.Engine == true
	local power = math.clamp((state.EnginePower or 0) / 100, 0, 1)
	for _, sound in ipairs(state.AnimationParts.EngineSounds) do
		local slot = sound:GetAttribute("EngineSoundSlot")
		local configured = sound.SoundId ~= ""
		local targetVolume = 0
		if slot == "IDLE" then
			targetVolume = engineOn and (0.16 + (1 - power) * 0.22) or 0
			sound.PlaybackSpeed = 0.82 + power * 0.22
		elseif slot == "POWER" then
			targetVolume = engineOn and power * 0.48 or 0
			sound.PlaybackSpeed = 0.74 + power * 0.48
		elseif slot == "TAKEOFF" then
			targetVolume = engineOn and math.clamp((power - 0.68) / 0.32, 0, 1) * 0.66 or 0
			sound.PlaybackSpeed = 0.90 + power * 0.18
		elseif slot == "REVERSE" then
			local rollout = state.OnGround
				and (state.LandingPhase == "MAIN_GEAR" or state.LandingPhase == "NOSE_GEAR" or state.LandingPhase == "ROLLOUT")
			local reverseActive = engineOn and rollout and math.abs(state.Speed or 0) > 25 and (state.Throttle or 0) < 40
			targetVolume = reverseActive and 0.56 or 0
			sound.PlaybackSpeed = 0.86 + power * 0.24
		elseif slot == "SHUTDOWN" and state.LastEngineAudioState == true and not engineOn and configured then
			sound.Volume = 0.52
			sound:Play()
		end
		sound.Volume += (targetVolume - sound.Volume) * 0.12
		if configured and sound.Looped and targetVolume > 0.005 and not sound.IsPlaying then
			sound:Play()
		elseif sound.Looped and targetVolume <= 0.002 and sound.IsPlaying then
			sound:Stop()
		end
	end
	state.LastEngineAudioState = engineOn
end

function AircraftVisualController.ApplyGear(state)
	local config = getConfig(state)
	-- The state value remains linear and authoritative. Only the rendered travel
	-- is eased so the struts accelerate away from the bay and settle into their
	-- uplocks/downlocks without the old sudden drop or snap.
	local deploymentProgress = smootherStep(state.GearProgress)
	for _, item in ipairs(state.AnimationParts.GearParts) do
		local baseLocalCF = item:GetAttribute("BaseLocalCF")
		local retractedLocalCF = item:GetAttribute("RetractedLocalCF")
		if typeof(baseLocalCF) == "CFrame" and typeof(retractedLocalCF) == "CFrame" then
			local localPose = retractedLocalCF:Lerp(baseLocalCF, deploymentProgress)
			local truckPivotBaseCF = item:GetAttribute("TruckPivotBaseCF")
			local truckPivotRetractedCF = item:GetAttribute("TruckPivotRetractedCF")
			if typeof(truckPivotBaseCF) == "CFrame" and typeof(truckPivotRetractedCF) == "CFrame" then
				local truckPivot = truckPivotRetractedCF:Lerp(truckPivotBaseCF, deploymentProgress)
				local maxTilt = item:GetAttribute("TruckMaxTiltDegrees") or 0
				local tiltDirection = item:GetAttribute("TruckTiltDirection") or 1
				local tiltProgress = (state.TruckTiltProgress or 0) * state.GearProgress
				local truckTilt = CFrame.Angles(math.rad(maxTilt * tiltDirection * tiltProgress), 0, 0)
				localPose = truckPivot * truckTilt * truckPivot:ToObjectSpace(localPose)
			end
			local compressionGroup = item:GetAttribute("GearCompressionGroup")
			if compressionGroup then
				local compression = compressionGroup == "NOSE"
					and (state.NoseGearCompression or 0) or (state.GearCompression or 0)
				local compressionFactor = item:GetAttribute("GearCompressionFactor") or 1
				localPose *= CFrame.new(0, compression * compressionFactor * state.GearProgress, 0)
			end
			if item:GetAttribute("NoseSteerPart") == true then
				local steeringAngle = math.rad(math.clamp(state.GroundSteer or 0, -1, 1) * config.Angles.NoseSteer * state.GearProgress)
				localPose *= CFrame.Angles(0, steeringAngle, 0)
			end
			if item:GetAttribute("WheelPart") == true then
				local direction = item:GetAttribute("WheelDirection") or 1
				localPose *= CFrame.Angles((state.WheelRotation or 0) * direction, 0, 0)
			end
			setLocalPose(state, item, localPose)
			local extendedTransparency = item:GetAttribute("ExtendedTransparency") or 0
			item.Transparency = state.GearProgress <= 0.015 and 1 or extendedTransparency
		end
	end

	for _, item in ipairs(state.AnimationParts.GearDoors) do
		local closedLocalCF = item:GetAttribute("ClosedLocalCF")
		local openLocalCF = item:GetAttribute("OpenLocalCF")
		if typeof(closedLocalCF) == "CFrame" and typeof(openLocalCF) == "CFrame" then
			local doorProgress = state.GearDoorProgress
			if doorProgress == nil then
				local offset = item:GetAttribute("DoorSequenceOffset") or 0
				local doorPhase = math.clamp((state.GearProgress - offset) / math.max(0.05, 1 - offset), 0, 1)
				doorProgress = math.sin(math.pi * doorPhase) ^ 0.78
			end
			setLocalPose(state, item, closedLocalCF:Lerp(openLocalCF, doorProgress))
		end
	end
end

function AircraftVisualController.SetGear(state, visible, immediate)
	state.Gear = visible
	if immediate then state.GearProgress = visible and 1 or 0 end
	state.GearMoving = math.abs(state.GearProgress - (visible and 1 or 0)) > 0.001
	AircraftVisualController.ApplyGear(state)
end

function AircraftVisualController.ApplyFlaps(state)
	local config = getConfig(state)
	local ratio = math.clamp(state.FlapPosition / 3, 0, 1)
	for _, item in ipairs(state.AnimationParts.Flaps) do
		local baseLocalCF = item:GetAttribute("BaseLocalCF")
		local travel = item:GetAttribute("FlapTravel")
		local maxAngle = config.Angles.Flaps or item:GetAttribute("FlapMaxAngle") or 18
		if typeof(baseLocalCF) == "CFrame" and typeof(travel) == "Vector3" then
			local amount = ratio * config.Inversion.Flaps
			local localPose = wingFlexiblePose(state, item, baseLocalCF) * CFrame.new(travel * amount * config.TravelScale.Flaps)
			setLocalPose(state, item, rotateAroundHinge(localPose, item, CFrame.Angles(math.rad(maxAngle * amount), 0, 0)))
		end
	end

	for _, item in ipairs(state.AnimationParts.Slats) do
		local baseLocalCF = item:GetAttribute("BaseLocalCF")
		local travel = item:GetAttribute("SlatTravel")
		if typeof(baseLocalCF) == "CFrame" and typeof(travel) == "Vector3" then
			local amount = ratio * config.Inversion.Slats * config.TravelScale.Slats
			setLocalPose(state, item, wingFlexiblePose(state, item, baseLocalCF) * CFrame.new(travel * amount))
		end
	end
end

function AircraftVisualController.SetFlaps(state, level, immediate)
	state.Flaps = level
	if immediate then state.FlapPosition = level end
	state.FlapsMoving = math.abs(state.FlapPosition - level) > 0.001
	AircraftVisualController.ApplyFlaps(state)
end

local function applyControlSurfaceList(state, parts, control, onGround, groundSteer)
	local config = getConfig(state)
	for _, item in ipairs(parts) do
		local baseLocalCF = item:GetAttribute("BaseLocalCF")
		if typeof(baseLocalCF) ~= "CFrame" then continue end
		local surfaceType = item:GetAttribute("ControlSurfaceType")
		local direction = item:GetAttribute("ControlDirection") or 1
		local configKey = surfaceType == "RUDDER" and "Rudder" or (surfaceType == "ELEVATOR" and "Elevator" or "Aileron")
		local maxAngle = config.Angles[configKey] or item:GetAttribute("ControlMaxAngle") or 15
		local inversion = config.Inversion[configKey] or 1
		local amount = control
		if surfaceType == "RUDDER" then
			amount = onGround and groundSteer or control * 0.22
			setLocalPose(state, item, rotateAroundHinge(baseLocalCF, item, CFrame.Angles(0, math.rad(amount * maxAngle * direction * inversion), 0)))
		else
			local localPose = wingFlexiblePose(state, item, baseLocalCF)
			setLocalPose(state, item, rotateAroundHinge(localPose, item, CFrame.Angles(math.rad(amount * maxAngle * direction * inversion), 0, 0)))
		end
	end
end

local function applyVisualGeometry(state, includeAudio)
	local config = getConfig(state)
	AircraftVisualController.ApplyGear(state)
	AircraftVisualController.ApplyFlaps(state)
	applyWingFlex(state)
	if includeAudio then applyEngineAudio(state) end
	applyControlSurfaceList(state, state.AnimationParts.Ailerons, state.Controls.Roll, state.OnGround, state.GroundSteer)
	applyControlSurfaceList(state, state.AnimationParts.Elevators, state.Controls.Pitch, state.OnGround, state.GroundSteer)
	applyControlSurfaceList(state, state.AnimationParts.Rudder, state.Controls.Roll, state.OnGround, state.GroundSteer)

	for _, item in ipairs(state.AnimationParts.Spoilers) do
		local baseLocalCF = item:GetAttribute("BaseLocalCF")
		if typeof(baseLocalCF) == "CFrame" then
			local direction = item:GetAttribute("SpoilerDirection") or 1
			local rollSpoiler = not state.OnGround and math.max(0, (state.Controls.Roll or 0) * direction) * 0.48 or 0
			local amount = math.clamp(math.max(state.SpoilerProgress or 0, state.SpeedBrakeProgress or 0, rollSpoiler), 0, 1)
			local localPose = wingFlexiblePose(state, item, baseLocalCF)
			local maxAngle = config.Angles.Spoilers or item:GetAttribute("SpoilerMaxAngle") or 40
			setLocalPose(state, item, rotateAroundHinge(localPose, item, CFrame.Angles(math.rad(-maxAngle * amount * config.Inversion.Spoilers), 0, 0)))
		end
	end
	for _, item in ipairs(state.AnimationParts.Reversers) do
		local baseLocalCF = item:GetAttribute("BaseLocalCF")
		local travel = item:GetAttribute("ReverserTravel") or 0
		if typeof(baseLocalCF) == "CFrame" then
			local amount = (state.ReverserProgress or 0) * config.Inversion.Reversers * config.TravelScale.Reversers
			setLocalPose(state, item, baseLocalCF * CFrame.new(0, 0, travel * amount))
		end
	end
	for _, item in ipairs(state.AnimationParts.EngineFans) do
		local baseLocalCF = item:GetAttribute("BaseLocalCF")
		if typeof(baseLocalCF) == "CFrame" then
			setLocalPose(state, item, baseLocalCF * CFrame.Angles(0, 0, state.FanRotation * config.Inversion.Fans))
		end
	end
end

function AircraftVisualController.Apply(state, dt, renderGeometry)
	local config = getConfig(state)
	local spoilerTarget = state.OnGround
		and state.Speed > 18
		and (state.LandingPhase == "MAIN_GEAR" or state.LandingPhase == "NOSE_GEAR" or state.LandingPhase == "ROLLOUT")
		and 1 or 0
	local spoilerRate = spoilerTarget > state.SpoilerProgress and config.Rates.SpoilerDeploy or config.Rates.SpoilerRetract
	state.SpoilerProgress += (spoilerTarget - state.SpoilerProgress) * math.clamp(dt * spoilerRate, 0, 1)
	local speedBrakeTarget = state.SpeedBrake and 1 or 0
	state.SpeedBrakeProgress = (state.SpeedBrakeProgress or 0)
		+ (speedBrakeTarget - (state.SpeedBrakeProgress or 0)) * math.clamp(dt * (speedBrakeTarget > (state.SpeedBrakeProgress or 0) and config.Rates.SpeedBrakeDeploy or config.Rates.SpeedBrakeRetract), 0, 1)
	local reverserTarget = state.Engine
		and state.OnGround
		and math.abs(state.Speed or 0) > 25
		and (state.Throttle or 0) < 40
		and (state.LandingPhase == "MAIN_GEAR" or state.LandingPhase == "NOSE_GEAR" or state.LandingPhase == "ROLLOUT")
		and 1 or 0
	state.ReverserProgress = (state.ReverserProgress or 0)
		+ (reverserTarget - (state.ReverserProgress or 0)) * math.clamp(dt * (reverserTarget > (state.ReverserProgress or 0) and config.Rates.ReverserDeploy or config.Rates.ReverserStow), 0, 1)

	local fanTarget = state.EnginePower > 0.5 and (2.2 + state.EnginePower * 0.31) or 0
	state.FanAngularVelocity += (fanTarget - state.FanAngularVelocity) * math.clamp(dt * (fanTarget > state.FanAngularVelocity and config.Rates.FanSpinUp or config.Rates.FanSpinDown), 0, 1)
	state.FanRotation = (state.FanRotation + state.FanAngularVelocity * dt) % TAU

	local wheelRadius = math.max(0.5, state.Model:GetAttribute("WheelRadius") or 1.5)
	local wheelTarget = state.OnGround and math.abs(state.Speed) * 0.72 / wheelRadius or 0
	local wheelRate = wheelTarget > state.WheelAngularVelocity and config.Rates.WheelSpinUp or config.Rates.WheelSpinDown
	state.WheelAngularVelocity += (wheelTarget - state.WheelAngularVelocity) * math.clamp(dt * wheelRate, 0, 1)
	state.WheelRotation = (state.WheelRotation + state.WheelAngularVelocity * dt * (state.Speed < 0 and -1 or 1)) % TAU

	local stallSpeed = state.Spec.StallSpeed or 120
	local cruiseSpeed = state.Spec.CruiseSpeed or 450
	local flexTarget = state.OnGround and math.clamp(state.Speed / math.max(1, stallSpeed) * 0.08, 0, 0.08)
		or math.clamp(0.18 + state.Speed / math.max(1, cruiseSpeed) * 0.52 + math.abs(state.VerticalVelocity or 0) * 0.018, 0, 1)
	state.WingFlexProgress = (state.WingFlexProgress or 0)
		+ (flexTarget - (state.WingFlexProgress or 0)) * math.clamp(dt * config.Rates.WingFlex, 0, 1)
	local foldTarget = state.Model:GetAttribute("FoldingTips") == true
		and state.OnGround and not state.Engine and math.abs(state.Speed) < 2 and 1 or 0
	state.WingtipFoldProgress = (state.WingtipFoldProgress or 0)
		+ (foldTarget - (state.WingtipFoldProgress or 0)) * math.clamp(dt * config.Rates.WingtipFold, 0, 1)

	-- Multi-axle bogies hang at their catalog-driven tilt in flight, then rotate
	-- smoothly onto all axles as the main gear accepts the aircraft's weight.
	local truckTiltTarget = not state.OnGround and state.GearProgress > 0.20 and 1 or 0
	local truckTiltRate = truckTiltTarget > (state.TruckTiltProgress or 0) and 1.45 or 2.2
	state.TruckTiltProgress = (state.TruckTiltProgress or 0)
		+ (truckTiltTarget - (state.TruckTiltProgress or 0)) * math.clamp(dt * truckTiltRate, 0, 1)
	local noseCompressionTarget = 0
	if state.LandingPhase == "NOSE_GEAR" then
		local settle = math.clamp((state.LandingTimer or 0) / 1.65, 0, 1)
		local smoothSettle = settle * settle * (3 - 2 * settle)
		noseCompressionTarget = (1 - smoothSettle) * 0.42
	end
	state.NoseGearCompression = (state.NoseGearCompression or 0)
		+ (noseCompressionTarget - (state.NoseGearCompression or 0)) * math.clamp(dt * 4.2, 0, 1)

	-- V31 gives the render-step controller sole ownership of cosmetic Motor6Ds.
	-- The server still advances authoritative state and audio, but no longer
	-- fights every client by replicating different C0 values on Heartbeat.
	if renderGeometry == false then
		applyEngineAudio(state)
	else
		applyVisualGeometry(state, true)
	end
end

local ClientController = {}
ClientController.__index = ClientController

local function numberAttribute(model, name, fallback)
	local value = model:GetAttribute(name)
	return if type(value) == "number" then value else fallback
end

function AircraftVisualController.CreateClient(model)
	assert(model and model:IsA("Model"), "CreateClient expects an aircraft Model")
	local config = AircraftAnimationConfig.Get(model:GetAttribute("AircraftCode"))
	local gearTarget = model:GetAttribute("Gear") ~= false
	local gearProgress = numberAttribute(model, "GearProgress", gearTarget and 1 or 0)
	local state = {
		Model = model,
		AnimationParts = AircraftVisualController.BuildCache(model),
		AnimationConfig = config,
		Spec = {
			StallSpeed = numberAttribute(model, "StallSpeed", 120),
			CruiseSpeed = numberAttribute(model, "CruiseSpeed", 450),
		},
		Controls = { Pitch = 0, Roll = 0 },
		Gear = gearTarget,
		GearProgress = gearProgress,
		GearDoorProgress = 0,
		GroundSteer = 0,
		GearCompression = 0,
		NoseGearCompression = 0,
		TruckTiltProgress = numberAttribute(model, "TruckTiltProgress", 0),
		FlapPosition = numberAttribute(model, "FlapPosition", 0),
		SpoilerProgress = 0,
		SpeedBrakeProgress = numberAttribute(model, "SpeedBrakeProgress", 0),
		ReverserProgress = 0,
		FanRotation = 0,
		FanAngularVelocity = 0,
		WheelRotation = 0,
		WheelAngularVelocity = 0,
		WingFlexProgress = 0,
		WingtipFoldProgress = model:GetAttribute("FoldingTips") == true and 1 or 0,
		OnGround = model:GetAttribute("OnGround") ~= false,
		LandingPhase = model:GetAttribute("LandingPhase") or "NONE",
		Speed = numberAttribute(model, "Speed", 0),
		Throttle = numberAttribute(model, "Throttle", 0),
		EnginePower = numberAttribute(model, "EnginePower", 0),
		Engine = model:GetAttribute("Engine") == true,
		VerticalVelocity = numberAttribute(model, "VerticalVelocity", 0),
	}

	local self = setmetatable({
		Model = model,
		State = state,
		Config = config,
		GearTarget = gearTarget,
		GearStart = gearProgress,
		GearSequenceProgress = 1,
		GearTransitioning = false,
		GearDoorStart = 0,
		Connections = {},
		Destroyed = false,
	}, ClientController)

	table.insert(self.Connections, model.Destroying:Connect(function()
		self:Destroy()
	end))
	table.insert(self.Connections, model.AncestryChanged:Connect(function(_, parent)
		if parent == nil then self:Destroy() end
	end))
	return self
end

function ClientController:Destroy()
	if self.Destroyed then return end
	self.Destroyed = true
	for _, connection in ipairs(self.Connections) do connection:Disconnect() end
	table.clear(self.Connections)
	table.clear(self.State.AnimationParts)
	self.Model = nil
end

function ClientController:Step(deltaTime)
	if self.Destroyed or not self.Model or not self.Model.Parent or not self.Model.PrimaryPart then return false end
	local dt = math.clamp(deltaTime, 0, 0.10)
	local model = self.Model
	local state = self.State
	local config = self.Config

	state.Speed = numberAttribute(model, "Speed", state.Speed)
	state.Throttle = numberAttribute(model, "Throttle", state.Throttle)
	state.EnginePower = numberAttribute(model, "EnginePower", state.EnginePower)
	state.VerticalVelocity = numberAttribute(model, "VerticalVelocity", state.VerticalVelocity)
	state.Engine = model:GetAttribute("Engine") == true
	local onGroundAttribute = model:GetAttribute("OnGround")
	if type(onGroundAttribute) == "boolean" then state.OnGround = onGroundAttribute end
	state.LandingPhase = model:GetAttribute("LandingPhase") or "NONE"
	state.Controls.Pitch = expApproach(state.Controls.Pitch, numberAttribute(model, "ControlPitch", 0), config.Rates.Control, dt)
	state.Controls.Roll = expApproach(state.Controls.Roll, numberAttribute(model, "ControlRoll", 0), config.Rates.Control, dt)
	state.GroundSteer = expApproach(state.GroundSteer, numberAttribute(model, "GroundSteer", 0), config.Rates.Control, dt)

	local flapTarget = numberAttribute(model, "FlapPosition", numberAttribute(model, "Flaps", 0))
	local flapRate = flapTarget > state.FlapPosition and config.Rates.Flaps or config.Rates.Slats
	state.FlapPosition = expApproach(state.FlapPosition, flapTarget, flapRate, dt)

	local gearTarget = model:GetAttribute("Gear") ~= false
	if gearTarget ~= self.GearTarget then
		self.GearTarget = gearTarget
		self.GearStart = state.GearProgress
		self.GearDoorStart = state.GearDoorProgress or 0
		self.GearSequenceProgress = 0
		self.GearTransitioning = true
	end
	if self.GearTransitioning then
		self.GearSequenceProgress = math.min(1, self.GearSequenceProgress + dt * config.Rates.GearSequence)
		local sequence = config.GearSequence
		local moveRatio = smootherStep((self.GearSequenceProgress - sequence.GearMoveStart) / math.max(0.01, sequence.GearMoveEnd - sequence.GearMoveStart))
		state.GearProgress = self.GearStart + ((self.GearTarget and 1 or 0) - self.GearStart) * moveRatio
		if self.GearSequenceProgress < sequence.DoorOpenEnd then
			local openRatio = smootherStep(self.GearSequenceProgress / sequence.DoorOpenEnd)
			state.GearDoorProgress = self.GearDoorStart + (1 - self.GearDoorStart) * openRatio
		elseif self.GearSequenceProgress < sequence.DoorCloseStart then
			state.GearDoorProgress = 1
		else
			state.GearDoorProgress = 1 - smootherStep((self.GearSequenceProgress - sequence.DoorCloseStart) / math.max(0.01, 1 - sequence.DoorCloseStart))
		end
		if self.GearSequenceProgress >= 1 then
			self.GearTransitioning = false
			state.GearProgress = self.GearTarget and 1 or 0
			state.GearDoorProgress = 0
		end
	else
		state.GearProgress = expApproach(state.GearProgress, numberAttribute(model, "GearProgress", gearTarget and 1 or 0), config.Rates.GearSequence * 4, dt)
		state.GearDoorProgress = 0
	end
	state.Gear = gearTarget

	local rollout = state.OnGround and state.Speed > 18
		and (state.LandingPhase == "MAIN_GEAR" or state.LandingPhase == "NOSE_GEAR" or state.LandingPhase == "ROLLOUT")
	local spoilerTarget = rollout and 1 or 0
	state.SpoilerProgress = expApproach(state.SpoilerProgress, spoilerTarget, spoilerTarget > state.SpoilerProgress and config.Rates.SpoilerDeploy or config.Rates.SpoilerRetract, dt)
	local speedBrakeTarget = model:GetAttribute("SpeedBrake") == true and 1 or 0
	state.SpeedBrakeProgress = expApproach(state.SpeedBrakeProgress, speedBrakeTarget, speedBrakeTarget > state.SpeedBrakeProgress and config.Rates.SpeedBrakeDeploy or config.Rates.SpeedBrakeRetract, dt)

	local reverseTarget = state.Engine and state.OnGround and math.abs(state.Speed) > 25 and state.Throttle < 40 and rollout and 1 or 0
	state.ReverserProgress = expApproach(state.ReverserProgress, reverseTarget, reverseTarget > state.ReverserProgress and config.Rates.ReverserDeploy or config.Rates.ReverserStow, dt)
	local fanTarget = state.EnginePower > 0.5 and (2.2 + state.EnginePower * 0.31) or 0
	state.FanAngularVelocity = expApproach(state.FanAngularVelocity, fanTarget, fanTarget > state.FanAngularVelocity and config.Rates.FanSpinUp or config.Rates.FanSpinDown, dt)
	state.FanRotation = (state.FanRotation + state.FanAngularVelocity * dt) % TAU

	local wheelRadius = math.max(0.5, model:GetAttribute("WheelRadius") or 1.5)
	local wheelTarget = state.OnGround and math.abs(state.Speed) * 0.72 / wheelRadius or 0
	state.WheelAngularVelocity = expApproach(state.WheelAngularVelocity, wheelTarget, wheelTarget > state.WheelAngularVelocity and config.Rates.WheelSpinUp or config.Rates.WheelSpinDown, dt)
	state.WheelRotation = (state.WheelRotation + state.WheelAngularVelocity * dt * (state.Speed < 0 and -1 or 1) * config.Inversion.Wheels) % TAU

	local flexTarget = state.OnGround and math.clamp(state.Speed / math.max(1, state.Spec.StallSpeed) * 0.08, 0, 0.08)
		or math.clamp(0.18 + state.Speed / math.max(1, state.Spec.CruiseSpeed) * 0.52 + math.abs(state.VerticalVelocity) * 0.018, 0, 1)
	state.WingFlexProgress = expApproach(state.WingFlexProgress, flexTarget, config.Rates.WingFlex, dt)
	local foldTarget = model:GetAttribute("FoldingTips") == true and state.OnGround and not state.Engine and math.abs(state.Speed) < 2 and 1 or 0
	state.WingtipFoldProgress = expApproach(state.WingtipFoldProgress, foldTarget, config.Rates.WingtipFold, dt)
	state.TruckTiltProgress = expApproach(state.TruckTiltProgress, numberAttribute(model, "TruckTiltProgress", state.OnGround and 0 or 1), config.Rates.Control, dt)
	state.GearCompression = expApproach(state.GearCompression, numberAttribute(model, "GearCompression", 0), config.Rates.Compression, dt)
	state.NoseGearCompression = expApproach(state.NoseGearCompression, numberAttribute(model, "NoseGearCompression", 0), config.Rates.Compression, dt)

	applyVisualGeometry(state, false)
	return true
end

return AircraftVisualController
]]></ProtectedString><bool name="Disabled">false</bool></Properties>
  
</Item>
<Item class="ModuleScript" referent="RBX6">
  <Properties><string name="Name">AircraftSilhouetteConfig</string><ProtectedString name="Source"><![CDATA[--!strict

-- V25 procedural silhouette profiles. Real exterior length, span, height, and
-- fuselage width still come from AircraftCatalog. These ratios refine the visual
-- planform and moving-surface layout by family; they do not alter flight physics.
-- Values that are not manufacturer-published dimensions are reference-view
-- estimates and are deliberately kept separate from the catalog's hard data.

local AircraftSilhouetteConfig = {}

local defaults = {
	FuselageVerticalRatio = 1.00,
	WingRootZRatio = -0.055,
	WingRootChordRatio = 0.270,
	WingTipChordRatio = 0.065,
	WingDihedralDegrees = 2.0,
	TailSpanRatio = 0.34,
	TailRootChordRatio = 0.120,
	TailTipChordRatio = 0.045,
	FinRootChordRatio = 0.125,
	FinTipChordRatio = 0.040,
	FinSweepRatio = 0.42,
	FlapSections = 2,
	FlapMaxAngle = 26,
	SlatSections = 7,
	SpoilerSections = 4,
}

local byProfile = {
	A220 = { FuselageVerticalRatio = 1.04, WingRootChordRatio = 0.258, WingTipChordRatio = 0.058, WingDihedralDegrees = 3.2, TailSpanRatio = 0.32, SlatSections = 7 },
	A320 = { FuselageVerticalRatio = 1.02, WingRootChordRatio = 0.250, WingTipChordRatio = 0.060, WingDihedralDegrees = 3.0, TailSpanRatio = 0.32, SlatSections = 8 },
	A330 = { FuselageVerticalRatio = 1.01, WingRootChordRatio = 0.255, WingTipChordRatio = 0.055, WingDihedralDegrees = 3.0, TailSpanRatio = 0.32, FlapSections = 3, FlapMaxAngle = 30, SlatSections = 10, SpoilerSections = 5 },
	A350 = { FuselageVerticalRatio = 1.03, WingRootChordRatio = 0.248, WingTipChordRatio = 0.050, WingDihedralDegrees = 4.2, TailSpanRatio = 0.31, FlapSections = 3, FlapMaxAngle = 30, SlatSections = 10, SpoilerSections = 6 },
	A380 = { FuselageVerticalRatio = 1.08, WingRootChordRatio = 0.270, WingTipChordRatio = 0.060, WingDihedralDegrees = 3.2, TailSpanRatio = 0.31, FlapSections = 3, FlapMaxAngle = 30, SlatSections = 12, SpoilerSections = 6 },
	B737 = { FuselageVerticalRatio = 0.98, WingRootChordRatio = 0.248, WingTipChordRatio = 0.058, WingDihedralDegrees = 3.0, TailSpanRatio = 0.32, FinRootChordRatio = 0.112, FinTipChordRatio = 0.034, FinSweepRatio = 0.46, SlatSections = 8 },
	B747 = { FuselageVerticalRatio = 1.02, WingRootChordRatio = 0.250, WingTipChordRatio = 0.052, WingDihedralDegrees = 3.0, TailSpanRatio = 0.30, FlapSections = 3, FlapMaxAngle = 30, SlatSections = 12, SpoilerSections = 6 },
	B757 = { FuselageVerticalRatio = 0.98, WingRootChordRatio = 0.262, WingTipChordRatio = 0.058, WingDihedralDegrees = 3.0, TailSpanRatio = 0.31, FinRootChordRatio = 0.116, FinTipChordRatio = 0.034, FinSweepRatio = 0.45, SlatSections = 8 },
	B767 = { FuselageVerticalRatio = 0.99, WingRootChordRatio = 0.255, WingTipChordRatio = 0.055, WingDihedralDegrees = 3.2, TailSpanRatio = 0.31, FinRootChordRatio = 0.118, FinTipChordRatio = 0.036, FinSweepRatio = 0.43, FlapSections = 3, FlapMaxAngle = 30, SlatSections = 9, SpoilerSections = 5 },
	B777 = { FuselageVerticalRatio = 1.01, WingRootChordRatio = 0.258, WingTipChordRatio = 0.050, WingDihedralDegrees = 4.0, TailSpanRatio = 0.31, FlapSections = 3, FlapMaxAngle = 30, SlatSections = 10, SpoilerSections = 6 },
	B787 = { FuselageVerticalRatio = 1.02, WingRootChordRatio = 0.245, WingTipChordRatio = 0.045, WingDihedralDegrees = 5.0, TailSpanRatio = 0.31, FlapSections = 3, FlapMaxAngle = 30, SlatSections = 10, SpoilerSections = 6 },
	E2 = { FuselageVerticalRatio = 1.03, WingRootChordRatio = 0.248, WingTipChordRatio = 0.050, WingDihedralDegrees = 4.0, TailSpanRatio = 0.31, SlatSections = 7 },
	CRJ = { FuselageVerticalRatio = 0.96, WingRootChordRatio = 0.245, WingTipChordRatio = 0.055, WingDihedralDegrees = 2.8, TailSpanRatio = 0.30, FlapMaxAngle = 28, SlatSections = 6, SpoilerSections = 3 },
}

function AircraftSilhouetteConfig.Get(spec)
	local result = table.clone(defaults)
	local profile = byProfile[spec.NoseProfile or ""]
	if profile then
		for key, value in pairs(profile) do result[key] = value end
	end
	return result
end

return AircraftSilhouetteConfig
]]></ProtectedString><bool name="Disabled">false</bool></Properties>
  
</Item>
<Item class="ModuleScript" referent="RBX7">
  <Properties><string name="Name">AircraftMaterialConfig</string><ProtectedString name="Source"><![CDATA[--!nocheck

-- V27 data-driven aircraft material layer. Map fields are intentionally empty
-- until original Around the World texture assets are uploaded. Existing
-- MeshPart TextureIDs and SurfaceAppearance maps are never overwritten by the
-- default Apply() path.

local AircraftMaterialConfig = {}

local EMPTY_MAPS = {
	ColorMap = "",
	NormalMap = "",
	RoughnessMap = "",
	MetalnessMap = "",
	EmissiveMap = "",
}

local function maps()
	return table.clone(EMPTY_MAPS)
end

AircraftMaterialConfig.Definitions = {
	PaintedFuselage = {
		Maps = maps(), Material = Enum.Material.SmoothPlastic, Reflectance = 0.025,
		ApplicableMaps = { "ColorMap", "NormalMap", "RoughnessMap", "MetalnessMap" },
	},
	BareMetal = {
		Maps = maps(), Material = Enum.Material.Metal, Reflectance = 0.12,
		ApplicableMaps = { "ColorMap", "NormalMap", "RoughnessMap", "MetalnessMap" },
	},
	Wings = {
		Maps = maps(), Material = Enum.Material.SmoothPlastic, Reflectance = 0.035,
		ApplicableMaps = { "ColorMap", "NormalMap", "RoughnessMap", "MetalnessMap" },
	},
	EngineNacelles = {
		Maps = maps(), Material = Enum.Material.SmoothPlastic, Reflectance = 0.045,
		ApplicableMaps = { "ColorMap", "NormalMap", "RoughnessMap", "MetalnessMap" },
	},
	RubberTires = {
		Maps = maps(), Material = Enum.Material.Rubber, Reflectance = 0,
		ApplicableMaps = { "ColorMap", "NormalMap", "RoughnessMap", "MetalnessMap" },
	},
	CockpitWindows = {
		Maps = maps(), Material = Enum.Material.Glass, Reflectance = 0.11,
		Color = Color3.fromRGB(17, 38, 52),
		ApplicableMaps = { "ColorMap", "NormalMap", "RoughnessMap", "MetalnessMap" },
	},
	PassengerWindows = {
		Maps = maps(), Material = Enum.Material.Glass, Reflectance = 0.07,
		Color = Color3.fromRGB(24, 49, 62),
		ApplicableMaps = { "ColorMap", "NormalMap", "RoughnessMap", "MetalnessMap" },
	},
	InteriorPanels = {
		Maps = maps(), Material = Enum.Material.SmoothPlastic, Reflectance = 0.015,
		ApplicableMaps = { "ColorMap", "NormalMap", "RoughnessMap", "MetalnessMap" },
	},
	InstrumentScreens = {
		Maps = maps(), Material = Enum.Material.Neon, Reflectance = 0.02,
		Color = Color3.fromRGB(10, 28, 32),
		ApplicableMaps = { "ColorMap", "NormalMap", "RoughnessMap", "MetalnessMap", "EmissiveMap" },
	},
}

-- Public compatibility view for existing project customizations.
AircraftMaterialConfig.PBRMaps = {}
for className, definition in pairs(AircraftMaterialConfig.Definitions) do
	AircraftMaterialConfig.PBRMaps[className] = definition.Maps
end

AircraftMaterialConfig.MapDescriptions = {
	ColorMap = "Base color and livery detail without baked lighting or reflections.",
	NormalMap = "Small surface relief such as panel seams, fasteners, tire tread, and interior grain.",
	RoughnessMap = "Grayscale response: white is rough and black is smooth; paint, rubber, glass, and metal need different values.",
	MetalnessMap = "Grayscale mask: bare metal is white while paint, rubber, glass, and interior plastic remain black.",
	EmissiveMap = "Self-lit pixel mask for instrument screens. SurfaceAppearance has no native emissive slot, so V27 preserves it in PBREmissiveMap for the screen/effects workflow.",
}

local CLASS_ALIASES = {
	PaintedAirframe = "PaintedFuselage", CockpitGlass = "CockpitWindows",
	PassengerGlass = "PassengerWindows", TireRubber = "RubberTires", EngineInterior = "BareMetal",
}

local function contains(name, pattern)
	return string.find(string.lower(name), string.lower(pattern), 1, true) ~= nil
end

local function validClass(value)
	if type(value) ~= "string" then return nil end
	if CLASS_ALIASES[value] then return CLASS_ALIASES[value] end
	if AircraftMaterialConfig.Definitions[value] then return value end
	return nil
end

local function classify(part)
	local attributed = validClass(part:GetAttribute("PBRMaterialClass"))
	if attributed then return attributed end
	local name = part.Name
	if contains(name, "instrument") or contains(name, "screen") or contains(name, "display") then return "InstrumentScreens" end
	if contains(name, "cockpitfrontpane") or contains(name, "cockpitsidepane") or contains(name, "windshieldpane") or contains(name, "cockpitglass") then return "CockpitWindows" end
	if contains(name, "cabinwindow") or contains(name, "upperwindow") or contains(name, "passengerglass") then return "PassengerWindows" end
	if contains(name, "hub") or contains(name, "brake") or contains(name, "caliper") then return "BareMetal" end
	if contains(name, "wheel") or contains(name, "tire") or contains(name, "bumper") or contains(name, "tread") then return "RubberTires" end
	if contains(name, "wing") or contains(name, "aileron") or contains(name, "flap") or contains(name, "slat") or contains(name, "spoiler") then return "Wings" end
	if contains(name, "nacelle") or contains(name, "cowling") or contains(name, "pylon") then return "EngineNacelles" end
	if contains(name, "interior") or contains(name, "cockpitpanel") or contains(name, "cabinpanel") or contains(name, "seat") then return "InteriorPanels" end
	if contains(name, "fan") or contains(name, "exhaust") or contains(name, "turbine") or contains(name, "intake") or part.Material == Enum.Material.Metal then return "BareMetal" end
	return "PaintedFuselage"
end

local function hasConfiguredStandardMap(definition)
	for _, propertyName in ipairs({ "ColorMap", "NormalMap", "RoughnessMap", "MetalnessMap" }) do
		if definition.Maps[propertyName] ~= "" then return true end
	end
	return false
end

local function existingSurface(part)
	local first = nil
	local count = 0
	for _, child in ipairs(part:GetChildren()) do
		if child:IsA("SurfaceAppearance") then
			count += 1
			first = first or child
		end
	end
	return first, count
end

local function applyFallback(part, definition)
	part.Material = definition.Material
	part.Reflectance = definition.Reflectance
	if definition.Color then part.Color = definition.Color end
end

function AircraftMaterialConfig.Inspect(model)
	local report = {
		MeshPartCount = 0, SurfaceAppearanceCount = 0, DuplicateSurfaceAppearanceCount = 0,
		TextureIDs = {}, SurfaceMaps = {}, MaterialAssignments = {},
	}
	for _, item in ipairs(model:GetDescendants()) do
		if item:IsA("BasePart") then
			local materialName = item.Material.Name
			report.MaterialAssignments[materialName] = (report.MaterialAssignments[materialName] or 0) + 1
		end
		if item:IsA("MeshPart") then
			report.MeshPartCount += 1
			if item.TextureID ~= "" then
				table.insert(report.TextureIDs, { Path = item:GetFullName(), TextureID = item.TextureID })
			end
			local _, surfaceCount = existingSurface(item)
			if surfaceCount > 1 then report.DuplicateSurfaceAppearanceCount += surfaceCount - 1 end
			for _, child in ipairs(item:GetChildren()) do
				if child:IsA("SurfaceAppearance") then
					report.SurfaceAppearanceCount += 1
					table.insert(report.SurfaceMaps, {
						Path = child:GetFullName(), ColorMap = child.ColorMap, NormalMap = child.NormalMap,
						RoughnessMap = child.RoughnessMap, MetalnessMap = child.MetalnessMap,
						EmissiveMap = child:GetAttribute("PBREmissiveMap") or item:GetAttribute("PBREmissiveMap") or "",
					})
				end
			end
		end
	end
	return report
end

function AircraftMaterialConfig.GetMissingMaps(model)
	local usedClasses = {}
	if model then
		for _, item in ipairs(model:GetDescendants()) do
			if item:IsA("BasePart") then usedClasses[classify(item)] = true end
		end
	else
		for className in pairs(AircraftMaterialConfig.Definitions) do usedClasses[className] = true end
	end
	local missing = {}
	for className in pairs(usedClasses) do
		local definition = AircraftMaterialConfig.Definitions[className]
		if definition then
			for _, mapName in ipairs(definition.ApplicableMaps) do
				if definition.Maps[mapName] == "" then
					table.insert(missing, { MaterialClass = className, Map = mapName, ShouldContain = AircraftMaterialConfig.MapDescriptions[mapName] })
				end
			end
		end
	end
	table.sort(missing, function(a, b) return (a.MaterialClass .. a.Map) < (b.MaterialClass .. b.Map) end)
	return missing
end

-- Safe and idempotent: existing SurfaceAppearance objects are reused, no
-- existing TextureID/map ID is replaced, and repeated calls create at most one
-- managed SurfaceAppearance per MeshPart.
function AircraftMaterialConfig.Apply(model)
	local before = AircraftMaterialConfig.Inspect(model)
	local report = {
		Before = before, MeshPartCount = before.MeshPartCount,
		CreatedSurfaceAppearanceCount = 0, ReusedSurfaceAppearanceCount = 0,
		PreservedAssetIDCount = #before.TextureIDs + #before.SurfaceMaps,
	}
	for _, item in ipairs(model:GetDescendants()) do
		if not item:IsA("BasePart") then continue end
		local materialClass = classify(item)
		local definition = AircraftMaterialConfig.Definitions[materialClass]
		item:SetAttribute("PBRMaterialClass", materialClass)
		applyFallback(item, definition)
		if not item:IsA("MeshPart") then continue end
		local surface = existingSurface(item)
		if surface then
			report.ReusedSurfaceAppearanceCount += 1
		elseif hasConfiguredStandardMap(definition) then
			surface = Instance.new("SurfaceAppearance")
			surface.Name = "AircraftPBRSurface"
			surface:SetAttribute("ManagedByAircraftMaterialConfig", true)
			surface.Parent = item
			report.CreatedSurfaceAppearanceCount += 1
		end
		if surface then
			for _, propertyName in ipairs({ "ColorMap", "NormalMap", "RoughnessMap", "MetalnessMap" }) do
				local configured = definition.Maps[propertyName]
				if configured ~= "" and surface[propertyName] == "" then surface[propertyName] = configured end
			end
			local emissive = definition.Maps.EmissiveMap
			if emissive ~= "" and (surface:GetAttribute("PBREmissiveMap") or "") == "" then
				surface:SetAttribute("PBREmissiveMap", emissive)
			end
		end
	end
	report.MissingMaps = AircraftMaterialConfig.GetMissingMaps(model)
	model:SetAttribute("MaterialSystemRevision", 27)
	model:SetAttribute("PBRMeshPartCount", report.MeshPartCount)
	model:SetAttribute("PBRSurfaceCount", before.SurfaceAppearanceCount + report.CreatedSurfaceAppearanceCount)
	model:SetAttribute("PBRMapsAwaitingUpload", #report.MissingMaps > 0)
	model:SetAttribute("PBRExistingAssetIDsPreserved", true)
	return report
end

return AircraftMaterialConfig
]]></ProtectedString><bool name="Disabled">false</bool></Properties>
  
</Item>
<Item class="ModuleScript" referent="RBX8">
  <Properties><string name="Name">AircraftLiveryConfig</string><ProtectedString name="Source"><![CDATA[--!nocheck

-- V31 safe, data-driven aircraft livery application. No asset IDs are bundled:
-- a livery is applied only after the owner supplies valid IDs, a target, and a
-- verified UV layout. That prevents mirrored text and accidental whole-aircraft
-- texture assignment.

local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")

local AircraftLiveryConfig = {}

AircraftLiveryConfig.Liveries = {
	-- Add owner-uploaded liveries here. Example schema (keep IDs empty until upload):
	-- MyLivery = {
	--     TargetAircraftCode = "B763",
	--     VerifiedUniqueSideUVs = true,
	--     MeshNames = { "FuselageExterior", "LeftEngineNacelle", "RightEngineNacelle" },
	--     MaterialClasses = { PaintedFuselage = true, EngineNacelles = true, Wings = true },
	--     Maps = { ColorMap = "", NormalMap = "", RoughnessMap = "", MetalnessMap = "", EmissiveMap = "" },
	--     MeshOverrides = {},
	-- },
}

AircraftLiveryConfig.RequiredFields = {
	"TargetAircraftCode",
	"VerifiedUniqueSideUVs",
	"MeshNames",
	"Maps.ColorMap",
}

local STANDARD_MAPS = { "ColorMap", "NormalMap", "RoughnessMap", "MetalnessMap" }
local ALL_MAPS = { "ColorMap", "NormalMap", "RoughnessMap", "MetalnessMap", "EmissiveMap" }
local EXCLUDED_CONTAINERS = { Controls = true, Collision = true, Effects = true, Interior = true }

local function validAssetId(value)
	if type(value) ~= "string" or value == "" then return false end
	if string.find(value, "[", 1, true) or string.find(value, "]", 1, true) then return false end
	return string.match(value, "^rbxassetid://%d+$") ~= nil or string.match(value, "^https://www%.roblox%.com/asset/%?id=%d+$") ~= nil
end

local function descendantsPath(instance, ancestor)
	local names = {}
	local current = instance
	while current and current ~= ancestor do
		table.insert(names, 1, current.Name)
		current = current.Parent
	end
	return table.concat(names, ".")
end

local function existingSurface(mesh)
	local preferred
	local first
	local count = 0
	for _, child in ipairs(mesh:GetChildren()) do
		if child:IsA("SurfaceAppearance") then
			count += 1
			first = first or child
			if child:GetAttribute("ManagedByAircraftLiveryConfig") == true then preferred = child end
		end
	end
	return preferred or first, count
end

local function nameSet(list)
	local result = {}
	for _, value in ipairs(list or {}) do
		if type(value) == "string" and value ~= "" then result[value] = true end
	end
	return result
end

local function inExcludedContainer(item, model)
	local current = item.Parent
	while current and current ~= model do
		if EXCLUDED_CONTAINERS[current.Name] then return true end
		current = current.Parent
	end
	return false
end

local function eligibleMeshes(model, livery)
	local requestedNames = nameSet(livery.MeshNames)
	local hasRequestedNames = next(requestedNames) ~= nil
	local classes = livery.MaterialClasses or {}
	local result = {}
	for _, item in ipairs(model:GetDescendants()) do
		if not item:IsA("MeshPart") or inExcludedContainer(item, model) then continue end
		local named = hasRequestedNames and requestedNames[item.Name] == true
		local classed = classes[item:GetAttribute("PBRMaterialClass")] == true
		if named or (not hasRequestedNames and classed) then table.insert(result, item) end
	end
	return result
end

local function resolvedMaps(livery, mesh)
	local result = {}
	local override = livery.MeshOverrides and livery.MeshOverrides[mesh.Name]
	for _, mapName in ipairs(ALL_MAPS) do
		local value = override and override[mapName] or nil
		if value == nil then value = livery.Maps and livery.Maps[mapName] or "" end
		result[mapName] = value
	end
	return result
end

function AircraftLiveryConfig.Inspect(model)
	local report = {
		AircraftPath = model:GetFullName(),
		AircraftCode = model:GetAttribute("AircraftCode"),
		MeshPartCount = 0,
		SurfaceAppearanceCount = 0,
		MeshParts = {},
		ReflectanceWarnings = {},
		UVVerification = model:GetAttribute("UVSideLayout") or "UNKNOWN",
	}
	for _, item in ipairs(model:GetDescendants()) do
		if item:IsA("MeshPart") then
			report.MeshPartCount += 1
			local _, surfaceCount = existingSurface(item)
			report.SurfaceAppearanceCount += surfaceCount
			table.insert(report.MeshParts, {
				Path = descendantsPath(item, model),
				TextureID = item.TextureID,
				MaterialClass = item:GetAttribute("PBRMaterialClass"),
				SurfaceAppearanceCount = surfaceCount,
			})
			if item.Reflectance > 0.18 then
				table.insert(report.ReflectanceWarnings, {
					Path = descendantsPath(item, model),
					Reflectance = item.Reflectance,
				})
			end
		end
	end
	return report
end

function AircraftLiveryConfig.Validate(model, liveryName)
	local livery = AircraftLiveryConfig.Liveries[liveryName]
	local issues = {}
	if not livery then
		table.insert(issues, "No livery named '" .. tostring(liveryName) .. "' is configured.")
		return false, issues, {}
	end
	if type(livery.TargetAircraftCode) ~= "string" or livery.TargetAircraftCode == "" then
		table.insert(issues, "TargetAircraftCode is missing.")
	elseif model:GetAttribute("AircraftCode") ~= livery.TargetAircraftCode then
		table.insert(issues, "TargetAircraftCode does not match this model.")
	end
	if livery.VerifiedUniqueSideUVs ~= true then
		table.insert(issues, "Unique left/right UV space has not been verified; branded text could be mirrored.")
	end
	if not livery.Maps or not validAssetId(livery.Maps.ColorMap) then
		table.insert(issues, "A valid owner-uploaded ColorMap asset ID is required.")
	end
	for _, mapName in ipairs(ALL_MAPS) do
		local value = livery.Maps and livery.Maps[mapName] or ""
		if value ~= "" and not validAssetId(value) then
			table.insert(issues, mapName .. " is not a valid Roblox asset ID.")
		end
	end
	local meshes = eligibleMeshes(model, livery)
	if #meshes == 0 then
		table.insert(issues, "No intended visual MeshParts matched MeshNames or MaterialClasses.")
	end
	return #issues == 0, issues, meshes
end

local function createBackup(model, liveryName)
	if not RunService:IsServer() then return nil, "Backups can only be created by the server." end
	local backups = ServerStorage:FindFirstChild("AroundTheWorldAircraftBackups") or Instance.new("Folder")
	backups.Name = "AroundTheWorldAircraftBackups"
	backups.Parent = ServerStorage
	local backup = model:Clone()
	backup.Name = model.Name .. "_BeforeLivery_" .. liveryName .. "_" .. tostring(os.time())
	backup:SetAttribute("NonRunningBackup", true)
	backup:SetAttribute("SourceAircraftPath", model:GetFullName())
	for _, item in ipairs(backup:GetDescendants()) do
		if item:IsA("Script") or item:IsA("LocalScript") then item.Disabled = true end
		if item:IsA("ProximityPrompt") then item.Enabled = false end
	end
	backup.Parent = backups
	return backup
end

-- Idempotent application: one existing/managed SurfaceAppearance is reused for
-- each intended mesh. Validation runs before backup or mutation, and every old
-- ID is captured in the returned report and protected by the ServerStorage copy.
function AircraftLiveryConfig.Apply(model, liveryName, options)
	options = options or {}
	local valid, issues, meshes = AircraftLiveryConfig.Validate(model, liveryName)
	local report = {
		Applied = false,
		LiveryName = liveryName,
		Inspection = AircraftLiveryConfig.Inspect(model),
		Issues = issues,
		ChangedInstances = {},
		MissingOptionalMaps = {},
	}
	if not valid then return report end
	local livery = AircraftLiveryConfig.Liveries[liveryName]
	for _, mapName in ipairs({ "NormalMap", "RoughnessMap", "MetalnessMap", "EmissiveMap" }) do
		if not livery.Maps[mapName] or livery.Maps[mapName] == "" then table.insert(report.MissingOptionalMaps, mapName) end
	end
	if options.DryRun == true then
		report.DryRun = true
		report.EligibleMeshCount = #meshes
		return report
	end
	local backup, backupError = createBackup(model, liveryName)
	if not backup then
		table.insert(report.Issues, backupError)
		return report
	end
	report.BackupPath = backup:GetFullName()
	for _, mesh in ipairs(meshes) do
		local surface = existingSurface(mesh)
		local created = false
		if not surface then
			surface = Instance.new("SurfaceAppearance")
			surface.Name = "AircraftLiverySurface"
			surface:SetAttribute("ManagedByAircraftLiveryConfig", true)
			surface.Parent = mesh
			created = true
		end
		local maps = resolvedMaps(livery, mesh)
		local before = {}
		for _, mapName in ipairs(STANDARD_MAPS) do
			before[mapName] = surface[mapName]
			if maps[mapName] ~= "" then surface[mapName] = maps[mapName] end
		end
		before.EmissiveMap = surface:GetAttribute("PBREmissiveMap") or ""
		if maps.EmissiveMap ~= "" then surface:SetAttribute("PBREmissiveMap", maps.EmissiveMap) end
		mesh:SetAttribute("ActiveLivery", liveryName)
		table.insert(report.ChangedInstances, {
			Path = descendantsPath(mesh, model),
			SurfacePath = descendantsPath(surface, model),
			CreatedSurfaceAppearance = created,
			PreviousMaps = before,
			AppliedMaps = maps,
		})
	end
	model:SetAttribute("ActiveLivery", liveryName)
	model:SetAttribute("LiverySystemRevision", 31)
	model:SetAttribute("LiveryUVVerified", true)
	report.Applied = true
	return report
end

return AircraftLiveryConfig
]]></ProtectedString><bool name="Disabled">false</bool></Properties>
  
</Item>
<Item class="ModuleScript" referent="RBX9">
  <Properties><string name="Name">AircraftHandlingConfig</string><ProtectedString name="Source"><![CDATA[--!strict

-- V25 handling profiles. These preserve the approachable control scheme while
-- giving each weight class different inertia, bank authority, flap drag,
-- acceleration, rotation, braking, and landing-gear damping.

local AircraftHandlingConfig = {}

local profiles = {
	Regional = { BankMax = 30, PitchResponse = 1.08, RollResponse = 1.08, Acceleration = 1.10, RotationRate = 1.06, FlapDrag = 3.2, BrakeEffectiveness = 1.04, LandingDamping = 1.04 },
	["Narrow-body"] = { BankMax = 28, PitchResponse = 1.00, RollResponse = 0.98, Acceleration = 1.00, RotationRate = 1.00, FlapDrag = 3.6, BrakeEffectiveness = 1.00, LandingDamping = 1.00 },
	["Mid-size"] = { BankMax = 27, PitchResponse = 0.94, RollResponse = 0.91, Acceleration = 0.94, RotationRate = 0.94, FlapDrag = 4.0, BrakeEffectiveness = 0.97, LandingDamping = 0.97 },
	["Wide-body"] = { BankMax = 25, PitchResponse = 0.86, RollResponse = 0.82, Acceleration = 0.86, RotationRate = 0.86, FlapDrag = 4.5, BrakeEffectiveness = 0.92, LandingDamping = 0.92 },
	["Long-haul"] = { BankMax = 23, PitchResponse = 0.78, RollResponse = 0.74, Acceleration = 0.78, RotationRate = 0.78, FlapDrag = 5.0, BrakeEffectiveness = 0.88, LandingDamping = 0.88 },
	Jumbo = { BankMax = 22, PitchResponse = 0.73, RollResponse = 0.70, Acceleration = 0.72, RotationRate = 0.74, FlapDrag = 5.4, BrakeEffectiveness = 0.85, LandingDamping = 0.86 },
	Superjumbo = { BankMax = 20, PitchResponse = 0.66, RollResponse = 0.62, Acceleration = 0.66, RotationRate = 0.68, FlapDrag = 5.8, BrakeEffectiveness = 0.82, LandingDamping = 0.82 },
}

function AircraftHandlingConfig.Get(spec)
	local source = profiles[spec.Class] or profiles["Narrow-body"]
	local result = table.clone(source)
	result.Profile = spec.Class or "Narrow-body"
	return result
end

return AircraftHandlingConfig
]]></ProtectedString><bool name="Disabled">false</bool></Properties>
  
</Item>
<Item class="ModuleScript" referent="RBX10">
  <Properties><string name="Name">AircraftEffectsConfig</string><ProtectedString name="Source"><![CDATA[--!strict

-- V29 presentation-only effects tuning. Aircraft positions and electrical/
-- engine state remain authoritative elsewhere; this module only controls how
-- existing Attachments, Lights, emitters, and fan-blur discs are presented.

local AircraftEffectsConfig = {}

local base = {
	Profile = "Narrow-body",
	EngineCount = 2,
	Distances = {
		Lights = 2800,
		FanBlur = 760,
		Exhaust = 820,
		Vortex = 1150,
		Contrail = 1950,
		TireSmoke = 1050,
		Spray = 850,
		Rain = 450,
	},
	MinimumQuality = {
		Lights = 1,
		FanBlur = 3,
		Exhaust = 4,
		Vortex = 6,
		Contrail = 5,
		TireSmoke = 4,
		Spray = 5,
		Rain = 5,
	},
	Thresholds = {
		LandingLightAltitude = 620,
		TurnoffLightAltitude = 120,
		TaxiLightMaxSpeed = 95,
		VortexHumidity = 0.62,
		VortexMinSpeed = 112,
		VortexMaxAltitude = 360,
		VortexMinFlaps = 1,
		ContrailMinAltitude = 720,
		ContrailMinSpeed = 245,
		ContrailMinPower = 64,
		ExhaustMinPower = 14,
		TireSmokeMinLoad = 0.12,
		TireSmokeMinSpeed = 92,
		TireSmokeCooldown = 1.4,
		SprayMinWetness = 0.30,
		SprayMinSpeed = 28,
	},
	Rates = {
		ExhaustBase = 2,
		ExhaustPowerScale = 0.085,
		Vortex = 10,
		Contrail = 14,
		SprayMaximum = 38,
		RainBase = 55,
		RainScale = 260,
		TireSmokeMaximumBurst = 15,
	},
	FlashPatterns = {
		Beacon = { Period = 1.12, Windows = { { 0.00, 0.11 }, { 0.20, 0.27 } } },
		Strobe = { Period = 1.24, Windows = { { 0.00, 0.055 }, { 0.15, 0.205 } } },
	},
	LightOffsets = {
		LEFT_NAVIGATION = Vector3.zero,
		RIGHT_NAVIGATION = Vector3.zero,
		TAIL_NAVIGATION = Vector3.zero,
		LEFT_STROBE = Vector3.zero,
		RIGHT_STROBE = Vector3.zero,
		UPPER_BEACON = Vector3.zero,
		LOWER_BEACON = Vector3.zero,
		LANDING = Vector3.zero,
		TAXI = Vector3.zero,
	},
}

local profiles = {
	Regional = {
		Distances = { FanBlur = 650, Exhaust = 700, Vortex = 980, Contrail = 1700 },
		Thresholds = { VortexMinSpeed = 100, ContrailMinAltitude = 680, TireSmokeMinSpeed = 82 },
		Rates = { ExhaustPowerScale = 0.072, TireSmokeMaximumBurst = 11 },
		LightOffsets = { TAIL_NAVIGATION = Vector3.new(0, 0.02, -0.04), TAXI = Vector3.new(0, -0.03, 0) },
	},
	["Narrow-body"] = {},
	["Mid-size"] = {
		Distances = { FanBlur = 820, Exhaust = 880, Vortex = 1200 },
		Thresholds = { ContrailMinAltitude = 760, TireSmokeMinLoad = 0.13 },
		LightOffsets = { LEFT_STROBE = Vector3.new(0.04, 0, 0), RIGHT_STROBE = Vector3.new(-0.04, 0, 0) },
	},
	["Wide-body"] = {
		Distances = { Lights = 3100, FanBlur = 920, Exhaust = 1000, Vortex = 1350, Contrail = 2200 },
		Thresholds = { ContrailMinAltitude = 790, TireSmokeMinLoad = 0.14, TireSmokeMinSpeed = 100 },
		Rates = { ExhaustPowerScale = 0.095, TireSmokeMaximumBurst = 16 },
		LightOffsets = { LEFT_NAVIGATION = Vector3.new(-0.06, 0, 0), RIGHT_NAVIGATION = Vector3.new(0.06, 0, 0) },
	},
	["Long-haul"] = {
		Distances = { Lights = 3300, FanBlur = 980, Exhaust = 1080, Vortex = 1450, Contrail = 2350 },
		Thresholds = { ContrailMinAltitude = 820, ContrailMinPower = 67, TireSmokeMinLoad = 0.15, TireSmokeMinSpeed = 104 },
		Rates = { ExhaustPowerScale = 0.10, TireSmokeMaximumBurst = 17 },
		LightOffsets = { LEFT_NAVIGATION = Vector3.new(-0.08, 0, 0), RIGHT_NAVIGATION = Vector3.new(0.08, 0, 0) },
	},
	Jumbo = {
		Distances = { Lights = 3500, FanBlur = 1050, Exhaust = 1150, Vortex = 1500, Contrail = 2500 },
		Thresholds = { ContrailMinAltitude = 850, TireSmokeMinLoad = 0.16, TireSmokeMinSpeed = 108 },
		Rates = { ExhaustPowerScale = 0.105, TireSmokeMaximumBurst = 18 },
		LightOffsets = { TAIL_NAVIGATION = Vector3.new(0, 0.08, 0.02) },
	},
	Superjumbo = {
		Distances = { Lights = 3700, FanBlur = 1120, Exhaust = 1220, Vortex = 1600, Contrail = 2650 },
		Thresholds = { ContrailMinAltitude = 880, TireSmokeMinLoad = 0.17, TireSmokeMinSpeed = 112 },
		Rates = { ExhaustPowerScale = 0.11, TireSmokeMaximumBurst = 20 },
		LightOffsets = { TAIL_NAVIGATION = Vector3.new(0, 0.10, 0.03), TAXI = Vector3.new(0, -0.06, -0.03) },
	},
}

local aircraft = {
	A223 = { Profile = "Regional", EngineCount = 2 }, E290 = { Profile = "Regional", EngineCount = 2 },
	E295 = { Profile = "Regional", EngineCount = 2 }, CRJ9 = { Profile = "Regional", EngineCount = 2 },
	A19N = { Profile = "Narrow-body", EngineCount = 2 }, A20N = { Profile = "Narrow-body", EngineCount = 2 },
	A21N = { Profile = "Narrow-body", EngineCount = 2 }, B38M = { Profile = "Narrow-body", EngineCount = 2 },
	B39M = { Profile = "Narrow-body", EngineCount = 2 }, B752 = { Profile = "Mid-size", EngineCount = 2 },
	A339 = { Profile = "Wide-body", EngineCount = 2 }, B763 = { Profile = "Wide-body", EngineCount = 2 },
	A359 = { Profile = "Long-haul", EngineCount = 2 }, A35K = { Profile = "Long-haul", EngineCount = 2 },
	B77W = { Profile = "Long-haul", EngineCount = 2 }, B779 = { Profile = "Long-haul", EngineCount = 2 },
	B788 = { Profile = "Long-haul", EngineCount = 2 }, B789 = { Profile = "Long-haul", EngineCount = 2 },
	B748 = { Profile = "Jumbo", EngineCount = 4 }, A388 = { Profile = "Superjumbo", EngineCount = 4 },
}

local function deepCopy(source: { [any]: any }): { [any]: any }
	local result = {}
	for key, value in pairs(source) do result[key] = if type(value) == "table" then deepCopy(value) else value end
	return result
end

local function merge(target: { [any]: any }, source: { [any]: any })
	for key, value in pairs(source) do
		if type(value) == "table" and type(target[key]) == "table" then merge(target[key], value) else target[key] = value end
	end
end

function AircraftEffectsConfig.Get(aircraftCode: string?)
	local result = deepCopy(base)
	local aircraftConfig = aircraft[aircraftCode or ""] or { Profile = "Narrow-body", EngineCount = 2 }
	local profile = profiles[aircraftConfig.Profile]
	if profile then merge(result, profile) end
	merge(result, aircraftConfig)
	result.AircraftCode = aircraftCode or "UNKNOWN"
	result.Revision = 29
	return result
end

return AircraftEffectsConfig
]]></ProtectedString><bool name="Disabled">false</bool></Properties>
  
